---
interface Props {
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  variant?: 'primary' | 'secondary' | 'tertiary';
  compact?: boolean;
  full?: boolean;
  class?: string;
}

const {
  href,
  type = 'button',
  variant = 'primary',
  compact = false,
  full = false,
  class: className = '',
} = Astro.props;
const classes = ['button', `button--${variant}`, compact && 'button--compact', full && 'button--full', className];
---
{href ? (
  <a class:list={classes} href={href}><slot /></a>
) : (
  <button class:list={classes} type={type}><slot /></button>
)}
