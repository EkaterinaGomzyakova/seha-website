---
interface Props extends Omit<astroHTML.JSX.ButtonHTMLAttributes, 'type'> {
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  variant?: 'primary' | 'secondary' | 'tertiary';
  compact?: boolean;
  full?: boolean;
  class?: string;
}

const {
  href,
  type = 'button',
  variant = 'primary',
  compact = false,
  full = false,
  class: className = '',
  ...attributes
} = Astro.props;
const classes = [
  'button',
  `button--${variant}`,
  compact && 'button--compact',
  full && 'button--full',
  className
];
---

{href ? (
  <a class:list={classes} href={href} {...attributes}>
    <slot />
  </a>
) : (
  <button class:list={classes} type={type} {...attributes}>
    <slot />
  </button>
)}
