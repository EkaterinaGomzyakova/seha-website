---
import LanguageSwitcher from './LanguageSwitcher.astro';
import Logo from './Logo.astro';
import Button from './ui/Button.astro';
import { getSiteTranslations, type Locale } from '../data/translations';
import { getInterfaceCopy } from '../data/interface-copy';
import { siteContact } from '../data/site';
import { localizedPath, unlocalizedPath, withBase } from '../lib/paths';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = getSiteTranslations(locale);
const ui = getInterfaceCopy(locale);
const links = [
  { path: '/products/', text: copy.products },
  { path: '/production/', text: copy.production },
  { path: '/quality/', text: copy.quality },
  { path: '/about/', text: copy.about }
];
const languageTarget = localizedPath(
  unlocalizedPath(Astro.url.pathname),
  locale === 'en' ? 'ru' : 'en'
);
---

<header class="header site-header">
  <Logo locale={locale} />
  <nav class="site-nav" aria-label={ui.mainNavigation}>
    {links.map((link) => (
      <a
        href={localizedPath(link.path, locale)}
        aria-current={unlocalizedPath(Astro.url.pathname) === link.path ? 'page' : undefined}
      >
        {link.text}
      </a>
    ))}
  </nav>
  <Button variant="primary" compact href={localizedPath('/#contacts', locale)}>
    {copy.offer} <span aria-hidden="true">↗</span>
  </Button>
  <LanguageSwitcher locale={locale} target={languageTarget} label={copy.language} />
  <button
    id="menu-toggle"
    class="menu-toggle"
    type="button"
    aria-label={copy.menu}
    aria-expanded="false"
    aria-controls="mobile-nav"
    data-open-label={copy.menu}
    data-close-label={ui.closeMenu}
  >
    <img
      class="menu-icon"
      data-menu-icon
      src={withBase('/assets/images/common/menu-icon-figma.svg')}
      data-open-src={withBase('/assets/images/common/mobile-menu-xmark.svg')}
      data-closed-src={withBase('/assets/images/common/menu-icon-figma.svg')}
      alt=""
      aria-hidden="true"
    />
  </button>
  <seha-mobile-menu trigger="menu-toggle">
    <div
      id="mobile-nav"
      class="mobile-nav"
      role="dialog"
      aria-modal="true"
      aria-label={ui.mobileNavigation}
      hidden
    >
      <button class="mobile-nav-close" type="button" aria-label={ui.closeMenu}>
        <img src={withBase('/assets/images/common/mobile-menu-xmark.svg')} alt="" />
      </button>
      <nav class="mobile-nav-links" aria-label={ui.mainNavigation}>
        {links.map((link) => (
          <a href={localizedPath(link.path, locale)}>{link.text}</a>
        ))}
      </nav>
      <div class="mobile-nav-contacts">
        <div class="mobile-nav-contact">
          <span>{ui.phoneLabel}</span>
          <a href={siteContact.phoneHref}>{siteContact.phone}</a>
        </div>
        <div class="mobile-nav-contact">
          <span>{ui.emailLabel}</span>
          <a href={`mailto:${siteContact.email}`}>{siteContact.email}</a>
        </div>
      </div>
    </div>
  </seha-mobile-menu>
  <noscript>
    <nav aria-label={ui.mainNavigation}>
      {links.map((link) => (
        <a href={localizedPath(link.path, locale)}>{link.text} </a>
      ))}
    </nav>
  </noscript>
</header>
