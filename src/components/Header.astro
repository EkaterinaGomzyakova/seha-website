---
import GlobalStyles from './GlobalStyles.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Button from './ui/Button.astro';
import { getSiteTranslations, type Locale } from '../data/translations';

const { locale = 'ru' as Locale } = Astro.props;
const isEnglish = locale === 'en';
const localizePath = (path) => `/${locale}${path === '/' ? '/' : path}`;
const routePath = (Astro.url.pathname.replace(/^\/(?:ru|en)(?=\/|$)/, '').replace(/\/$/, '') || '/');
const languageTarget = `/${isEnglish ? 'ru' : 'en'}${routePath === '/' ? '/' : `${routePath}/`}`;
const copy = getSiteTranslations(locale);
---
<GlobalStyles />
<header class="header site-header">
      <a class="logo" href={localizePath('/')} aria-label={`${copy.logoAlt} — ${copy.home}`}
        ><img class="logo-image" src="/assets/images/common/russian_logo.svg" alt="Сеха"
      /></a>
      <nav class="site-nav" aria-label="Основная навигация">
        <a href={localizePath('/products')}>{copy.products}</a><a href={localizePath('/production')}>{copy.production}</a
        ><a href={localizePath('/quality')}>{copy.quality}</a><a href={localizePath('/about')}>{copy.about}</a>
      </nav>
      <Button variant="primary" compact href={`${localizePath('/')}#contacts`}>{copy.offer} <span aria-hidden="true">↗</span></Button
      ><LanguageSwitcher locale={locale} target={languageTarget} label={copy.language}
      />
      <button
        class="menu-toggle"
        aria-label={copy.menu}
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <img
          class="menu-icon"
          data-menu-icon
          src="/assets/images/common/menu-icon.svg"
          alt=""
          aria-hidden="true"
        />
      </button>
      <nav id="mobile-nav" class="mobile-nav" aria-label={isEnglish ? 'Mobile navigation' : 'Мобильная навигация'} hidden>
        <a href={localizePath('/')}>{copy.home}</a><a href={localizePath('/products')}>{copy.products}</a><a href={localizePath('/production')}>{copy.production}</a
        ><a href={localizePath('/quality')}>{copy.quality}</a><a href={localizePath('/about')}>{copy.about}</a
        ><a href={`${localizePath('/')}#contacts`}>{copy.offer}</a>
      </nav>
    </header>
