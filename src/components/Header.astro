---
---
<header class="header site-header">
      <a class="logo" href="/" aria-label="Сеха — главная"
        ><img class="logo-image" src="/assets/images/common/russian_logo.svg" alt="Сеха"
      /></a>
      <nav class="site-nav" aria-label="Основная навигация">
        <a href="/products">Продукты</a><a href="/production">Производство</a
        ><a href="/quality">Качество</a><a href="/about">О компании</a>
      </nav>
      <a class="button button--primary button--compact" href="#contacts"
        >Получить предложение <span aria-hidden="true">↗</span></a
      ><button
        class="language-switch type-button"
        type="button"
        data-language-toggle
        aria-label="Переключить язык"
      >
        <img
          class="language-flag"
          data-language-flag
          src="/assets/images/common/figma-language-ru.svg"
          alt=""
        /><span data-language-code>RU</span
        ><img
          class="language-arrow"
          data-language-arrow
          src="/assets/images/common/language-arrow-down.svg"
          alt=""
        /></button
      ><button
        class="menu-toggle"
        aria-label="Открыть меню"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <img
          class="menu-icon"
          data-menu-icon
          src="/assets/images/common/menu-icon.svg"
          alt=""
          aria-hidden="true"
        />
      </button>
      <nav id="mobile-nav" class="mobile-nav" aria-label="Мобильная навигация" hidden>
        <a href="/">Главная</a><a href="/products">Продукты</a><a href="/production">Производство</a
        ><a href="/quality">Качество</a><a href="/about">О компании</a
        ><a href="#contacts">Получить предложение</a>
      </nav>
    </header>
