---
import type { Locale } from '../data/translations';
import type { ProductItem } from '../data/products';
import { productPackaging, packagingFormats } from '../data/product-packaging';
interface Props {
  product: ProductItem;
  locale: Locale;
  formId?: string;
}
const { product, locale, formId } = Astro.props;
const packaging = productPackaging[product.id];
const weightOnly = packaging?.kind === 'weight';
const variantOnly = packaging?.kind === 'variant';
const simpleSelector = weightOnly || variantOnly;
const formats = simpleSelector ? (['industrial'] as const) : (['consumer', 'industrial'] as const);
const initialFormat = packaging?.options.find(
  (option) => option.id === packaging.defaultId
)?.format;
const ru = locale === 'ru';
const context = formId || 'product-page';
const selectionLabel =
  packaging?.selectionLabel?.[locale] ||
  (weightOnly
    ? ru
      ? 'Масса упаковки'
      : 'Pack weight'
    : ru
      ? 'Объём или вес упаковки'
      : 'Pack size');
---

{packaging && (
  <div class="product-packaging" data-packaging-selector>
    {!simpleSelector && (
      <fieldset class="product-packaging__formats">
        <legend class="type-p">{ru ? 'Упаковка' : 'Packaging'}</legend>
        <div class="product-packaging__format-options">
          {(['consumer', 'industrial'] as const).map((format) => (
            <label class="product-packaging__option">
              <input
                type="radio"
                name={formId ? 'supplyFormat' : `supply-format-${product.id}`}
                form={formId}
                value={format}
                checked={format === initialFormat}
                data-supply-format
                aria-describedby={`${context}-${product.id}-${format}-description`}
              />
              <span class="type-p">{packagingFormats[format].label[locale]}</span>
            </label>
          ))}
        </div>
      </fieldset>
    )}
    {formats.map((format) => {
      const options = packaging.options.filter((option) => option.format === format);
      const customOnly = options.length === 1 && options[0].id === 'industrial-custom';
      return (
        <div data-packaging-panel={format} hidden={format !== initialFormat}>
          {!simpleSelector && (
            <p
              class="product-packaging__description type-p"
              id={`${context}-${product.id}-${format}-description`}
            >
              {packagingFormats[format].description[locale]}
            </p>
          )}
          <fieldset>
            {!customOnly && <legend class="type-p">{selectionLabel}</legend>}
            <div class="product-packaging__options">
              {options.map((option) => (
                <label class="product-packaging__option" hidden={customOnly}>
                  <input
                    type="radio"
                    name={formId ? 'packagingId' : `packaging-${product.id}`}
                    form={formId}
                    value={option.id}
                    checked={option.id === packaging.defaultId}
                    disabled={format !== initialFormat}
                    data-product-packaging
                    data-supply-format-value={format}
                    data-packaging-label={`${variantOnly ? selectionLabel : weightOnly ? (ru ? 'Масса' : 'Weight') : packagingFormats[format].label[locale]} — ${option.label[locale]}`}
                    data-packaging-product-id={product.id}
                    data-packaging-product-name={product.name[locale]}
                  />
                  <span class="type-p">{option.label[locale]}</span>
                </label>
              ))}
            </div>
            {customOnly && !formId && (
              <label class="product-packaging__custom type-p">
                <span>{ru ? 'Объём или вес упаковки, если знаете' : 'Pack size, if known'}</span>
                <input
                  type="text"
                  maxlength="80"
                  data-inline-custom-packaging
                  data-packaging-product-id={product.id}
                />
              </label>
            )}
          </fieldset>
        </div>
      );
    })}
    {!formId && (
      <p class="product-packaging__note type-p">
        {ru ? 'Показан общий остаток товара.' : 'Stock shown is the total for this product.'}
      </p>
    )}
  </div>
)}
<script>
  import { initProductPackaging } from '../scripts/product-packaging';
  initProductPackaging();
</script>
<style>
  .product-packaging {
    min-width: 0;
  }
  fieldset {
    margin: 0;
    padding: 0;
    min-width: 0;
    border: 0;
  }
  legend {
    margin-bottom: 12px;
    padding: 0;
    font-weight: 700;
  }
  .product-packaging__format-options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  .product-packaging__options {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .product-packaging__option {
    position: relative;
    cursor: pointer;
    max-width: 100%;
  }
  input[type='radio'] {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .product-packaging__option > span {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 12px 16px;
    border: 1px solid var(--color-dark-gray);
    border-radius: 12px;
    color: var(--color-green-brand);
    background: var(--color-white);
  }
  input:checked + span {
    color: var(--color-background-light);
    background: var(--color-green-brand);
    border-color: var(--color-green-brand);
  }
  input:focus-visible + span {
    outline: var(--focus-outline);
    outline-offset: 3px;
  }
  .product-packaging__description {
    margin: 16px 0;
    color: var(--color-dark-gray);
  }
  .product-packaging__note {
    margin: 12px 0 0;
    color: var(--color-dark-gray);
  }
  .product-packaging__custom {
    display: grid;
    gap: 8px;
  }
  .product-packaging__custom input {
    width: 100%;
    min-width: 0;
    padding: 12px;
    border: 1px solid var(--color-dark-gray);
    border-radius: 8px;
    color: var(--color-green-brand);
    background: var(--color-white);
    font: inherit;
  }
</style>
