---
import SiteLayout from '../layouts/SiteLayout.astro';
import Button from './ui/Button.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import type { Locale } from '../data/translations';
import { errorCopy } from '../data/error-copy';
import { localizedPath } from '../lib/paths';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = errorCopy[locale];
---

<SiteLayout
  locale={locale}
  path="/404"
  title={copy.title}
  description={copy.description}
  bodyClass="not-found"
  skipText={copy.skip}
  skipHref="#error-content"
  showFooter={false}
>
  <main class="error-page" id="error-content">
    <div class="error-image" aria-hidden="true">
      <ResponsiveImage
        src="/assets/images/not-found/coconut.png"
        alt=""
        sizes="(max-width: 440px) 360px, (max-width: 800px) 554px, (max-width: 1280px) 608px, 920px"
        loading="eager"
      />
    </div>
    <section class="error-copy" aria-labelledby="error-title">
      <div class="error-heading">
        <p class="error-mark" aria-hidden="true">
          404
        </p>
        <div class="error-text">
          <h1 id="error-title" class:list={['type-h1', { 'error-title--en': locale === 'en' }]}>
            <span>{copy.headingStart}</span> <span class="error-title-last">{copy.headingEnd}</span>
          </h1>
          <p class="type-p">{copy.description}</p>
        </div>
      </div>
      <Button variant="primary" class="error-home" href={localizedPath('/', locale)}>
        {copy.home}
      </Button>
    </section>
  </main>
</SiteLayout>
