---
import type { Locale } from '../data/translations';
import type { ProductItem } from '../data/products';
import { productPackaging } from '../data/product-packaging';
import { productInquiryCopy } from '../data/product-inquiry';
import { getInterfaceCopy } from '../data/interface-copy';
import { siteContact } from '../data/site';
import { localizedPath } from '../lib/paths';
import ProductPackaging from './ProductPackaging.astro';
import Input from './ui/Input.astro';
import Checkbox from './ui/Checkbox.astro';
import Button from './ui/Button.astro';
import TablerIcon from './ui/TablerIcon.astro';
import ResponsiveImage from './ResponsiveImage.astro';
interface Props {
  locale: Locale;
  products: ProductItem[];
}
const { locale, products } = Astro.props;
const ru = locale === 'ru';
const copy = getInterfaceCopy(locale);
const inquiryCopy = productInquiryCopy[locale];
---

<dialog
  id="product-inquiry"
  class="product-inquiry"
  aria-labelledby="product-inquiry-title"
  data-locale={locale}
>
  <div class="product-inquiry__panel">
    <div class="product-inquiry__heading">
      <h2 id="product-inquiry-title" class="type-h2">
        {inquiryCopy.title}
      </h2>
      <button
        class="product-inquiry__close"
        type="button"
        data-close-inquiry
        aria-label={copy.close}
      >
        <TablerIcon name="x" size={32} />
      </button>
    </div>
    <p class="type-p" id="product-inquiry-next-step">
      {inquiryCopy.nextStep}
    </p>
    <form
      id="product-inquiry-form"
      data-endpoint={import.meta.env.PUBLIC_PRODUCT_INQUIRY_ENDPOINT || undefined}
    >
      <input type="hidden" name="locale" value={locale} />
      <input type="hidden" name="productId" />
      <input type="hidden" name="packaging" />
      <input type="hidden" name="quantity" />
      <input type="hidden" name="quantityUnit" />
      <input type="hidden" name="product" />
      <section
        class="product-inquiry__selection"
        aria-label={ru ? 'Выбранный товар' : 'Selected product'}
      >
        <div data-inquiry-product-preview></div>
        <p class="type-p" data-inquiry-quantity-summary hidden></p>
        <div data-inquiry-packaging></div>
        <div data-inquiry-custom hidden>
          <Input
            label={ru ? 'Объём или вес упаковки, если знаете' : 'Pack size, if known'}
            name="customPackaging"
            placeholder={ru ? 'Укажите массу или объём' : 'Enter a weight or volume'}
            maxlength="80"
            disabled
          />
        </div>
      </section>
      <fieldset class="product-inquiry__contacts">
        <legend class="type-h3">{ru ? 'Контакты' : 'Contact details'}</legend>
        <div class="product-inquiry__fields">
          <Input
            label={ru ? 'Компания' : 'Company'}
            name="company"
            placeholder={ru ? 'Название компании' : 'Company name'}
            autocomplete="organization"
            required
            maxlength="160"
          />
          <Input
            label={ru ? 'Ваше имя' : 'Your name'}
            name="contact"
            placeholder={ru ? 'Как к вам обращаться' : 'Your name'}
            autocomplete="name"
            required
            maxlength="120"
          />
          <Input
            label="Email"
            name="email"
            placeholder="name@company.com"
            type="email"
            autocomplete="email"
            required
            maxlength="254"
          />
          <Input
            label={ru ? 'Телефон (необязательно)' : 'Phone (optional)'}
            name="phone"
            placeholder={ru ? '+7 999 123-45-67' : '+44 7700 900123'}
            type="tel"
            autocomplete="tel"
            maxlength="40"
          />
        </div>
      </fieldset>
      <label class="form-field">
        {copy.message}
        <textarea
          name="comment"
          rows="3"
          maxlength="1500"
          placeholder={
            ru
              ? 'Город доставки, срок и другие пожелания'
              : 'Delivery location, timing and other requirements'
          }
        ></textarea>
      </label>
      <div class="product-inquiry__trap" aria-hidden="true">
        <label>
          Website <input name="website" tabindex="-1" autocomplete="off" />
        </label>
      </div>
      <div class="product-inquiry__actions">
        <Checkbox name="consent" required insetCheck>
          <span class="consent__text">
            {copy.consentStart} <a href={localizedPath('/privacy/', locale)}>{copy.consentLink}</a>{' '}
            {copy.consentEnd}
          </span>
        </Checkbox>
        <Button full type="submit" aria-describedby="product-inquiry-next-step">
          {inquiryCopy.submit}
        </Button>
        <p class="type-p" role="status" data-inquiry-result hidden></p>
      </div>
    </form>
    <p class="product-inquiry__email type-p">
      <a href={`mailto:${siteContact.email}`}>{siteContact.email}</a>
    </p>
  </div>
</dialog>
{products.map((product) => (
  <template data-inquiry-product-template={product.id}>
    <div class="product-inquiry__product">
      <ResponsiveImage src={product.image} alt="" sizes="72px" loading="eager" />
      <p class="type-h3">{product.name[locale]}</p>
    </div>
  </template>
))}
{products
  .filter((product) => productPackaging[product.id])
  .map((product) => (
    <template data-inquiry-options={product.id}>
      <ProductPackaging product={product} locale={locale} formId="product-inquiry-form" />
    </template>
  ))}
<noscript>
  <p>
    {ru
      ? 'Для заявки из карточки включите JavaScript или напишите нам: '
      : 'Enable JavaScript to enquire about a product, or email us: '}
    <a href={`mailto:${siteContact.email}`}>{siteContact.email}</a>
  </p>
</noscript>
<script>
  import { initProductInquiry } from '../scripts/product-inquiry';
  initProductInquiry();
</script>
<style>
  .product-inquiry {
    width: min(680px, calc(100% - 32px));
    max-height: calc(100dvh - 32px);
    padding: 0;
    border: 0;
    border-radius: var(--radius-panel);
    color: var(--color-green-brand);
    background: var(--color-background-light);
    overflow: auto;
    scroll-padding-block: 80px 20px;
  }
  .product-inquiry::backdrop {
    background: rgba(0, 35, 17, 0.65);
  }
  .product-inquiry__panel {
    position: relative;
    display: grid;
    gap: 24px;
    padding: 32px;
  }
  .product-inquiry__heading {
    position: sticky;
    top: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    background: var(--color-background-light);
  }
  h2,
  #product-inquiry-next-step,
  [data-inquiry-quantity-summary] {
    margin: 0;
  }
  form {
    display: grid;
    gap: 24px;
  }
  .product-inquiry__selection {
    display: grid;
    gap: 16px;
    padding: 20px;
    border: 1px solid var(--color-light-gray);
    border-radius: var(--radius-card);
    background: var(--color-white);
    min-width: 0;
  }
  [data-inquiry-packaging]:empty {
    display: none;
  }
  [data-inquiry-packaging]:not(:empty) {
    padding-top: 16px;
    border-top: 1px solid var(--color-light-gray);
  }
  .product-inquiry__contacts {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .product-inquiry__contacts > legend {
    margin: 0 0 16px;
    padding: 0;
  }
  .product-inquiry__actions {
    display: grid;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid var(--color-light-gray);
  }
  .product-inquiry__fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .product-inquiry__close {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 12px;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .product-inquiry :global(.form-field) {
    display: grid;
    gap: 8px;
    color: inherit;
  }
  .product-inquiry :global(input:not([type='radio']):not([type='checkbox']):not([type='hidden'])),
  textarea {
    width: 100%;
    min-height: 48px;
    min-width: 0;
    padding: 12px;
    border: 1px solid var(--color-dark-gray);
    border-radius: var(--radius-field);
    background: var(--color-white);
    color: var(--color-green-brand);
    font: 500 var(--type-p-size)/var(--type-p-line-height) var(--font-sans);
    letter-spacing: normal;
    text-transform: none;
  }
  textarea {
    resize: vertical;
    min-height: 104px;
  }
  .product-inquiry :global(input::placeholder),
  textarea::placeholder {
    color: var(--color-dark-gray);
    opacity: 1;
  }
  .product-inquiry :global(input:not([type='radio']):not([type='checkbox']):focus-visible),
  textarea:focus-visible {
    outline: 2px solid var(--color-green-brand);
    outline-offset: 2px;
  }
  .product-inquiry__product {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    align-items: center;
    gap: 16px;
  }
  .product-inquiry__product :global(img) {
    display: block;
    width: 72px;
    height: 72px;
    object-fit: cover;
    border-radius: 12px;
  }
  .product-inquiry__product p {
    margin: 0;
    overflow-wrap: break-word;
  }
  .product-inquiry :global(.consent) {
    color: inherit;
    margin: 0;
    font: 500 var(--type-p-size)/var(--type-p-line-height) var(--font-sans);
  }
  .product-inquiry :global(.consent__checkbox) {
    border: 1px solid var(--color-green-brand);
    border-radius: 4px;
    background: var(--color-white);
  }
  .product-inquiry :global(.consent a) {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .product-inquiry :global(.consent__input:checked + .consent__checkbox) {
    background: var(--color-green-brand);
    color: var(--color-white);
  }
  .product-inquiry__trap {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .product-inquiry__email {
    margin: 0;
    text-align: center;
  }
  [data-inquiry-result] {
    margin: 0;
  }
  @media (max-width: 440px) {
    .product-inquiry__panel {
      padding: 24px 20px;
    }
    .product-inquiry__fields {
      grid-template-columns: 1fr;
    }
    .product-inquiry__selection {
      padding: 16px;
    }
    .product-inquiry__product {
      grid-template-columns: 64px minmax(0, 1fr);
      gap: 12px;
    }
    .product-inquiry__product :global(img) {
      width: 64px;
      height: 64px;
    }
  }
</style>
