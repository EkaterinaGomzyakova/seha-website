---
import type { Locale } from '../data/translations';
import {
  applications,
  productApplications,
  productApplicationDescriptions
} from '../data/product-applications';
import ApplicationIcon from './ApplicationIcon.astro';
import ResponsiveImage from './ResponsiveImage.astro';
interface Props {
  productId: string;
  locale: Locale;
}
const { productId, locale } = Astro.props;
const items = productApplications[productId] || [];
---

{items.length > 0 && (
  <section class="product-applications" aria-labelledby="product-applications-title">
    <h2 class="type-h2" id="product-applications-title">
      {locale === 'ru' ? 'Где используется' : 'Where it is used'}
    </h2>
    <ul style={`--application-columns: ${items.length === 4 ? 2 : Math.min(items.length, 3)}`}>
      {items.map((key) => {
        const item = applications[key];
        const description = productApplicationDescriptions[productId]?.[key] ?? item.description;
        return (
          <li class:list={{ 'product-application--crop': Boolean(item.image) }}>
            {item.image ? (
              <ResponsiveImage
                src={item.image}
                alt=""
                sizes="(max-width: 440px) 96px, 160px"
                loading="lazy"
                class="product-application__image"
              />
            ) : (
              <ApplicationIcon name={item.icon} />
            )}
            <div class="product-application__copy">
              <h3 class="type-h3">{item.label[locale]}</h3>
              {description && <p class="type-p">{description[locale]}</p>}
            </div>
          </li>
        );
      })}
    </ul>
  </section>
)}
<style>
  h2 {
    margin: 0 0 24px;
  }
  ul {
    display: grid;
    grid-template-columns: repeat(var(--application-columns), minmax(0, 1fr));
    gap: 20px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    min-width: 0;
    padding: 24px;
    border: 1px solid var(--color-light-gray);
    border-radius: 20px;
    background: var(--color-white);
    color: var(--color-green-brand);
  }
  h3 {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .product-application__copy {
    min-width: 0;
  }
  .product-application__copy p {
    margin: 10px 0 0;
    color: var(--color-dark-gray);
  }
  .product-application--crop {
    flex-direction: row;
    align-items: center;
    gap: 24px;
  }
  .product-application--crop :global(picture) {
    flex: 0 0 160px;
    width: 160px;
    max-width: 100%;
  }
  :global(.product-application__image) {
    width: 100%;
    height: 160px;
    object-fit: contain;
  }
  @media (min-width: 801px) and (max-width: 1024px) {
    .product-application--crop {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }
  @media (max-width: 800px) {
    ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
    li {
      padding: 20px;
    }
    .product-application--crop {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }
  @media (max-width: 440px) {
    ul {
      grid-template-columns: minmax(0, 1fr);
    }
    li {
      display: grid;
      grid-template-columns: 36px minmax(0, 1fr);
      align-items: center;
      padding: 18px;
    }
    li.product-application--crop {
      grid-template-columns: 96px minmax(0, 1fr);
      gap: 16px;
    }
    .product-application--crop :global(picture) {
      width: 96px;
    }
    :global(.product-application__image) {
      height: 96px;
    }
  }
</style>
