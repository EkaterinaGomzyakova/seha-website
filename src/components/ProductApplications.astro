---
import type { Locale } from '../data/translations';
import {
  applications,
  productApplications,
  productApplicationGuidance
} from '../data/product-applications';
import ApplicationIcon from './ApplicationIcon.astro';
interface Props {
  productId: string;
  locale: Locale;
}
const { productId, locale } = Astro.props;
const items = productApplications[productId] || [];
const guidance = productApplicationGuidance[productId] || [];
---

{items.length > 0 && (
  <section class="product-applications" aria-labelledby="product-applications-title">
    <h2 class="type-h2" id="product-applications-title">
      {locale === 'ru' ? 'Где используется' : 'Where it is used'}
    </h2>
    <ul style={`--application-columns: ${items.length === 4 ? 2 : Math.min(items.length, 3)}`}>
      {items.map((key) => {
        const item = applications[key];
        return (
          <li>
            <ApplicationIcon name={item.icon} />
            <h3 class="type-h3">{item.label[locale]}</h3>
          </li>
        );
      })}
    </ul>
    {guidance.length > 0 && (
      <div class="application-guidance">
        <h3 class="type-h3">{locale === 'ru' ? 'Как использовать' : 'How to use'}</h3>
        <dl>
          {guidance.map((item) => (
            <div>
              <dt class="type-h3">{item.title[locale]}</dt>
              <dd class="type-p">{item.description[locale]}</dd>
            </div>
          ))}
        </dl>
      </div>
    )}
  </section>
)}
<style>
  h2 {
    margin: 0 0 24px;
  }
  ul {
    display: grid;
    grid-template-columns: repeat(var(--application-columns), minmax(0, 1fr));
    gap: 20px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    min-width: 0;
    padding: 24px;
    border: 1px solid var(--color-light-gray);
    border-radius: 20px;
    background: var(--color-white);
    color: var(--color-green-brand);
  }
  h3 {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .application-guidance {
    margin-top: 32px;
  }
  .application-guidance dl {
    margin: 16px 0 0;
  }
  .application-guidance dl > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 24px;
    padding: 20px 0;
    border-top: 1px solid var(--color-light-gray);
  }
  .application-guidance dt,
  .application-guidance dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  @media (max-width: 800px) {
    .application-guidance dl > div {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }
    ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
    li {
      padding: 20px;
    }
  }
  @media (max-width: 440px) {
    ul {
      grid-template-columns: minmax(0, 1fr);
    }
    li {
      display: grid;
      grid-template-columns: 36px minmax(0, 1fr);
      align-items: center;
      padding: 18px;
    }
  }
</style>
