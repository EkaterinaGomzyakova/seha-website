---
import type { Locale } from '../data/translations';
import { applications, productApplications } from '../data/product-applications';
import ApplicationIcon from './ApplicationIcon.astro';
interface Props {
  productId: string;
  locale: Locale;
}
const { productId, locale } = Astro.props;
const items = productApplications[productId] || [];
---

{items.length > 0 && (
  <section class="product-applications" aria-labelledby="product-applications-title">
    <h2 class="type-h2" id="product-applications-title">
      {locale === 'ru' ? 'Где используют' : 'Applications'}
    </h2>
    <ul style={`--application-columns: ${items.length === 4 ? 4 : Math.min(items.length, 3)}`}>
      {items.map((key) => {
        const item = applications[key];
        return (
          <li>
            <ApplicationIcon name={item.icon} />
            <h3>{item.label[locale]}</h3>
            {item.note && <p class="type-p">{item.note[locale]}</p>}
          </li>
        );
      })}
    </ul>
  </section>
)}
<style>
  h2 {
    margin: 0 0 24px;
  }
  ul {
    display: grid;
    grid-template-columns: repeat(var(--application-columns), minmax(0, 1fr));
    gap: 20px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    min-width: 0;
    padding: 24px;
    border: 1px solid var(--color-light-gray);
    border-radius: 20px;
    background: var(--color-white);
    color: var(--color-green-brand);
  }
  h3 {
    margin: 0;
    font: 700 18px/1.25 var(--font-sans);
    overflow-wrap: anywhere;
  }
  p {
    margin: 0;
    color: var(--color-dark-gray);
  }
  @media (max-width: 800px) {
    ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
    li {
      padding: 20px;
    }
  }
  @media (max-width: 440px) {
    ul {
      grid-template-columns: minmax(0, 1fr);
    }
    li {
      display: grid;
      grid-template-columns: 36px minmax(0, 1fr);
      align-items: center;
      padding: 18px;
    }
    p {
      grid-column: 2;
    }
    h3 {
      font-size: 16px;
    }
  }
</style>
