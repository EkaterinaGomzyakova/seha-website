---
import type { Locale } from '../data/translations';
import {
  applications,
  productApplications,
  productApplicationDescriptions
} from '../data/product-applications';
import CropApplicationCard from './CropApplicationCard.astro';
interface Props {
  productId: string;
  locale: Locale;
}
const { productId, locale } = Astro.props;
const items = productApplications[productId] || [];
---

{items.length > 0 && (
  <section class="product-applications" aria-labelledby="product-applications-title">
    <h2 class="type-h2" id="product-applications-title">
      {locale === 'ru' ? 'Где используется' : 'Where it is used'}
    </h2>
    <ul>
      {items.map((key) => (
        <CropApplicationCard
          title={applications[key].label[locale]}
          description={productApplicationDescriptions[productId]?.[key]?.[locale]}
          image={applications[key].image}
        />
      ))}
    </ul>
  </section>
)}
<style>
  h2 {
    margin: 0 0 24px;
  }
  ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  @media (max-width: 800px) {
    ul {
      gap: 16px;
    }
  }
  @media (max-width: 440px) {
    ul {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
