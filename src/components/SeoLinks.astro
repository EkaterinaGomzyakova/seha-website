---
import { localizedPath, withBase } from '../lib/paths';
import { siteContact } from '../data/site';
import {
  products,
  productCategories,
  productsForCategory,
  type ProductCategorySlug
} from '../data/products';
import { publicRoutes } from '../data/routes';

interface Props {
  locale: 'ru' | 'en';
  path: string;
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}
const { locale, path, title, description, image, noindex = false } = Astro.props;
const site = Astro.site ?? new URL('https://seha-group.ru');
const normalizedPath = path.replace(/^\/(ru|en)(?=\/|$)/, '').replace(/\/$/, '') || '/';
const is404 = normalizedPath === '/404' || /\/404(?:\.html)?\/?$/.test(Astro.url.pathname);
const robotsNoindex = noindex || is404;
const category = productCategories.find(
  (category) => normalizedPath === '/products/' + category.slug
);
const isCatalog = normalizedPath === '/products';
const detailProduct = products.find(
  (product) => normalizedPath === `/products/${product.category}/${product.slug}`
);
const absolute = (url: string) => new URL(url, site).toString();
const canonical = absolute(is404 ? withBase('/404/') : localizedPath(normalizedPath, locale));
const rootUrl = absolute(withBase('/'));
const localeCode = locale === 'en' ? 'en-US' : 'ru-RU';
const localized = (value: { ru: string; en: string }) => value[locale];
const absoluteImage = absolute(
  withBase(
    image ??
      category?.image ??
      (isCatalog
        ? '/assets/images/products/coconut-products.png'
        : normalizedPath === '/production'
          ? '/assets/images/common/production-hero.webp'
          : normalizedPath === '/quality'
            ? '/assets/images/common/production-packing.webp'
            : '/assets/images/common/home-coconut.webp')
  )
);
// Only emit alternate links when a corresponding real locale route exists.
const routes = Object.keys(import.meta.glob('../pages/**/*.astro'));
const alternateLocales = robotsNoindex
  ? []
  : (['ru', 'en'] as const).filter(
      (language) =>
        publicRoutes.includes(`${normalizedPath === '/' ? '' : normalizedPath}/`) ||
        routes.includes(
          '../pages/' + language + (normalizedPath === '/' ? '' : normalizedPath) + '/index.astro'
        )
    );
const breadcrumbs = [
  { name: locale === 'en' ? 'Home' : 'Главная', url: absolute(localizedPath('/', locale)) },
  ...(isCatalog || category
    ? [
        {
          name: locale === 'en' ? 'Products' : 'Продукты',
          url: absolute(localizedPath('/products', locale))
        }
      ]
    : []),
  ...(category ? [{ name: localized(category.title), url: canonical }] : [])
];
const listItems = category
  ? productsForCategory(category.slug as ProductCategorySlug).map((product, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'Thing',
        '@id': absolute(localizedPath(`/products/${product.category}/${product.slug}/`, locale)),
        url: absolute(localizedPath(`/products/${product.category}/${product.slug}/`, locale)),
        name: localized(product.name),
        description: localized(product.description),
        image: absolute(withBase(product.image))
      }
    }))
  : productCategories.map((entry, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'CollectionPage',
        url: absolute(localizedPath('/products/' + entry.slug, locale)),
        name: localized(entry.title),
        description: localized(entry.description),
        image: absolute(withBase(entry.image))
      }
    }));
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    ...(detailProduct
      ? [
          {
            '@type': 'Product',
            name: localized(detailProduct.name),
            description: localized(detailProduct.description),
            image: absoluteImage,
            url: canonical,
            manufacturer: {
              '@type': 'Organization',
              name: 'SEHA Group of Companies',
              address: { '@type': 'PostalAddress', addressCountry: 'IN' }
            }
          }
        ]
      : []),
    {
      '@type': 'Organization',
      '@id': rootUrl + '#organization',
      name: siteContact.name,
      url: rootUrl,
      email: siteContact.email,
      telephone: siteContact.phone,
      address: {
        '@type': 'PostalAddress',
        streetAddress: siteContact.street,
        addressLocality: siteContact.city,
        postalCode: siteContact.postalCode,
        addressCountry: siteContact.country
      }
    },
    {
      '@type': 'WebSite',
      '@id': rootUrl + '#website',
      name: 'SEHA',
      url: rootUrl,
      inLanguage: ['ru-RU', 'en-US'],
      publisher: { '@id': rootUrl + '#organization' }
    },
    {
      '@type': category || isCatalog ? 'CollectionPage' : 'WebPage',
      '@id': canonical + '#webpage',
      url: canonical,
      name: title,
      description,
      inLanguage: localeCode,
      image: absoluteImage,
      isPartOf: { '@id': rootUrl + '#website' },
      ...(category || isCatalog
        ? {
            mainEntity: { '@id': canonical + '#items' },
            breadcrumb: { '@id': canonical + '#breadcrumbs' }
          }
        : {})
    },
    ...(category || isCatalog
      ? [
          {
            '@type': 'ItemList',
            '@id': canonical + '#items',
            name: title,
            numberOfItems: listItems.length,
            itemListOrder: 'https://schema.org/ItemListOrderAscending',
            itemListElement: listItems
          },
          {
            '@type': 'BreadcrumbList',
            '@id': canonical + '#breadcrumbs',
            itemListElement: breadcrumbs.map((entry, index) => ({
              '@type': 'ListItem',
              position: index + 1,
              name: entry.name,
              item: entry.url
            }))
          }
        ]
      : [])
  ]
};
---

{robotsNoindex && <meta name="robots" content="noindex, follow" />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content="SEHA" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={absoluteImage} />
<meta property="og:image:alt" content={title} />
<meta property="og:locale" content={locale === 'en' ? 'en_US' : 'ru_RU'} />
{alternateLocales
  .filter((language) => language !== locale)
  .map((language) => (
    <meta property="og:locale:alternate" content={language === 'en' ? 'en_US' : 'ru_RU'} />
  ))}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImage} />
<meta name="twitter:image:alt" content={title} />
{!is404 && <link rel="canonical" href={canonical} />}
{alternateLocales.map((language) => (
  <link
    rel="alternate"
    hreflang={language}
    href={absolute(localizedPath(normalizedPath, language))}
  />
))}
{alternateLocales.includes('ru') && (
  <link rel="alternate" hreflang="x-default" href={absolute(localizedPath(normalizedPath, 'ru'))} />
)}
{!robotsNoindex && (
  <script
    type="application/ld+json"
    set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
  ></script>
)}
