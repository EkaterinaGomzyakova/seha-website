---
import type { Locale } from '../data/translations';
import { getInterfaceCopy } from '../data/interface-copy';
import { localizedPath, withBase } from '../lib/paths';
import Button from './ui/Button.astro';
import ResponsiveImage from './ResponsiveImage.astro';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = getInterfaceCopy(locale);
---

<seha-cookie-banner class="cookie-banner" aria-label={copy.cookieTitle} hidden>
  <div class="cookie-header">
    <span class="cookie-badge" aria-hidden="true">
      <ResponsiveImage
        src="/assets/images/common/cookie-coconut.png"
        alt=""
        sizes="80px"
        loading="eager"
      />
    </span>
    <button class="cookie-close" type="button" aria-label={copy.close}>
      <img src={withBase('/assets/images/common/cookie-xmark.svg')} alt="" />
    </button>
  </div>
  <div class="cookie-content">
    <p id="cookie-message" data-cookie-message>
      {copy.cookieText} <a href={localizedPath('/privacy/', locale)}>{copy.cookieLink}</a>.
    </p>
    <Button variant="secondary" compact class="cookie-action" data-cookie-action>
      {copy.cookieAction}
    </Button>
  </div>
</seha-cookie-banner>
