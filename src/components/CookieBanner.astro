---
import type { Locale } from '../data/translations';
import { getInterfaceCopy } from '../data/interface-copy';
import { localizedPath } from '../lib/paths';
import Button from './ui/Button.astro';
import TablerIcon from './ui/TablerIcon.astro';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = getInterfaceCopy(locale);
---

<seha-cookie-banner class="cookie-banner" aria-label={copy.cookieTitle} hidden>
  <button class="cookie-close" type="button" aria-label={copy.cookieReject}>
    <TablerIcon name="x" size={20} />
  </button>
  <div class="cookie-content">
    <p id="cookie-message" data-cookie-message>
      {copy.cookieText}{' '}
      <a href={`${localizedPath('/consent/', locale)}#analytics`} target="_blank" rel="noopener">
        {copy.cookieDetails}
      </a>
    </p>
    <div class="cookie-actions">
      <Button variant="secondary" full class="cookie-action" data-cookie-action>
        {copy.cookieAction}
      </Button>
      <button class="button cookie-action cookie-reject" type="button" data-cookie-reject>
        {copy.cookieReject}
      </button>
    </div>
    <p data-cookie-error role="status" hidden>
      {copy.cookieError}
    </p>
  </div>
</seha-cookie-banner>
