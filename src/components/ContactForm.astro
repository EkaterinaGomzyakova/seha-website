---
import Button from './ui/Button.astro';
import Checkbox from './ui/Checkbox.astro';
import Input from './ui/Input.astro';
import Tag from './ui/Tag.astro';
import Link from './ui/Link.astro';
import type { Locale } from '../data/translations';
import { getInterfaceCopy } from '../data/interface-copy';
import { siteContact } from '../data/site';
import { localizedPath } from '../lib/paths';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = getInterfaceCopy(locale);
const businessValues = [
  'distributor',
  'retailer',
  'manufacturer',
  'hydroponic-farm',
  'horticulture',
  'food-brand',
  'other'
];
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT || undefined;
---

<form
  id="quote-form"
  data-form-endpoint={endpoint}
  data-locale={locale}
  action={endpoint || `mailto:${siteContact.email}`}
  method="post"
  enctype={endpoint ? 'multipart/form-data' : 'text/plain'}
>
  <input type="hidden" name="locale" value={locale} />
  <input type="hidden" name="product" value="" />
  <input type="hidden" name="productId" value="" />
  <div class="form-grid">
    <Input
      label={copy.company}
      name="company"
      autocomplete="organization"
      placeholder={copy.companyPlaceholder}
      required
      maxlength="160"
    />
    <Input
      label={copy.contact}
      name="contact"
      autocomplete="name"
      placeholder={copy.contactPlaceholder}
      required
      maxlength="120"
    />
    <Input
      label={copy.email}
      name="email"
      type="email"
      autocomplete="email"
      placeholder="email@example.com"
      maxlength="160"
    />
    <label class="form-field">
      {copy.phone}
      <input
        name="phone"
        type="tel"
        autocomplete="tel"
        placeholder="+7 999 999-99-99"
        required
        maxlength="40"
        aria-describedby="phone-error"
      />
      <span class="field-error" id="phone-error" hidden>
        {copy.phoneError}
      </span>
    </label>
  </div>
  <label class="form-field comment-field">
    {copy.message}
    <textarea
      name="comment"
      rows="2"
      placeholder={copy.messagePlaceholder}
      maxlength="1500"
    ></textarea>
  </label>
  <fieldset class="business-options">
    <legend>{copy.business}</legend>
    <div class="business-choices">
      {copy.businesses.map((label, index) => (
        <label>
          <input type="radio" name="business" value={businessValues[index]} />
          <Tag>{label}</Tag>
        </label>
      ))}
    </div>
  </fieldset>
  <Checkbox name="consent" required>
    <span class="consent__text">
      {copy.consentStart} <Link href={localizedPath('/privacy/', locale)}>{copy.consentLink}</Link>{' '}
      {copy.consentEnd}
    </span>
  </Checkbox>
  <Button variant="secondary" full type="submit">
    {copy.submit}
  </Button>
  <div id="quote-result" class="quote-result" role="status" tabindex="-1" hidden>
    <strong data-result-title></strong>
    <p class="type-p" data-result-message></p>
    <div data-result-actions hidden>
      <Link data-email-quote href={`mailto:${siteContact.email}`}>
        {siteContact.email}
      </Link>
      <Button variant="tertiary" type="button" id="copy-quote">
        {copy.copy}
      </Button>
      <textarea id="quote-copy-fallback" readonly aria-label={copy.copyLabel} hidden></textarea>
    </div>
  </div>
  <noscript>
    <p>
      {copy.noScript} <a href={`mailto:${siteContact.email}`}>{siteContact.email}</a>
    </p>
  </noscript>
</form>
