---
import type { Locale } from '../data/translations';
import ResponsiveImage from './ResponsiveImage.astro';
import ArrowCircle from './ui/ArrowCircle.astro';

interface Props {
  images: string[];
  alt: string;
  locale: Locale;
}

const { images, alt, locale } = Astro.props;
const galleryLabel = locale === 'ru' ? 'Фотографии товара' : 'Product photos';
---

<div class="product-gallery" data-product-gallery role="group" aria-label={galleryLabel}>
  <div class="product-gallery__main" data-gallery-main>
    <ResponsiveImage
      src={images[0]}
      alt={alt}
      sizes="(max-width: 800px) calc(100vw - 64px), 50vw"
      loading="eager"
      fetchpriority="high"
    />
    {images.length > 1 && (
      <>
        <button
          type="button"
          class="product-gallery__arrow product-gallery__arrow--previous"
          data-gallery-previous
          hidden
          aria-label={locale === 'ru' ? 'Предыдущее фото' : 'Previous photo'}
        >
          <ArrowCircle />
        </button>
        <button
          type="button"
          class="product-gallery__arrow product-gallery__arrow--next"
          data-gallery-next
          hidden
          aria-label={locale === 'ru' ? 'Следующее фото' : 'Next photo'}
        >
          <ArrowCircle />
        </button>
        <span
          class="product-gallery__count"
          data-gallery-count
          aria-live="polite"
          aria-atomic="true"
        >
          1 / {images.length}
        </span>
      </>
    )}
  </div>
  <div class="product-gallery__thumbnails" role="group" aria-label={galleryLabel}>
    {images.map((src, index) => (
      <button
        class="product-gallery__thumbnail"
        type="button"
        data-gallery-thumbnail
        aria-label={locale === 'ru' ? `Показать фото ${index + 1}` : `Show photo ${index + 1}`}
        aria-pressed={index === 0 ? 'true' : 'false'}
      >
        <ResponsiveImage src={src} alt="" sizes="(max-width: 800px) 20vw, 8vw" loading="lazy" />
      </button>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-product-gallery]').forEach((gallery) => {
    const main = gallery.querySelector<HTMLElement>('[data-gallery-main]');
    const thumbnails = gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-thumbnail]');
    if (!main || thumbnails.length === 0) return;

    const alt = main.querySelector<HTMLImageElement>('img')?.alt ?? '';
    const sizes = main.querySelector('source')?.getAttribute('sizes');
    const counter = gallery.querySelector<HTMLElement>('[data-gallery-count]');
    let current = 0;
    const show = (index: number) => {
      const next = (index + thumbnails.length) % thumbnails.length;
      if (next === current) return;
      const thumbnail = thumbnails[next];
      const picture = thumbnail.querySelector('picture');
      const currentPicture = main.querySelector('picture');
      if (!picture || !currentPicture) return;

      const replacement = picture.cloneNode(true) as HTMLPictureElement;
      const image = replacement.querySelector('img');
      if (image) {
        image.loading = 'eager';
        image.alt = alt;
      }
      if (sizes)
        replacement
          .querySelectorAll('source')
          .forEach((source) => source.setAttribute('sizes', sizes));
      currentPicture.replaceWith(replacement);
      thumbnails.forEach((button) =>
        button.setAttribute('aria-pressed', button === thumbnail ? 'true' : 'false')
      );
      current = next;
      if (counter) counter.textContent = `${current + 1} / ${thumbnails.length}`;
    };
    thumbnails.forEach((thumbnail, index) => {
      thumbnail.addEventListener('click', () => show(index));
    });
    for (const [selector, direction] of [
      ['[data-gallery-previous]', -1],
      ['[data-gallery-next]', 1]
    ] as const) {
      const button = gallery.querySelector<HTMLButtonElement>(selector);
      if (!button) continue;
      button.hidden = false;
      button.addEventListener('click', () => show(current + direction));
    }
    gallery.addEventListener('keydown', (event) => {
      if (event.altKey || event.ctrlKey || event.metaKey) return;
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      show(current + (event.key === 'ArrowLeft' ? -1 : 1));
    });
  });
</script>

<style>
  .product-gallery {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .product-gallery__main {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border-radius: 32px;
  }
  .product-gallery__arrow {
    position: absolute;
    top: 50%;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--color-light-gray);
    border-radius: 50%;
    background: var(--color-white);
    transform: translateY(-50%);
    cursor: pointer;
  }
  .product-gallery__arrow--previous {
    left: 12px;
  }
  .product-gallery__arrow--next {
    right: 12px;
  }
  .product-gallery__arrow :global(.arrow-circle) {
    width: 44px;
    height: 44px;
    border: 0;
  }
  .product-gallery__arrow--previous :global(.arrow-circle) {
    transform: rotate(180deg);
  }
  .product-gallery__arrow:focus-visible {
    outline: var(--focus-outline);
    outline-offset: 3px;
  }
  .product-gallery__count {
    position: absolute;
    bottom: 12px;
    left: 50%;
    transform: translateX(-50%);
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--color-white);
    color: var(--color-green-brand);
    font: 500 13px/1.5 var(--font-sans);
    font-variant-numeric: tabular-nums;
  }
  .product-gallery__arrow,
  .product-gallery__count {
    transition:
      opacity 240ms ease,
      transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (hover: hover) and (pointer: fine) {
    .product-gallery__arrow,
    .product-gallery__count {
      opacity: 0;
      pointer-events: none;
    }
    .product-gallery__arrow {
      transform: translateY(calc(-50% + 4px));
    }
    .product-gallery__count {
      transform: translate(-50%, 4px);
    }
    .product-gallery__main:hover .product-gallery__arrow,
    .product-gallery__main:focus-within .product-gallery__arrow {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(-50%);
    }
    .product-gallery__main:hover .product-gallery__count,
    .product-gallery__main:focus-within .product-gallery__count {
      opacity: 1;
      transform: translate(-50%, 0);
    }
  }
  @media (any-pointer: coarse) {
    .product-gallery__arrow,
    .product-gallery__count {
      opacity: 1;
    }
    .product-gallery__arrow {
      pointer-events: auto;
      transform: translateY(-50%);
    }
    .product-gallery__count {
      transform: translate(-50%, 0);
    }
  }

  .product-gallery__thumbnails {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .product-gallery__thumbnail {
    aspect-ratio: 1;
    min-width: 0;
    overflow: hidden;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 14px;
    background: transparent;
    cursor: pointer;
  }

  .product-gallery__thumbnail[aria-pressed='true'] {
    border-color: var(--color-green-brand);
  }

  .product-gallery__thumbnail:focus-visible {
    outline: 3px solid var(--color-yellow-brand);
    outline-offset: 3px;
  }

  .product-gallery__thumbnail :global(picture),
  .product-gallery__thumbnail :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .product-gallery__thumbnail :global(img) {
    object-fit: cover;
  }

  @media (max-width: 440px) {
    .product-gallery__thumbnails {
      gap: 8px;
    }
  }
</style>
