---
import ResponsiveImage from './ResponsiveImage.astro';
interface Props {
  title: string;
  description?: string;
  image: string;
}
const { title, description, image } = Astro.props;
---

<li class="crop-application-card product-application--crop">
  <ResponsiveImage
    src={image}
    alt=""
    sizes="(max-width: 440px) 96px, (max-width: 1024px) 128px, 160px"
    loading="lazy"
    class="crop-application-card__image"
  />
  <div>
    <h3 class="type-h3">{title}</h3>
    {description && <p class="type-p">{description}</p>}
  </div>
</li>
<style>
  li {
    display: flex;
    align-items: center;
    gap: 24px;
    min-width: 0;
    min-height: 240px;
    padding: 24px;
    border: 1px solid var(--color-light-gray);
    border-radius: 20px;
    background: var(--color-white);
    color: var(--color-green-brand);
  }
  li :global(picture) {
    flex: 0 0 160px;
    width: 160px;
  }
  li :global(.crop-application-card__image) {
    width: 100%;
    height: 160px;
    object-fit: contain;
  }
  div {
    min-width: 0;
  }
  h3 {
    margin: 0;
    overflow-wrap: anywhere;
  }
  p {
    margin: 10px 0 0;
    color: var(--color-dark-gray);
  }
  @media (min-width: 441px) and (max-width: 1024px) {
    li {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      padding: 20px;
      min-height: 400px;
    }
    li :global(picture) {
      flex: 0 0 128px;
      width: 128px;
    }
    li :global(.crop-application-card__image) {
      height: 128px;
    }
  }
  @media (max-width: 440px) {
    li {
      display: grid;
      grid-template-columns: 96px minmax(0, 1fr);
      gap: 16px;
      min-height: 264px;
      padding: 18px;
    }
    li :global(picture) {
      width: 96px;
    }
    li :global(.crop-application-card__image) {
      height: 96px;
    }
  }
</style>
