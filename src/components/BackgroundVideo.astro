---
import { withBase } from '../lib/paths';
---

<div class="background-video" data-background-video>
  <video
    muted
    loop
    playsinline
    preload="none"
    aria-hidden="true"
    width="1280"
    height="720"
    poster={withBase('/assets/videos/home/seha-farm-poster.webp')}
    data-src={withBase('/assets/videos/home/seha-farm.mp4')}
  ></video>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-background-video]').forEach((root) => {
    const video = root.querySelector('video')!;
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let visible = false;
    const play = async () => {
      if (!video.getAttribute('src')) video.src = video.dataset.src!;
      video.muted = true;
      try {
        await video.play();
      } catch {
        /* Poster remains visible if playback is blocked. */
      }
    };
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible && !reducedMotion.matches) void play();
      else video.pause();
    }).observe(video);
    reducedMotion.addEventListener('change', () => {
      if (reducedMotion.matches) video.pause();
      else if (visible) void play();
    });
  });
</script>

<style>
  .background-video {
    display: contents;
  }
  .background-video video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
</style>
