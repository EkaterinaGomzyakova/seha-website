---
import { applicationIcons, type ApplicationIconName } from '../data/application-icons';
interface Props {
  name: ApplicationIconName;
}
const { name } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width="36"
  height="36"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {applicationIcons[name].map((d) => (
    <path d={d} />
  ))}
</svg>
