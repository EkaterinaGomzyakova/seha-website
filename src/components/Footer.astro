---
import ContactForm from './ContactForm.astro';
import Logo from './Logo.astro';
import Link from './ui/Link.astro';
import type { Locale } from '../data/translations';
import { getInterfaceCopy } from '../data/interface-copy';
import { siteContact } from '../data/site';
import { localizedPath } from '../lib/paths';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = getInterfaceCopy(locale);
---

<footer class="quote-footer" id="contacts">
  <div class="quote-layout">
    <section class="quote-main" aria-labelledby="quote-title">
      <h2 id="quote-title" class="type-h2" set:html={copy.title} />
      <ContactForm locale={locale} />
    </section>
    <aside class="quote-contacts" aria-labelledby="contacts-title">
      <span class="quote-kicker" id="contacts-title">
        {copy.contacts}
      </span>
      <div class="contact-item address">
        <strong>{copy.address}</strong>
        <p class="type-p" set:html={copy.addressText} />
      </div>
      <div class="contact-item">
        <span>{copy.phoneLabel}</span>
        <Link href={siteContact.phoneHref}>{siteContact.phone}</Link>
      </div>
      <div class="contact-item">
        <span>{copy.emailLabel}</span>
        <Link href={`mailto:${siteContact.email}`}>{siteContact.email}</Link>
      </div>
    </aside>
  </div>
  <div class="quote-bottom">
    <div class="quote-brand">
      <Logo locale={locale} />
      <span set:html={copy.brand} />
    </div>
    <Link href={localizedPath('/privacy/', locale)}>{copy.privacy.toUpperCase()}</Link>
  </div>
</footer>
