---
import ContactForm from './ContactForm.astro';
---
<footer class="quote-footer" id="contacts">
      <div class="quote-layout">
        <section class="quote-main" aria-labelledby="quote-title">
          <h2 id="quote-title" class="type-h2">Получите<br />расчёт<br />поставки</h2>
          <ContactForm />
        </section>
        <aside class="quote-contacts" aria-labelledby="contacts-title">
          <span class="quote-kicker" id="contacts-title">КОНТАКТЫ</span>
          <div class="contact-item address">
            <strong>Юридический адрес</strong>
            <p class="type-p">115432, Россия, Москва<br />б-р Братьев Весниных, д. 1, пом. 151К</p>
          </div>
          <div class="contact-item">
            <span>ТЕЛЕФОН</span><a href="tel:+79660612828">+7 966 061-28-28</a>
          </div>
          <div class="contact-item">
            <span>ПОЧТА</span><a href="mailto:seha.info@inbox.ru">seha.info@inbox.ru</a>
          </div>
        </aside>
      </div>
      <div class="quote-bottom">
        <div class="quote-brand">
          <a class="logo" href="/" aria-label="Сеха — главная"
            ><img class="logo-image" src="/assets/images/common/russian_logo.svg" alt="Сеха" /></a
          ><span>НАТУРАЛЬНЫЕ ПРОДУКТЫ<br />ИЗ КОКОСА</span>
        </div>
        <a href="/privacy">ПОЛИТИКА КОНФИДЕНЦИАЛЬНОСТИ</a>
      </div>
    </footer>
