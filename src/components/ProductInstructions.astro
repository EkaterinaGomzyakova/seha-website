---
import type { Locale } from '../data/translations';
import { productInstructions } from '../data/product-instructions';
interface Props {
  productId: string;
  locale: Locale;
}
const { productId, locale } = Astro.props;
const steps = productInstructions[productId];
---

{steps && (
  <section class="product-instructions" aria-labelledby="product-instructions-title">
    <h2 class="type-h2" id="product-instructions-title">
      {locale === 'ru' ? 'Как использовать' : 'How to use'}
    </h2>
    <p class="type-p product-instructions__intro">
      {locale === 'ru'
        ? 'Все пропорции смесей указаны по объёму. Режим полива и питания подбирайте по культуре, воде и характеристикам поставленной партии.'
        : 'All blend proportions are by volume. Match irrigation and feeding to the crop, water quality and the supplied batch.'}
    </p>
    <ol>
      {steps.map((step) => (
        <li>
          <h3 class="type-h3">{step.title[locale]}</h3>
          <p class="type-p">{step.description[locale]}</p>
        </li>
      ))}
    </ol>
  </section>
)}
<style>
  h2,
  h3 {
    margin: 0;
  }
  .product-instructions__intro {
    margin: 20px 0 24px;
    max-width: 76ch;
  }
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: instructions;
  }
  li {
    counter-increment: instructions;
    display: grid;
    grid-template-columns: 48px minmax(180px, 1fr) minmax(0, 2fr);
    gap: 24px;
    padding: 24px 0;
    border-top: 1px solid var(--color-light-gray);
  }
  li::before {
    content: counter(instructions, decimal-leading-zero);
    color: var(--color-dark-gray);
    font: inherit;
  }
  li p {
    margin: 0;
  }
  h3,
  p {
    overflow-wrap: anywhere;
  }
  @media (max-width: 800px) {
    li {
      grid-template-columns: 32px minmax(0, 1fr);
      gap: 12px 16px;
    }
    li p {
      grid-column: 2;
    }
  }
</style>
