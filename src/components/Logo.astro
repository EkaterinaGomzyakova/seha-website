---
import type { Locale } from '../data/translations';
import { getSiteTranslations } from '../data/translations';
import { localizedPath, withBase } from '../lib/paths';
interface Props {
  locale: Locale;
  tone?: 'brand' | 'accent';
}
const { locale, tone = 'brand' } = Astro.props;
const copy = getSiteTranslations(locale);
const language = locale === 'en' ? 'international' : 'russian';
const logo = (variant: string) =>
  withBase(`/assets/images/common/menu-logo-${language}-${variant}.svg`);
---

<a class="logo" href={localizedPath('/', locale)} aria-label={`${copy.logoAlt} — ${copy.home}`}>
  {tone === 'accent' ? (
    <img
      class="logo-image"
      src={withBase(`/assets/images/common/logo-${language}-accent.svg`)}
      alt={copy.logoAlt}
      width="95"
      height={locale === 'en' ? 29.989 : 30.331}
    />
  ) : (
    <picture>
      <source media="(max-width: 1024px)" srcset={logo('mobile')} />
      <source media="(max-width: 1280px)" srcset={logo('small-desktop')} />
      <img class="logo-image" src={logo('desktop')} alt={copy.logoAlt} width="240" height="48" />
    </picture>
  )}
</a>
