---
import type { Locale } from '../data/translations';
import { getSiteTranslations } from '../data/translations';
import { localizedPath, withBase } from '../lib/paths';
import russianDesktop from '../../public/assets/images/common/menu-logo-russian-desktop.svg?raw';
import russianSmallDesktop from '../../public/assets/images/common/menu-logo-russian-small-desktop.svg?raw';
import russianMobile from '../../public/assets/images/common/menu-logo-russian-mobile.svg?raw';
import internationalDesktop from '../../public/assets/images/common/menu-logo-international-desktop.svg?raw';
import internationalSmallDesktop from '../../public/assets/images/common/menu-logo-international-small-desktop.svg?raw';
import internationalMobile from '../../public/assets/images/common/menu-logo-international-mobile.svg?raw';
interface Props {
  locale: Locale;
  tone?: 'brand' | 'accent';
}
const { locale, tone = 'brand' } = Astro.props;
const copy = getSiteTranslations(locale);
const language = locale === 'en' ? 'international' : 'russian';
const variants =
  locale === 'ru'
    ? { desktop: russianDesktop, 'small-desktop': russianSmallDesktop, mobile: russianMobile }
    : {
        desktop: internationalDesktop,
        'small-desktop': internationalSmallDesktop,
        mobile: internationalMobile
      };
// Embed these small SVGs at build time so the header never depends on a separate image request.
const logo = (variant: keyof typeof variants) =>
  `data:image/svg+xml;charset=utf-8,${encodeURIComponent(variants[variant])}`;
---

<a class="logo" href={localizedPath('/', locale)} aria-label={`${copy.logoAlt} — ${copy.home}`}>
  {tone === 'accent' ? (
    <img
      class="logo-image"
      src={withBase(`/assets/images/common/logo-${language}-accent.svg`)}
      alt={copy.logoAlt}
      width="95"
      height={locale === 'en' ? 29.989 : 30.331}
    />
  ) : (
    <picture>
      <source media="(max-width: 1024px)" srcset={logo('mobile')} />
      <source media="(max-width: 1280px)" srcset={logo('small-desktop')} />
      <img
        class="logo-image"
        src={logo('desktop')}
        alt={copy.logoAlt}
        width="95"
        height={locale === 'en' ? 29.989 : 30.331}
      />
    </picture>
  )}
</a>
