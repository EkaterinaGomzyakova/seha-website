---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Button from '../ui/Button.astro';
import ResponsiveImage from '../ResponsiveImage.astro';
import HeaderContainer from '../ui/HeaderContainer.astro';
import { withBase, localizedPath } from '../../lib/paths';
import { bindShortWords } from '../../lib/typography';
import { productionPageCopy } from '../../data/production-page';
import type { Locale } from '../../data/translations';
interface Props {
  locale: Locale;
  rootAlias?: boolean;
}
const { locale, rootAlias = false } = Astro.props;
const copy = productionPageCopy[locale];
const href = (path: string) =>
  path.startsWith('#') || rootAlias ? withBase(path) : localizedPath(path, locale);
const text = (value: string) => bindShortWords(value, locale);
const image = (name: string) => '/assets/images/production/' + name + '.png';
const sizes =
  '(max-width: 440px) calc(100vw - 48px), (max-width: 800px) calc(100vw - 64px), (max-width: 1280px) calc(100vw - 192px), calc(100vw - 272px)';
const stepSizes =
  '(max-width: 440px) calc(100vw - 48px), (max-width: 800px) calc(100vw - 128px), (max-width: 1280px) calc((100vw - 280px) / 2), 514px';
const steps = [
  {
    title: copy.processSectionCardTitle,
    description: copy.processSectionText2,
    alt: copy.processSectionAlt,
    caption: copy.processSectionCaption,
    base: 'manufacturing-hero',
    photo: 'process-raw-materials'
  },
  {
    title: copy.processSectionCardTitle2,
    description: copy.processSectionText3,
    alt: copy.processSectionAlt2,
    caption: copy.processSectionCaption2,
    base: 'process-storage-base',
    photo: 'process-storage'
  },
  {
    title: copy.processSectionCardTitle3,
    description: copy.processSectionText4,
    alt: copy.processSectionAlt3,
    caption: copy.processSectionCaption3,
    base: 'process-food-base',
    photo: 'process-food'
  },
  {
    title: copy.processSectionCardTitle4,
    description: copy.processSectionText5,
    alt: copy.processSectionAlt4,
    caption: copy.processSectionCaption4,
    base: 'process-food-base',
    photo: 'process-fractionation'
  },
  {
    title: copy.processSectionCardTitle5,
    description: copy.processSectionText6,
    alt: copy.processSectionAlt5,
    caption: copy.processSectionCaption5,
    base: 'process-packing-base',
    photo: 'process-packing'
  },
  {
    title: copy.processSectionCardTitle6,
    description: copy.processSectionText7,
    alt: copy.processSectionAlt6,
    caption: copy.processSectionCaption6,
    base: 'process-packing-base',
    photo: 'process-shipment'
  }
];
const units = [
  { title: copy.facilityShowcaseTerm, description: copy.facilityShowcaseLabel3 },
  { title: copy.facilityShowcaseTerm2, description: copy.facilityShowcaseLabel4 },
  { title: copy.facilityShowcaseTerm3, description: copy.facilityShowcaseLabel5 },
  { title: copy.facilityShowcaseTerm4, description: copy.facilityShowcaseLabel6 }
];
const assurance = [
  { title: copy.assuranceSectionCardTitle, description: copy.assuranceSectionText2 },
  { title: copy.assuranceSectionCardTitle2, description: copy.assuranceSectionText3 },
  { title: copy.assuranceSectionCardTitle3, description: copy.assuranceSectionText4 }
];
---

<SiteLayout
  locale={locale}
  path="/production/"
  title={copy.title}
  description={copy.description}
  image={image('manufacturing-hero')}
  bodyClass="production"
  skipText={copy.skipText}
  skipHref="#process"
>
  <nav class="breadcrumbs" aria-label={copy.pageAriaLabel}>
    <a href={href('/')}>{copy.pageLink}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{copy.pageLabel}</span>
  </nav>
  <main class="production-main">
    <section class="production-hero" aria-labelledby="production-title">
      <ResponsiveImage
        src={image('manufacturing-hero')}
        class="production-hero__photo"
        alt={copy.productionHeroAlt}
        sizes={sizes}
        loading="eager"
        fetchpriority="high"
      />
      <div class="production-hero-wash" aria-hidden="true"></div>
      <div class="production-hero-copy">
        <h1 id="production-title" class="type-h1">
          {copy.productionHeroTitle}
          <br />
          <em>{copy.productionHeroEmphasis}</em>
        </h1>
        <p class="type-p">{text(copy.productionHeroText)}</p>
      </div>
    </section>
    <section class="production-branches" aria-labelledby="branches-title">
      <h2 id="branches-title" class="type-h2">
        {copy.productionBranchesHeading}
        <br />
        <span>{copy.productionBranchesLabel3}</span>
      </h2>
      <div class="branch-grid">
        <article class="branch-card">
          <span>{copy.productionSubstratesLabel}</span>
          <h3>{copy.productionBranchesCardTitle}</h3>
          <p>{text(copy.productionBranchesText2)}</p>
          <ul>
            {[
              copy.productionBranchesItem,
              copy.productionBranchesItem2,
              copy.productionBranchesItem3
            ].map((label) => (
              <li>{text(label)}</li>
            ))}
          </ul>
        </article>
        <article class="branch-card branch-card-food">
          <span>{copy.productionFoodLabel}</span>
          <h3>{copy.productionBranchesCardTitle2}</h3>
          <p>{text(copy.productionBranchesText3)}</p>
          <ul>
            {[
              copy.productionBranchesItem4,
              copy.productionBranchesItem5,
              copy.productionBranchesItem6
            ].map((label) => (
              <li>{text(label)}</li>
            ))}
          </ul>
        </article>
      </div>
    </section>
    <section class="process-section" id="process" aria-labelledby="process-title">
      <div class="process-sticky">
        <HeaderContainer tone="green">{copy.processSectionLabel}</HeaderContainer>
        <h2 id="process-title">
          {copy.processSectionHeading}
          <br />
          {copy.processSectionLine}
          <br />
          <em>{copy.processSectionEmphasis}</em>
        </h2>
        <p>{text(copy.processSectionText)}</p>
      </div>
      <div class="process-list">
        {steps.map((step, index) => (
          <article class="process-item">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{text(step.description)}</p>
              <figure class:list={['process-media', 'process-media--' + (index + 1)]}>
                <ResponsiveImage
                  src={image(step.base)}
                  class="process-media__base"
                  alt=""
                  sizes={stepSizes}
                  loading="lazy"
                />
                <ResponsiveImage
                  src={image(step.photo)}
                  class="process-media__photo"
                  alt={step.alt}
                  sizes={stepSizes}
                  loading="lazy"
                />
                <figcaption>{step.caption}</figcaption>
              </figure>
            </div>
          </article>
        ))}
      </div>
    </section>
    <section class="facility-showcase" aria-labelledby="facility-title">
      <div class="facility-image">
        <ResponsiveImage
          src={image('process-food-base')}
          class="facility-image__base"
          alt=""
          sizes={sizes}
          loading="lazy"
        />
        <ResponsiveImage
          src={image('food-facility')}
          class="facility-image__photo"
          alt={copy.facilityShowcaseAlt}
          sizes="(max-width: 800px) 180vw, 110vw"
          loading="lazy"
        />
      </div>
      <div class="facility-copy">
        <HeaderContainer>{copy.facilityShowcaseLabel}</HeaderContainer>
        <h2 id="facility-title" class="type-h2">
          {copy.facilityShowcaseHeading}
          <br />
          <span>{copy.facilityShowcaseLabel2}</span>
        </h2>
        <p>{text(copy.facilityShowcaseText)}</p>
        <div class="facility-units">
          {units.map((unit) => (
            <div>
              <h3>{unit.title}</h3>
              <p>{text(unit.description)}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
    <section class="packing-band" aria-label={copy.packingBandLabel}>
      <ResponsiveImage
        src={image('process-packing-base')}
        class="packing-band__base"
        alt=""
        sizes={sizes}
        loading="lazy"
      />
      <ResponsiveImage
        src={image('packaging-facility')}
        class="packing-band__photo"
        alt={copy.packingBandAlt}
        sizes={sizes}
        loading="lazy"
      />
      <div class="packing-band__copy">
        <span>{copy.packingBandLabel}</span>
        <p>{text(copy.packingBandText)}</p>
      </div>
    </section>
    <section class="assurance-section" aria-labelledby="assurance-title">
      <div class="production-section-heading">
        <h2 id="assurance-title" class="type-h2">
          {copy.assuranceSectionHeading}
          <br />
          <span>{copy.assuranceSectionLabel3}</span>
        </h2>
        <p>{text(copy.assuranceSectionText)}</p>
      </div>
      <div class="assurance-grid">
        {assurance.map((item, index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{item.title}</h3>
            <p>{text(item.description)}</p>
          </article>
        ))}
      </div>
    </section>
    <section class="russia-section" aria-labelledby="russia-title">
      <div class="russia-copy">
        <HeaderContainer tone="green">{copy.russiaSectionLabel}</HeaderContainer>
        <h2 id="russia-title" class="type-h2">
          {copy.russiaSectionHeading}
          <br />
          <em>{copy.russiaSectionEmphasis}</em>
        </h2>
      </div>
      <div class="russia-points">
        <p class="type-p">{text(copy.russiaSectionText)}</p>
        <ul class="russia-list">
          {[
            copy.russiaSectionLabel2,
            copy.russiaSectionLabel3,
            copy.russiaSectionLabel4,
            copy.russiaSectionLabel5
          ].map((label) => (
            <li>{text(label)}</li>
          ))}
        </ul>
      </div>
    </section>
    <section class="cert-preview" aria-labelledby="cert-title">
      <div>
        <HeaderContainer tone="green">{copy.certPreviewLabel}</HeaderContainer>
        <h2 id="cert-title" class="type-h2">
          {copy.certPreviewHeading}
          <br />
          <span>{copy.certPreviewLabel2}</span>
        </h2>
      </div>
      <div class="cert-copy">
        <p class="type-p">{text(copy.certPreviewText)}</p>
        <Button class="production-quality-action" href={href('/quality/')}>
          {copy.certPreviewLink}
        </Button>
      </div>
    </section>
  </main>
</SiteLayout>
