---
import PageHero from '../PageHero.astro';
import BackgroundVideo from '../BackgroundVideo.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Button from '../ui/Button.astro';
import HeaderContainer from '../ui/HeaderContainer.astro';
import { withBase, localizedPath } from '../../lib/paths';
import { aboutPageCopy } from '../../data/about-page';
import type { Locale } from '../../data/translations';

interface Props {
  locale: Locale;
  rootAlias?: boolean;
}
const { locale, rootAlias = false } = Astro.props;
const copy = aboutPageCopy[locale];
const href = (path: string) => (rootAlias ? withBase(path) : localizedPath(path, locale));
const facts = [
  ['40+', copy.aboutNumbersLabel],
  [locale === 'ru' ? 'Поллачи' : 'Pollachi', copy.aboutNumbersLabel2],
  [copy.aboutNumbersValue3, copy.aboutNumbersLabel3],
  [copy.aboutNumbersValue4, copy.aboutNumbersLabel4]
];
const principles = [
  [copy.aboutApproachCardTitle, copy.aboutApproachText2],
  [copy.aboutApproachCardTitle2, copy.aboutApproachText3],
  [copy.aboutApproachCardTitle3, copy.aboutApproachText4],
  [copy.aboutApproachCardTitle4, copy.aboutApproachText5]
];
const milestones = [
  [copy.aboutTimelineLabel3, copy.aboutTimelineCardTitle, copy.aboutTimelineText],
  [copy.aboutTimelineLabel4, copy.aboutTimelineCardTitle2, copy.aboutTimelineText2],
  ['2019', copy.aboutTimelineCardTitle3, copy.aboutTimelineText3],
  [copy.aboutTimelineLabel5, copy.aboutTimelineCardTitle4, copy.aboutTimelineText4]
];
---

<SiteLayout
  locale={locale}
  path="/about"
  title={copy.title}
  description={copy.description}
  bodyClass="about"
  skipText={copy.skipText}
  skipHref="#approach"
  image="/assets/images/shared/plantation-river.webp"
>
  <Breadcrumbs
    locale={locale}
    items={[{ label: copy.pageLink, href: href('/') }, { label: copy.pageLabel }]}
  />
  <main id="main-content" class="about-main">
    <PageHero
      overlay="soft"
      titleId="about-title"
      image="/assets/images/shared/plantation-river.webp"
      alt=""
    >
      <Fragment slot="heading">{copy.aboutHeroTitle}</Fragment>
      <Fragment slot="description">{copy.aboutHeroText}</Fragment>
    </PageHero>
    <section class="about-intro" aria-labelledby="about-intro-title">
      <figure class="about-photo reveal">
        <BackgroundVideo
          src="/assets/videos/about/plantation.mp4"
          poster="/assets/videos/about/plantation-poster.webp"
          label={copy.aboutIntroAlt}
          inline
        />
      </figure>
      <div class="about-intro-copy reveal">
        <h2 id="about-intro-title" class="about-display-title type-h2">
          {copy.aboutIntroHeading}
          <br />
          <span>{copy.aboutIntroLabel2}</span>
        </h2>
        <p class="type-p">{copy.aboutIntroText}</p>
        <p class="type-p">{copy.aboutIntroText2}</p>
        <address class="about-production-address type-p">
          <strong>{copy.aboutProductionAddressLabel}</strong>
          <br />
          1/15B, Andiplayam, Nagamam (via), Kinathukadavu (tk),{' '}
          {locale === 'ru' ? 'Поллачи' : 'Pollachi'}, Coimbatore, Tamil Nadu – 642120, India
        </address>
      </div>
    </section>
    <section class="about-numbers reveal" aria-label={copy.aboutNumbersAriaLabel}>
      {facts.map(([value, text]) => (
        <div>
          <b>{value}</b>
          <p class="type-p">{text}</p>
        </div>
      ))}
    </section>
    <section
      class="about-approach about-inset reveal"
      id="approach"
      aria-labelledby="approach-title"
    >
      <h2 id="approach-title" class="type-h2">
        {copy.aboutApproachHeading}
        <br />
        <span>{copy.aboutApproachLabel3}</span>
      </h2>
      <div class="about-principles">
        {principles.map(([title, text], index) => (
          <article
            class:list={[
              'about-principle',
              (index === 1 || index === 2) && 'about-principle--dark'
            ]}
          >
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3 class="type-h3">{title}</h3>
            <p class="type-p">{text}</p>
          </article>
        ))}
      </div>
    </section>
    <section class="about-shift reveal" aria-labelledby="shift-title">
      <div class="about-shift-copy">
        <HeaderContainer>{copy.aboutShiftLabel}</HeaderContainer>
        <h2 id="shift-title" class="type-h2">
          {copy.aboutShiftHeading}
          <br />
          <em>{copy.aboutShiftEmphasis}</em>
        </h2>
        <p class="type-p">{copy.aboutShiftText}</p>
      </div>
      <figure class="about-shift-image">
        <BackgroundVideo
          src="/assets/videos/about/approach.mp4"
          poster="/assets/videos/about/approach-poster.webp"
          label={copy.aboutShiftAlt}
          inline
        />
      </figure>
    </section>
    <section class="about-timeline about-inset reveal" aria-label={copy.aboutTimelineLabel}>
      <HeaderContainer tone="green">{copy.aboutTimelineLabel}</HeaderContainer>
      <div class="about-timeline-grid">
        {milestones.map(([year, title, text]) => (
          <article>
            <span>{year}</span>
            <h3 class="type-h3">{title}</h3>
            <p class="type-p">{text}</p>
          </article>
        ))}
      </div>
    </section>
    <section class="about-cta" aria-labelledby="about-cta-title">
      <div>
        <HeaderContainer tone="green">{copy.certPreviewLabel}</HeaderContainer>
        <h2 id="about-cta-title" class="type-h2">
          {copy.certPreviewHeading}
          <br />
          <span>{copy.certPreviewLabel2}</span>
        </h2>
      </div>
      <div class="about-cta-copy reveal">
        <p class="type-p">{copy.certPreviewText}</p>
        <Button variant="primary" href="#contacts">
          {copy.certPreviewLink}
        </Button>
      </div>
    </section>
  </main>
</SiteLayout>
