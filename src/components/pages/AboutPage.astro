---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Button from '../ui/Button.astro';
import HeaderContainer from '../ui/HeaderContainer.astro';
import Tag from '../ui/Tag.astro';
import ResponsiveImage from '../ResponsiveImage.astro';
import { withBase, localizedPath } from '../../lib/paths';
import { aboutPageCopy } from '../../data/about-page';
import type { Locale } from '../../data/translations';

interface Props {
  locale: Locale;
  rootAlias?: boolean;
}
const { locale, rootAlias = false } = Astro.props;
const copy = aboutPageCopy[locale];
const href = (path: string) => (rootAlias ? withBase(path) : localizedPath(path, locale));
const facts = [
  ['40+', copy.aboutNumbersLabel],
  ['Pollachi', copy.aboutNumbersLabel2],
  ['4', copy.aboutNumbersLabel3],
  ['B2B', copy.aboutNumbersLabel4]
];
const principles = [
  [copy.aboutApproachCardTitle, copy.aboutApproachText2],
  [copy.aboutApproachCardTitle2, copy.aboutApproachText3],
  [copy.aboutApproachCardTitle3, copy.aboutApproachText4],
  [copy.aboutApproachCardTitle4, copy.aboutApproachText5]
];
const milestones = [
  [copy.aboutTimelineLabel3, copy.aboutTimelineCardTitle, copy.aboutTimelineText],
  [copy.aboutTimelineLabel4, copy.aboutTimelineCardTitle2, copy.aboutTimelineText2],
  ['2019', copy.aboutTimelineCardTitle3, copy.aboutTimelineText3],
  [copy.aboutTimelineLabel5, copy.aboutTimelineCardTitle4, copy.aboutTimelineText4]
];
const clients = [
  copy.aboutClientsLabel3,
  copy.aboutClientsLabel4,
  copy.aboutClientsLabel5,
  copy.aboutClientsLabel6,
  copy.aboutClientsLabel7,
  copy.aboutClientsLabel8,
  copy.aboutClientsLabel9,
  copy.aboutClientsLabel10
];
const photoSizes =
  '(max-width: 440px) calc(100vw - 48px), (max-width: 800px) calc(100vw - 64px), (max-width: 1280px) calc((100vw - 216px) / 2), calc((100vw - 296px) / 2)';
---

<SiteLayout
  locale={locale}
  path="/about"
  title={copy.title}
  description={copy.description}
  bodyClass="about"
  skipText={copy.skipText}
  skipHref="#approach"
  image="/assets/images/about/coconut.png"
>
  <nav class="breadcrumbs" aria-label={copy.pageAriaLabel}>
    <a href={href('/')}>{copy.pageLink}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{copy.pageLabel}</span>
  </nav>
  <main id="main-content" class="about-main">
    <section class="about-hero" aria-labelledby="about-title">
      <h1 id="about-title" class="type-h1">
        {copy.aboutHeroTitle}
      </h1>
      <p class="type-p">{copy.aboutHeroText}</p>
    </section>
    <section class="about-intro" aria-labelledby="about-intro-title">
      <figure class="about-photo">
        <ResponsiveImage
          src="/assets/images/about/coconut.png"
          alt={copy.aboutIntroAlt}
          sizes={photoSizes}
          loading="lazy"
          class="about-photo__image"
        />
        <figcaption>{copy.aboutIntroCaption}</figcaption>
      </figure>
      <div class="about-intro-copy">
        <h2 id="about-intro-title" class="about-display-title">
          {copy.aboutIntroHeading}
          <br />
          <span>{copy.aboutIntroLabel2}</span>
        </h2>
        <p>{copy.aboutIntroText}</p>
        <p>{copy.aboutIntroText2}</p>
      </div>
    </section>
    <section class="about-numbers" aria-label={copy.aboutNumbersAriaLabel}>
      {facts.map(([value, text]) => (
        <div>
          <b>{value}</b>
          <p>{text}</p>
        </div>
      ))}
    </section>
    <section class="about-approach about-inset" id="approach" aria-labelledby="approach-title">
      <h2 id="approach-title" class="type-h2">
        {copy.aboutApproachHeading}
        <br />
        <span>{copy.aboutApproachLabel3}</span>
      </h2>
      <div class="about-principles">
        {principles.map(([title, text], index) => (
          <article
            class:list={[
              'about-principle',
              (index === 1 || index === 2) && 'about-principle--dark'
            ]}
          >
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </section>
    <section class="about-shift" aria-labelledby="shift-title">
      <div class="about-shift-copy">
        <HeaderContainer>{copy.aboutShiftLabel}</HeaderContainer>
        <h2 id="shift-title" class="type-h2">
          {copy.aboutShiftHeading}
          <br />
          <em>{copy.aboutShiftEmphasis}</em>
        </h2>
        <p>{copy.aboutShiftText}</p>
      </div>
      <figure class="about-shift-image">
        <ResponsiveImage
          src="/assets/images/about/facility-base.png"
          alt=""
          sizes={photoSizes}
          loading="lazy"
          class="about-shift-image__base"
        />
        <ResponsiveImage
          src="/assets/images/about/facility.png"
          alt={copy.aboutShiftAlt}
          sizes={photoSizes}
          loading="lazy"
          class="about-shift-image__photo"
        />
      </figure>
    </section>
    <section class="about-timeline about-inset" aria-label={copy.aboutTimelineLabel}>
      <HeaderContainer tone="green">{copy.aboutTimelineLabel}</HeaderContainer>
      <div class="about-timeline-grid">
        {milestones.map(([year, title, text]) => (
          <article>
            <span>{year}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </section>
    <section class="about-clients about-inset" aria-labelledby="clients-title">
      <div>
        <HeaderContainer tone="green">{copy.aboutClientsLabel}</HeaderContainer>
        <h2 id="clients-title" class="type-h2">
          {copy.aboutClientsHeading}
          <br />
          <span>{copy.aboutClientsLabel2}</span>
        </h2>
      </div>
      <ul class="about-client-list">
        {clients.map((client) => (
          <li>
            <Tag class="about-client-tag">{client}</Tag>
          </li>
        ))}
      </ul>
    </section>
    <section class="about-cta" aria-labelledby="about-cta-title">
      <div>
        <HeaderContainer tone="green">{copy.certPreviewLabel}</HeaderContainer>
        <h2 id="about-cta-title" class="type-h2">
          {copy.certPreviewHeading}
          <br />
          <span>{copy.certPreviewLabel2}</span>
        </h2>
      </div>
      <div class="about-cta-copy">
        <p class="type-p">{copy.certPreviewText}</p>
        <Button variant="primary" href="#contacts">
          {copy.certPreviewLink}
        </Button>
      </div>
    </section>
  </main>
</SiteLayout>
