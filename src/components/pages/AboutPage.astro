---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Button from '../ui/Button.astro';
import { withBase, localizedPath } from '../../lib/paths';
import { aboutPageCopy } from '../../data/about-page';
import type { Locale } from '../../data/translations';

interface Props {
  locale: Locale;
  rootAlias?: boolean;
}
const { locale, rootAlias = false } = Astro.props;
const copy = aboutPageCopy[locale];
const path = '/about';
const href = (path: string) =>
  path.startsWith('#') || rootAlias ? withBase(path) : localizedPath(path, locale);
---

<SiteLayout
  locale={locale}
  path={path}
  title={copy.title}
  description={copy.description}
  bodyClass="home about"
  skipText={copy.skipText}
  skipHref={href('#approach')}
>
  <nav class="breadcrumbs" aria-label={copy.pageAriaLabel}>
    <a href={href('/')}>{copy.pageLink}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{copy.pageLabel}</span>
  </nav>
  <main>
    <section class="about-hero" aria-labelledby="about-title">
      <div class="hero-topline">
        <span>{copy.aboutHeroLabel}</span>
        <span>{copy.aboutHeroLabel2}</span>
      </div>
      <div class="about-hero-copy">
        <h1 id="about-title" class="type-h1">
          {copy.aboutHeroTitle}
          <br />
          <em>{copy.aboutHeroEmphasis}</em>
        </h1>
        <p class="type-p">{copy.aboutHeroText}</p>
        <div class="production-actions">
          <Button variant="secondary" href={href('/products')}>
            {copy.aboutHeroLink} <span>↗</span>
          </Button>
          <Button variant="tertiary" href={href('/production')}>
            {copy.aboutHeroLink2}
          </Button>
        </div>
      </div>
      <div class="about-hero-note">
        <span>{copy.aboutHeroLabel3}</span>
      </div>
    </section>
    <section class="about-intro">
      <figure class="about-photo reveal">
        <img
          src={withBase('/assets/images/common/home-coconut.webp')}
          alt={copy.aboutIntroAlt}
          width="1536"
          height="1024"
          loading="lazy"
        />
        <figcaption>{copy.aboutIntroCaption}</figcaption>
      </figure>
      <div class="about-intro-copy">
        <span class="section-label reveal">{copy.aboutIntroLabel}</span>
        <h2 class="reveal type-h2">
          {copy.aboutIntroHeading}
          <br />
          <span>{copy.aboutIntroLabel2}</span>
        </h2>
        <p class="reveal type-p">{copy.aboutIntroText}</p>
        <p class="reveal type-p">{copy.aboutIntroText2}</p>
      </div>
    </section>
    <section class="about-numbers" aria-label={copy.aboutNumbersAriaLabel}>
      <div class="reveal">
        <b>40+</b>
        <span>{copy.aboutNumbersLabel}</span>
      </div>
      <div class="reveal">
        <b>Pollachi</b>
        <span>{copy.aboutNumbersLabel2}</span>
      </div>
      <div class="reveal">
        <b>4</b>
        <span>{copy.aboutNumbersLabel3}</span>
      </div>
      <div class="reveal">
        <b>B2B</b>
        <span>{copy.aboutNumbersLabel4}</span>
      </div>
    </section>
    <section class="home-section about-approach" id="approach">
      <div class="section-top reveal">
        <span class="section-label">{copy.aboutApproachLabel}</span>
        <span class="section-note">{copy.aboutApproachLabel2}</span>
      </div>
      <div class="section-heading reveal">
        <h2 class="type-h2">
          {copy.aboutApproachHeading}
          <br />
          <span>{copy.aboutApproachLabel3}</span>
        </h2>
        <p class="type-p">{copy.aboutApproachText}</p>
      </div>
      <div class="about-principles">
        <article class="reveal">
          <span>01</span>
          <h3 class="type-h3">{copy.aboutApproachCardTitle}</h3>
          <p class="type-p">{copy.aboutApproachText2}</p>
        </article>
        <article class="reveal">
          <span>02</span>
          <h3 class="type-h3">{copy.aboutApproachCardTitle2}</h3>
          <p class="type-p">{copy.aboutApproachText3}</p>
        </article>
        <article class="reveal">
          <span>03</span>
          <h3 class="type-h3">{copy.aboutApproachCardTitle3}</h3>
          <p class="type-p">{copy.aboutApproachText4}</p>
        </article>
        <article class="reveal">
          <span>04</span>
          <h3 class="type-h3">{copy.aboutApproachCardTitle4}</h3>
          <p class="type-p">{copy.aboutApproachText5}</p>
        </article>
      </div>
    </section>
    <section class="about-shift">
      <div class="about-shift-copy">
        <span class="section-label reveal">{copy.aboutShiftLabel}</span>
        <h2 class="reveal type-h2">
          {copy.aboutShiftHeading}
          <br />
          <em>{copy.aboutShiftEmphasis}</em>
        </h2>
        <p class="reveal type-p">{copy.aboutShiftText}</p>
      </div>
      <figure class="about-shift-image reveal">
        <img
          src={withBase('/assets/images/common/production-hero.webp')}
          alt={copy.aboutShiftAlt}
          width="1536"
          height="1024"
          loading="lazy"
        />
        <figcaption>{copy.aboutShiftCaption}</figcaption>
      </figure>
    </section>
    <section class="home-section about-timeline">
      <div class="section-top reveal">
        <span class="section-label">{copy.aboutTimelineLabel}</span>
        <span class="section-note">{copy.aboutTimelineLabel2}</span>
      </div>
      <div class="timeline-grid">
        <article class="reveal">
          <span>{copy.aboutTimelineLabel3}</span>
          <h3 class="type-h3">{copy.aboutTimelineCardTitle}</h3>
          <p class="type-p">{copy.aboutTimelineText}</p>
        </article>
        <article class="reveal">
          <span>{copy.aboutTimelineLabel4}</span>
          <h3 class="type-h3">{copy.aboutTimelineCardTitle2}</h3>
          <p class="type-p">{copy.aboutTimelineText2}</p>
        </article>
        <article class="reveal">
          <span>2019</span>
          <h3 class="type-h3">{copy.aboutTimelineCardTitle3}</h3>
          <p class="type-p">{copy.aboutTimelineText3}</p>
        </article>
        <article class="reveal">
          <span>{copy.aboutTimelineLabel5}</span>
          <h3 class="type-h3">{copy.aboutTimelineCardTitle4}</h3>
          <p class="type-p">{copy.aboutTimelineText4}</p>
        </article>
      </div>
    </section>
    <section class="about-clients">
      <div>
        <span class="section-label reveal">{copy.aboutClientsLabel}</span>
        <h2 class="reveal type-h2">
          {copy.aboutClientsHeading}
          <br />
          <span>{copy.aboutClientsLabel2}</span>
        </h2>
      </div>
      <div class="client-list reveal">
        <span>{copy.aboutClientsLabel3}</span>
        <span>{copy.aboutClientsLabel4}</span>
        <span>{copy.aboutClientsLabel5}</span>
        <span>{copy.aboutClientsLabel6}</span>
        <span>{copy.aboutClientsLabel7}</span>
        <span>{copy.aboutClientsLabel8}</span>
        <span>{copy.aboutClientsLabel9}</span>
        <span>{copy.aboutClientsLabel10}</span>
      </div>
    </section>
    <section class="cert-preview about-cta">
      <div class="reveal">
        <span class="section-label">{copy.certPreviewLabel}</span>
        <h2 class="type-h2">
          {copy.certPreviewHeading}
          <br />
          <span>{copy.certPreviewLabel2}</span>
        </h2>
      </div>
      <div class="cert-copy reveal">
        <p class="type-p">{copy.certPreviewText}</p>
        <Button variant="tertiary" href={href('#contacts')}>
          {copy.certPreviewLink}
        </Button>
      </div>
    </section>
  </main>
</SiteLayout>
