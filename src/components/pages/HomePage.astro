---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Button from '../ui/Button.astro';
import ArrowIcon from '../ui/ArrowIcon.astro';
import TablerIcon from '../ui/TablerIcon.astro';
import Link from '../ui/Link.astro';
import Tag from '../ui/Tag.astro';
import ResponsiveImage from '../ResponsiveImage.astro';
import BackgroundVideo from '../BackgroundVideo.astro';
import CompanyBenefits from '../CompanyBenefits.astro';
import { withBase, localizedPath } from '../../lib/paths';
import { bindShortWords } from '../../lib/typography';
import { homePageCopy } from '../../data/home-page';
import type { Locale } from '../../data/translations';

interface Props {
  locale: Locale;
  rootAlias?: boolean;
}
const { locale, rootAlias = false } = Astro.props;
const copy = homePageCopy[locale];
const href = (path: string) =>
  path.startsWith('#') || rootAlias ? withBase(path) : localizedPath(path, locale);
const text = (value: string) => bindShortWords(value, locale);
const image = (name: string) => '/assets/images/home/' + name;
const wideSizes =
  '(max-width: 440px) calc(100vw - 48px), (max-width: 800px) calc(100vw - 64px), (max-width: 1280px) calc(100vw - 192px), calc(100vw - 272px)';
const categories = [
  {
    slug: 'veymur',
    title: copy.directionsCardTitle,
    label: copy.directionsLabel4,
    description: copy.directionsText2 + ' ' + copy.directionsLine,
    alt: copy.directionsAriaLabel
  },
  {
    slug: 'substrates',
    title: copy.directionsCardTitle2,
    label: copy.directionsLabel5,
    description: copy.directionsText3 + ' ' + copy.directionsLine2,
    alt: copy.directionsAriaLabel2
  },
  {
    slug: 'fiber',
    title: copy.directionsCardTitle3,
    label: copy.directionsLabel6,
    description: copy.directionsText4 + ' ' + copy.directionsLine3,
    alt: copy.directionsAriaLabel3
  },
  {
    slug: 'shell',
    title: copy.directionsCardTitle4,
    label: copy.directionsLabel7,
    description: copy.directionsText5 + ' ' + copy.directionsLine4,
    alt: copy.directionsAriaLabel4
  }
];
const industries = [
  {
    icon: 'truck-delivery',
    title: copy.homeIndustriesCardTitle,
    description: copy.homeIndustriesText2
  },
  {
    icon: 'building-store',
    title: copy.homeIndustriesCardTitle2,
    description: copy.homeIndustriesText3
  },
  {
    icon: 'tools-kitchen-2',
    title: copy.homeIndustriesCardTitle3,
    description: copy.homeIndustriesText4
  },
  {
    icon: 'droplets',
    title: copy.homeIndustriesCardTitle4,
    description: copy.homeIndustriesText5
  },
  {
    icon: 'seedling',
    title: copy.homeIndustriesCardTitle5,
    description: copy.homeIndustriesText6
  },
  {
    icon: 'tags',
    title: copy.homeIndustriesCardTitle6,
    description: copy.homeIndustriesText7
  },
  {
    icon: 'spray',
    title: copy.homeIndustriesCardTitle7,
    description: copy.homeIndustriesText8
  },
  {
    icon: 'layers-intersect',
    title: copy.homeIndustriesCardTitle9,
    description: copy.homeIndustriesText10
  },
  {
    icon: 'building-factory-2',
    title: copy.homeIndustriesCardTitle10,
    description: copy.homeIndustriesText11
  }
];
const originSteps = [
  { title: copy.originSectionCardTitle, description: copy.originSectionText2 },
  { title: copy.originSectionCardTitle2, description: copy.originSectionText3 },
  { title: copy.originSectionCardTitle3, description: copy.originSectionText4 }
];
const supply = [
  { title: copy.supplySectionCardTitle, description: copy.supplySectionText2 },
  { title: copy.supplySectionCardTitle2, description: copy.supplySectionText3 },
  { title: copy.supplySectionCardTitle3, description: copy.supplySectionText4 },
  { title: copy.supplySectionCardTitle4, description: copy.supplySectionText5 }
];
---

<SiteLayout
  locale={locale}
  path="/"
  title={copy.title}
  description={copy.description}
  image={image('seha-farm.webp')}
  bodyClass="home"
  skipText={copy.skipText}
  skipHref={href('#directions')}
>
  <main class="home-main">
    <section class="home-hero" aria-labelledby="home-title">
      <BackgroundVideo />
      <div class="home-hero-wash" aria-hidden="true"></div>
      <div class="home-hero-copy">
        <h1 id="home-title" class="type-h1">
          {copy.homeHeroTitle} {copy.homeHeroLine}
          <em>
            {copy.homeHeroEmphasis}
            <br />
            {copy.homeHeroLine2}
          </em>
        </h1>
        <p class="type-p">{text(copy.homeHeroText + ' ' + copy.homeHeroLine3)}</p>
        <Button variant="secondary" href={href('/products/')}>
          {copy.homeHeroLink}
        </Button>
      </div>
    </section>
    <section class="home-section home-farm" aria-labelledby="farm-title">
      <div class="section-heading">
        <h2 id="farm-title" class="type-h2">
          {text(copy.farmTitle)}
        </h2>
        <p class="type-p">{text(copy.manufacturingOrigin + ' ' + copy.farmText)}</p>
      </div>
      <ResponsiveImage
        src={image('seha-farm.webp')}
        alt={copy.farmAlt}
        sizes={wideSizes}
        loading="lazy"
      />
    </section>
    <CompanyBenefits locale={locale} />
    <section class="home-section directions" id="directions" aria-labelledby="directions-title">
      <div class="section-heading">
        <h2 id="directions-title" class="type-h2">
          {copy.directionsHeading}
          <br />
          {copy.directionsLabel3}
        </h2>
        <p class="type-p">{text(copy.directionsText)}</p>
      </div>
      <div class="product-direction-grid">
        {categories.map((category) => (
          <a class="product-direction-card reveal" href={href('/products/' + category.slug + '/')}>
            <div class="material-photo">
              <ResponsiveImage
                src={image(
                  'category-' + (category.slug === 'veymur' ? 'food' : category.slug) + '.png'
                )}
                alt={category.alt}
                sizes="(max-width: 440px) calc(100vw - 48px), (max-width: 800px) calc((100vw - 88px) / 2), (max-width: 1280px) calc((100vw - 216px) / 2), (max-width: 1872px) calc((100vw - 468px) / 2), 702px"
                loading="lazy"
              />
              <span class="card-index">{category.label}</span>
              <span class="card-go" aria-hidden="true">
                <ArrowIcon direction="up-right" />
              </span>
            </div>
            <div class="product-direction-copy">
              <h3 class="type-h3">{category.title}</h3>
              <p class="type-p">{text(category.description)}</p>
            </div>
          </a>
        ))}
      </div>
      <Link variant="text" class="text-link" href={href('/products/')}>
        {copy.directionsLink}
        <ArrowIcon direction="up-right" size={18} />
      </Link>
    </section>
    <section class="home-industries" aria-labelledby="industries-title">
      <div class="industries-heading">
        <div>
          <h2 id="industries-title" class="type-h2">
            {copy.homeIndustriesHeading}
            <br />
            <span>{copy.homeIndustriesLabel2}</span>
          </h2>
          <p class="type-p">{text(copy.homeIndustriesText)}</p>
        </div>
        <div class="industry-controls" aria-label={copy.homeIndustriesAriaLabel}>
          <button
            class="industry-arrow"
            type="button"
            data-industry-prev
            disabled
            aria-label={copy.homeIndustriesAriaLabel2}
            aria-controls="industry-track"
          >
            <ArrowIcon direction="left" size={30} />
          </button>
          <button
            class="industry-arrow"
            type="button"
            data-industry-next
            disabled
            aria-label={copy.homeIndustriesAriaLabel3}
            aria-controls="industry-track"
          >
            <ArrowIcon direction="right" size={30} />
          </button>
        </div>
      </div>
      <div
        id="industry-track"
        class="industry-track"
        role="region"
        tabindex="0"
        aria-label={copy.homeIndustriesAriaLabel4}
      >
        <div class="industry-rail">
          {industries.map((industry, index) => (
            <article class="industry-card">
              <span class="industry-index">{index + 1}</span>
              <div class="industry-icon">
                <TablerIcon name={industry.icon} size={36} />
              </div>
              <h3 class="type-h3">{industry.title}</h3>
              <p class="type-p">{text(industry.description)}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
    <section class="ingredient-match" aria-labelledby="ingredient-title">
      <div class="ingredient-copy">
        <h2 id="ingredient-title" class="type-h2">
          {copy.ingredientMatchHeading}
        </h2>
        <p class="type-p">{text(copy.ingredientMatchText)}</p>
        <div class="ingredient-points">
          {[
            copy.ingredientMatchLabel2,
            copy.ingredientMatchLabel3,
            copy.ingredientMatchLabel4,
            copy.ingredientMatchLabel5,
            copy.ingredientMatchLabel6
          ].map((label) => (
            <Tag>{label}</Tag>
          ))}
        </div>
      </div>
      <Button class="ingredient-action" href={href('#contacts')}>
        {copy.ingredientMatchLabel7}
      </Button>
    </section>
    <section class="origin-section" id="origin" aria-labelledby="origin-title">
      <div class="origin-image">
        <ResponsiveImage
          src="/assets/images/shared/plantation-palms.webp"
          class="origin-image__base"
          alt={copy.originSectionAlt}
          sizes={wideSizes}
          loading="lazy"
        />
        <span>
          {copy.originSectionLabel}
          <br />
          {copy.originSectionLine}
        </span>
      </div>
      <div class="origin-copy">
        <h2 id="origin-title" class="type-h2">
          {copy.originSectionHeading}
          <br />
          <span>{copy.originSectionLabel3}</span>
        </h2>
        <p class="origin-intro type-p">{text(copy.originSectionText)}</p>
        {originSteps.map((step, index) => (
          <div class="origin-step">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="type-h3">{step.title}</h3>
              <p class="type-p">{text(step.description)}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
    <section class="material-banner" aria-labelledby="material-title">
      <BackgroundVideo />
      <div class="material-banner__copy">
        <span class="material-banner__label">{copy.materialBannerLabel}</span>
        <h2 id="material-title" class="type-h2">
          {text(copy.materialBannerTitle)}
        </h2>
        <p class="type-p">{text(copy.materialBannerText)}</p>
        <Button href={href('/production/')} variant="secondary" compact>
          {copy.materialBannerLink}
          <ArrowIcon direction="right" size={20} />
        </Button>
      </div>
      <dl class="material-banner__stats">
        <div>
          <dt>{copy.materialBannerExperience}</dt>
          <dd>40+</dd>
        </div>
        <div>
          <dt>{copy.materialBannerCountries}</dt>
          <dd>25+</dd>
        </div>
      </dl>
    </section>
    <section class="home-section supply-section" id="supply" aria-labelledby="supply-title">
      <div class="section-heading">
        <h2 id="supply-title" class="type-h2">
          {copy.supplySectionHeading}
          <br />
          <span>{copy.supplySectionLabel2}</span>
        </h2>
        <p class="type-p">
          {text(
            copy.supplySectionText + ' ' + copy.supplySectionLine + ' ' + copy.supplySectionLine2
          )}
        </p>
      </div>
      <ol class="supply-grid">
        {supply.map((step, index) => (
          <li>
            <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="type-h3">{step.title}</h3>
            <p class="type-p">{text(step.description)}</p>
          </li>
        ))}
      </ol>
    </section>
  </main>
</SiteLayout>
