---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Button from '../ui/Button.astro';
import Link from '../ui/Link.astro';
import Tag from '../ui/Tag.astro';
import { withBase, localizedPath } from '../../lib/paths';
import { homePageCopy } from '../../data/home-page';
import type { Locale } from '../../data/translations';

interface Props {
  locale: Locale;
  rootAlias?: boolean;
}
const { locale, rootAlias = false } = Astro.props;
const copy = homePageCopy[locale];
const path = '/';
const href = (path: string) =>
  path.startsWith('#') || rootAlias ? withBase(path) : localizedPath(path, locale);
---

<SiteLayout
  locale={locale}
  path={path}
  title={copy.title}
  description={copy.description}
  bodyClass="home"
  skipText={copy.skipText}
  skipHref={href('#directions')}
>
  <main>
    <section class="home-hero" aria-labelledby="home-title">
      <img
        src={withBase('/assets/images/common/home-coconut.webp')}
        class="home-hero-photo"
        width="1536"
        height="1024"
        alt={copy.homeHeroAlt}
        fetchpriority="high"
      />
      <div class="home-hero-wash"></div>
      <div class="hero-topline">
        <span>{copy.homeHeroLabel}</span>
        <span>{copy.homeHeroLabel2}</span>
      </div>
      <div class="home-hero-copy">
        <h1 id="home-title" class="type-h1">
          {copy.homeHeroTitle}
          <br />
          {copy.homeHeroLine}
          <br />
          <em>
            {copy.homeHeroEmphasis}
            <br />
            {copy.homeHeroLine2}
          </em>
        </h1>
        <p class="type-p">
          {copy.homeHeroText}
          <br class="desktop-only" />
          {copy.homeHeroLine3}
        </p>
        <Button variant="secondary" href={href('/products')}>
          {copy.homeHeroLink} <span>↗</span>
        </Button>
      </div>
      <div class="hero-foot">
        <span>
          {copy.homeHeroLabel3}
          <br />
          {copy.homeHeroLine4}
        </span>
        <a href={href('#directions')} class="hero-scroll" aria-label={copy.homeHeroAriaLabel}>
          ↓
        </a>
        <span>
          {copy.homeHeroLabel4}
          <br />
          {copy.homeHeroLine5}
        </span>
      </div>
    </section>
    <section class="home-section directions" id="directions">
      <div class="section-top reveal">
        <span class="section-label">{copy.directionsLabel}</span>
        <span class="section-note">{copy.directionsLabel2}</span>
      </div>
      <div class="section-heading reveal">
        <h2 class="type-h2">
          {copy.directionsHeading}
          <br />
          <span>{copy.directionsLabel3}</span>
        </h2>
        <p class="type-p">{copy.directionsText}</p>
      </div>
      <div class="product-direction-grid">
        <a class="product-direction-card reveal" href={href('/products/food/')}>
          <div class="material-photo food-photo" role="img" aria-label={copy.directionsAriaLabel}>
            <span class="card-index">{copy.directionsLabel4}</span>
            <span class="card-go">↗</span>
          </div>
          <div class="product-direction-copy">
            <h3 class="type-h3">{copy.directionsCardTitle}</h3>
            <p class="type-p">
              {copy.directionsText2}
              <br />
              {copy.directionsLine}
            </p>
          </div>
        </a>
        <a class="product-direction-card reveal" href={href('/products/substrates/')}>
          <div class="material-photo peat-photo" role="img" aria-label={copy.directionsAriaLabel2}>
            <span class="card-index">{copy.directionsLabel5}</span>
            <span class="card-go">↗</span>
          </div>
          <div class="product-direction-copy">
            <h3 class="type-h3">{copy.directionsCardTitle2}</h3>
            <p class="type-p">
              {copy.directionsText3}
              <br />
              {copy.directionsLine2}
            </p>
          </div>
        </a>
        <a class="product-direction-card reveal" href={href('/products/fiber/')}>
          <div class="material-photo fiber-photo" role="img" aria-label={copy.directionsAriaLabel3}>
            <span class="card-index">{copy.directionsLabel6}</span>
            <span class="card-go">↗</span>
          </div>
          <div class="product-direction-copy">
            <h3 class="type-h3">{copy.directionsCardTitle3}</h3>
            <p class="type-p">
              {copy.directionsText4}
              <br />
              {copy.directionsLine3}
            </p>
          </div>
        </a>
        <a class="product-direction-card reveal" href={href('/products/shell/')}>
          <div class="material-photo shell-photo" role="img" aria-label={copy.directionsAriaLabel4}>
            <span class="card-index">{copy.directionsLabel7}</span>
            <span class="card-go">↗</span>
          </div>
          <div class="product-direction-copy">
            <h3 class="type-h3">{copy.directionsCardTitle4}</h3>
            <p class="type-p">
              {copy.directionsText5}
              <br />
              {copy.directionsLine4}
            </p>
          </div>
        </a>
      </div>
      <Link variant="text" class="text-link reveal" href={href('/products')}>
        {copy.directionsLink} <span>↗</span>
      </Link>
    </section>
    <section class="home-industries" aria-labelledby="industries-title">
      <div class="industries-heading reveal">
        <span class="section-label">{copy.homeIndustriesLabel}</span>
        <h2 id="industries-title" class="type-h2">
          {copy.homeIndustriesHeading}
          <br />
          <span>{copy.homeIndustriesLabel2}</span>
        </h2>
        <p class="type-p">{copy.homeIndustriesText}</p>
        <div class="industry-controls" aria-label={copy.homeIndustriesAriaLabel}>
          <button
            class="industry-arrow"
            type="button"
            data-industry-prev
            aria-label={copy.homeIndustriesAriaLabel2}
          >
            ←
          </button>
          <button
            class="industry-arrow"
            type="button"
            data-industry-next
            aria-label={copy.homeIndustriesAriaLabel3}
          >
            →
          </button>
        </div>
      </div>
      <div
        class="industry-track"
        role="region"
        tabindex="0"
        aria-label={copy.homeIndustriesAriaLabel4}
      >
        <article class="industry-card reveal">
          <span>001</span>
          <div class="industry-icon" aria-hidden="true">
            <svg
              viewBox="0 0 48 48"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M13 18h14v12H13z" />
              <path d="M27 22h7l4 5v3H27z" />
              <path d="M16 34a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" />
              <path d="M34 34a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" />
              <path d="M17 14h12" />
            </svg>
          </div>
          <h3 class="type-h3">{copy.homeIndustriesCardTitle}</h3>
          <p class="type-p">{copy.homeIndustriesText2}</p>
        </article>
        <article class="industry-card reveal">
          <span>002</span>
          <div class="industry-icon" aria-hidden="true">
            <svg
              viewBox="0 0 48 48"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M14 18h20l-2 18H16z" />
              <path d="M18 18a6 6 0 0 1 12 0" />
              <path d="M18 28h12" />
              <path d="M21 34h6" />
            </svg>
          </div>
          <h3 class="type-h3">{copy.homeIndustriesCardTitle2}</h3>
          <p class="type-p">{copy.homeIndustriesText3}</p>
        </article>
        <article class="industry-card reveal">
          <span>003</span>
          <div class="industry-icon" aria-hidden="true">
            <svg
              viewBox="0 0 48 48"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 31h24" />
              <path d="M16 31V19h16v12" />
              <path d="M20 19v-5h8v5" />
              <path d="M18 37h12" />
              <path d="M33 24h4v7" />
            </svg>
          </div>
          <h3 class="type-h3">{copy.homeIndustriesCardTitle3}</h3>
          <p class="type-p">{copy.homeIndustriesText4}</p>
        </article>
        <article class="industry-card reveal">
          <span>004</span>
          <div class="industry-icon" aria-hidden="true">
            <svg
              viewBox="0 0 48 48"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M24 36V20" />
              <path d="M24 24c-7 0-10-4-10-9 7 0 10 4 10 9Z" />
              <path d="M24 28c7 0 10-4 10-9-7 0-10 4-10 9Z" />
              <path d="M12 38h24" />
              <path d="M15 32h18" />
            </svg>
          </div>
          <h3 class="type-h3">{copy.homeIndustriesCardTitle4}</h3>
          <p class="type-p">{copy.homeIndustriesText5}</p>
        </article>
        <article class="industry-card reveal">
          <span>005</span>
          <div class="industry-icon" aria-hidden="true">
            <svg
              viewBox="0 0 48 48"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M14 35h20" />
              <path d="M18 35V21" />
              <path d="M30 35V21" />
              <path d="M18 24c-5 0-7-3-7-7 5 0 7 3 7 7Z" />
              <path d="M30 24c5 0 7-3 7-7-5 0-7 3-7 7Z" />
              <path d="M24 35V16" />
            </svg>
          </div>
          <h3 class="type-h3">{copy.homeIndustriesCardTitle5}</h3>
          <p class="type-p">{copy.homeIndustriesText6}</p>
        </article>
        <article class="industry-card reveal">
          <span>006</span>
          <div class="industry-icon" aria-hidden="true">
            <svg
              viewBox="0 0 48 48"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M15 17h18v24H15z" />
              <path d="M19 13h10v4H19z" />
              <path d="M19 25h10" />
              <path d="M19 31h7" />
              <path d="M31 36l4 4 6-8" />
            </svg>
          </div>
          <h3 class="type-h3">{copy.homeIndustriesCardTitle6}</h3>
          <p class="type-p">{copy.homeIndustriesText7}</p>
        </article>
        <article class="industry-card reveal">
          <span>007</span>
          <div class="industry-icon" aria-hidden="true">
            <svg
              viewBox="0 0 48 48"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M18 19h12" />
              <path d="M20 19v-6h8v6" />
              <path d="M16 23h16l3 16H13z" />
              <path d="M20 29c2 2 6 2 8 0" />
              <path d="M22 35h4" />
            </svg>
          </div>
          <h3 class="type-h3">{copy.homeIndustriesCardTitle7}</h3>
          <p class="type-p">{copy.homeIndustriesText8}</p>
        </article>
        <article class="industry-card reveal">
          <span>008</span>
          <div class="industry-icon" aria-hidden="true">
            <svg
              viewBox="0 0 48 48"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M19 13h10" />
              <path d="M21 13v10l-7 12a5 5 0 0 0 4 8h12a5 5 0 0 0 4-8l-7-12V13" />
              <path d="M18 34h12" />
              <path d="M22 39h4" />
            </svg>
          </div>
          <h3 class="type-h3">{copy.homeIndustriesCardTitle8}</h3>
          <p class="type-p">{copy.homeIndustriesText9}</p>
        </article>
        <article class="industry-card reveal">
          <span>009</span>
          <div class="industry-icon" aria-hidden="true">
            <svg
              viewBox="0 0 48 48"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M14 16c8 0 16 6 20 16" />
              <path d="M14 24c7 0 13 4 17 10" />
              <path d="M14 32h22" />
              <path d="M14 38h18" />
              <path d="M14 16v22" />
            </svg>
          </div>
          <h3 class="type-h3">{copy.homeIndustriesCardTitle9}</h3>
          <p class="type-p">{copy.homeIndustriesText10}</p>
        </article>
        <article class="industry-card reveal">
          <span>010</span>
          <div class="industry-icon" aria-hidden="true">
            <svg
              viewBox="0 0 48 48"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M13 17h22v22H13z" />
              <path d="M18 17v-4h12v4" />
              <path d="M18 25h12" />
              <path d="M18 31h8" />
              <path d="M32 32h5l-3 5" />
            </svg>
          </div>
          <h3 class="type-h3">{copy.homeIndustriesCardTitle10}</h3>
          <p class="type-p">{copy.homeIndustriesText11}</p>
        </article>
      </div>
    </section>
    <section class="ingredient-match" aria-labelledby="ingredient-title">
      <div class="ingredient-copy reveal">
        <span class="section-label">{copy.ingredientMatchLabel}</span>
        <h2 id="ingredient-title" class="type-h2">
          {copy.ingredientMatchHeading}
        </h2>
        <p class="type-p">{copy.ingredientMatchText}</p>
        <div class="ingredient-points">
          <Tag>{copy.ingredientMatchLabel2}</Tag>
          <Tag>{copy.ingredientMatchLabel3}</Tag>
          <Tag>{copy.ingredientMatchLabel4}</Tag>
          <Tag>{copy.ingredientMatchLabel5}</Tag>
          <Tag>{copy.ingredientMatchLabel6}</Tag>
        </div>
      </div>
      <a class="ingredient-action reveal" href={href('#contacts')}>
        <span>{copy.ingredientMatchLabel7}</span>
        <b aria-hidden="true">↗</b>
      </a>
    </section>
    <section class="origin-section" id="origin">
      <div class="origin-image">
        <img
          src={withBase('/assets/images/common/home-coconut.webp')}
          alt={copy.originSectionAlt}
          width="1536"
          height="1024"
          loading="lazy"
        />
        <span>
          {copy.originSectionLabel}
          <br />
          {copy.originSectionLine}
        </span>
      </div>
      <div class="origin-copy">
        <span class="section-label reveal">{copy.originSectionLabel2}</span>
        <h2 class="reveal type-h2">
          {copy.originSectionHeading}
          <br />
          <span>{copy.originSectionLabel3}</span>
        </h2>
        <p class="origin-intro reveal type-p">{copy.originSectionText}</p>
        <div class="origin-step reveal">
          <span>01</span>
          <div>
            <h3 class="type-h3">{copy.originSectionCardTitle}</h3>
            <p class="type-p">{copy.originSectionText2}</p>
          </div>
        </div>
        <div class="origin-step reveal">
          <span>02</span>
          <div>
            <h3 class="type-h3">{copy.originSectionCardTitle2}</h3>
            <p class="type-p">{copy.originSectionText3}</p>
          </div>
        </div>
        <div class="origin-step reveal">
          <span>03</span>
          <div>
            <h3 class="type-h3">{copy.originSectionCardTitle3}</h3>
            <p class="type-p">{copy.originSectionText4}</p>
          </div>
        </div>
      </div>
    </section>
    <section class="home-section quality-section" id="quality">
      <div class="section-top reveal">
        <span class="section-label">{copy.qualitySectionLabel}</span>
        <span class="section-note">{copy.qualitySectionLabel2}</span>
      </div>
      <div class="section-heading reveal">
        <h2 class="type-h2">
          {copy.qualitySectionHeading}
          <br />
          <span>{copy.qualitySectionLabel3}</span>
        </h2>
        <p class="type-p">
          {copy.qualitySectionText}
          <br />
          {copy.qualitySectionLine}
          <br />
          {copy.qualitySectionLine2}
        </p>
      </div>
      <div class="quality-grid">
        <article class="reveal">
          <span class="quality-index">01</span>
          <h3 class="type-h3">{copy.qualitySectionCardTitle}</h3>
          <p class="type-p">{copy.qualitySectionText2}</p>
        </article>
        <article class="reveal">
          <span class="quality-index">02</span>
          <h3 class="type-h3">{copy.qualitySectionCardTitle2}</h3>
          <p class="type-p">{copy.qualitySectionText3}</p>
        </article>
        <article class="reveal">
          <span class="quality-index">03</span>
          <h3 class="type-h3">{copy.qualitySectionCardTitle3}</h3>
          <p class="type-p">{copy.qualitySectionText4}</p>
        </article>
      </div>
      <Link variant="text" href={href('/quality')} class="text-link reveal">
        {copy.qualitySectionLink} <span>↗</span>
      </Link>
    </section>
    <section class="material-banner">
      <img
        src={withBase('/assets/images/common/home-coconut.webp')}
        alt={copy.materialBannerAlt}
        loading="lazy"
        width="1536"
        height="1024"
      />
      <div>
        <span class="section-label reveal">{copy.materialBannerLabel}</span>
        <p class="reveal type-p">
          {copy.materialBannerText}
          <br />
          <em>{copy.materialBannerEmphasis}</em>
        </p>
      </div>
    </section>
    <section class="home-section supply-section" id="supply">
      <div class="section-top reveal">
        <span class="section-label">{copy.supplySectionLabel}</span>
      </div>
      <div class="section-heading reveal">
        <h2 class="type-h2">
          {copy.supplySectionHeading}
          <br />
          <span>{copy.supplySectionLabel2}</span>
        </h2>
        <p class="type-p">
          {copy.supplySectionText}
          <br />
          {copy.supplySectionLine}
          <br />
          {copy.supplySectionLine2}
        </p>
      </div>
      <ol class="supply-grid">
        <li class="reveal">
          <span>01</span>
          <h3 class="type-h3">{copy.supplySectionCardTitle}</h3>
          <p class="type-p">{copy.supplySectionText2}</p>
        </li>
        <li class="reveal">
          <span>02</span>
          <h3 class="type-h3">{copy.supplySectionCardTitle2}</h3>
          <p class="type-p">{copy.supplySectionText3}</p>
        </li>
        <li class="reveal">
          <span>03</span>
          <h3 class="type-h3">{copy.supplySectionCardTitle3}</h3>
          <p class="type-p">{copy.supplySectionText4}</p>
        </li>
        <li class="reveal">
          <span>04</span>
          <h3 class="type-h3">{copy.supplySectionCardTitle4}</h3>
          <p class="type-p">{copy.supplySectionText5}</p>
        </li>
      </ol>
    </section>
  </main>
</SiteLayout>
