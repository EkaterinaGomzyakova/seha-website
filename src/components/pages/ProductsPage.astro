---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ResponsiveImage from '../ResponsiveImage.astro';
import ArrowCircle from '../ui/ArrowCircle.astro';
import { withBase, localizedPath } from '../../lib/paths';
import { bindShortWords } from '../../lib/typography';
import { productsPageCopy } from '../../data/products-page';
import { productCategories } from '../../data/products';
import { productPages } from '../../data/product-category-pages';
import type { Locale } from '../../data/translations';

interface Props {
  locale: Locale;
  rootAlias?: boolean;
}
const { locale, rootAlias = false } = Astro.props;
const copy = productsPageCopy[locale];
const heroImage = '/assets/images/products/coconut-products.png';
const href = (path: string) =>
  path.startsWith('#') || rootAlias ? withBase(path) : localizedPath(path, locale);
---

<SiteLayout
  locale={locale}
  path="/products"
  title={copy.title}
  description={copy.description}
  image={heroImage}
  bodyClass="product-overview page-product-category"
  skipText={copy.skipText}
  skipHref="#catalog"
  footerVariant="product-overview"
>
  <nav class="breadcrumbs" aria-label={copy.pageAriaLabel}>
    <a href={href('/')}>{copy.pageLink}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{copy.pageLabel}</span>
  </nav>
  <main id="main-content" tabindex="-1">
    <section class="overview-hero" aria-labelledby="title">
      <ResponsiveImage
        src={heroImage}
        alt={copy.heroAlt}
        class="overview-hero__image"
        sizes="(max-width: 440px) 900px, (max-width: 800px) 1200px, (max-width: 1280px) 1440px, 1500px"
        fetchpriority="high"
      />
      <div class="overview-hero__shade" aria-hidden="true"></div>
      <div class="overview-hero__content">
        <h1 id="title" class="type-h1">
          {copy.heroTitle}
          <br />
          {copy.heroLabel}
        </h1>
        <p class="type-p">
          {bindShortWords(copy.heroText, locale)}
          <br />
          {bindShortWords(copy.heroLine, locale)}
        </p>
      </div>
    </section>
    <section class="products-catalog" id="catalog" aria-label={copy.catalogTitle}>
      <div class="products-list" id="products-list">
        {productCategories.map((category, index) => {
          const definition = productPages[category.slug];
          return (
            <a class="product-category" href={href(`/products/${category.slug}/`)}>
              <div class="category-image-frame product-category-image">
                <ResponsiveImage
                  src={definition.heroImage}
                  alt=""
                  sizes="(max-width: 440px) 64px, 94px"
                  loading="lazy"
                />
              </div>
              <span class="product-category-number" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <div class="product-category-title">
                <span>{bindShortWords(definition.listLabel[locale], locale)}</span>
                <h2 class="type-h2">{bindShortWords(category.title[locale], locale)}</h2>
              </div>
              <p class="type-p">{bindShortWords(category.description[locale], locale)}</p>
              <ArrowCircle class="product-category-arrow" />
            </a>
          );
        })}
      </div>
    </section>
  </main>
</SiteLayout>
