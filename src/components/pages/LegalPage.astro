---
import Breadcrumbs from '../Breadcrumbs.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Link from '../ui/Link.astro';
import { withBase, localizedPath } from '../../lib/paths';
import {
  legalDocuments,
  legalPaths,
  legalVersion,
  type LegalKind
} from '../../data/legal-documents';
import { getInterfaceCopy } from '../../data/interface-copy';
import type { Locale } from '../../data/translations';
interface Props {
  locale: Locale;
  kind: LegalKind;
  rootAlias?: boolean;
}
const { locale, kind, rootAlias = false } = Astro.props;
const copy = legalDocuments[locale][kind];
const ui = getInterfaceCopy(locale);
---

<SiteLayout
  locale={locale}
  path={legalPaths[kind]}
  title={`${copy.title} — ${locale === 'ru' ? 'СЕХА' : 'SEHA'}`}
  description={copy.intro}
  bodyClass="privacy-page"
  skipText={locale === 'ru' ? 'К содержанию' : 'Skip to content'}
  skipHref="#legal-content"
>
  <Breadcrumbs
    locale={locale}
    items={[
      { label: ui.home, href: rootAlias ? withBase('/') : localizedPath('/', locale) },
      { label: copy.title }
    ]}
  />
  <main id="legal-content">
    <section class="legal-hero" aria-labelledby="legal-title">
      <div class="legal-hero__content">
        <h1 id="legal-title" class="type-h1">
          {copy.title}
        </h1>
        <div>
          <p class="type-p">{copy.intro}</p>
          <div class="privacy-tags">
            <span class="type-button">
              {locale === 'ru'
                ? `Редакция от ${legalVersion.split('-').reverse().join('.')}`
                : `Version ${legalVersion}`}
            </span>
          </div>
        </div>
      </div>
    </section>
    <div class="privacy-content legal-document">
      {kind === 'inquiry' && (
        <nav
          class="legal-links legal-contents"
          aria-label={locale === 'ru' ? 'Разделы согласия' : 'Consent sections'}
        >
          <Link href="#inquiry">{locale === 'ru' ? 'Обработка заявки' : 'Inquiry processing'}</Link>
          <Link href="#analytics">{ui.analyticsConsent}</Link>
        </nav>
      )}
      {copy.sections.map((section) => (
        <section id={section.id} class:list={['privacy-section', { 'privacy-wide': section.wide }]}>
          <h2 class="type-h3">{section.title}</h2>
          {section.paragraphs.map((paragraph) => (
            <p class="type-p">{paragraph}</p>
          ))}
          {section.items && (
            <ul class="legal-list">
              {section.items.map((item) => (
                <li class="type-p">{item}</li>
              ))}
            </ul>
          )}
          {section.links && (
            <ul class="legal-links">
              {section.links.map((link) => (
                <li class="type-p">
                  <Link href={link.href}>
                    {link.label.split(' / ')[locale === 'ru' ? 0 : 1] || link.label}
                  </Link>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))}
      <nav
        class="privacy-section privacy-wide legal-links"
        aria-label={locale === 'ru' ? 'Документы о персональных данных' : 'Personal data documents'}
      >
        {(['policy', 'inquiry'] as LegalKind[])
          .filter((item) => item !== kind)
          .map((item) => (
            <Link href={localizedPath(legalPaths[item], locale)}>
              {legalDocuments[locale][item].title}
            </Link>
          ))}
        <button id="analytics-settings" type="button" class="type-button" data-analytics-settings>
          {ui.analyticsSettings}
        </button>
      </nav>
    </div>
  </main>
</SiteLayout>
