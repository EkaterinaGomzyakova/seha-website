---
import PageHero from '../PageHero.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Link from '../ui/Link.astro';
import Tag from '../ui/Tag.astro';
import { withBase, localizedPath } from '../../lib/paths';
import {
  legalDocuments,
  legalPaths,
  legalVersion,
  type LegalKind
} from '../../data/legal-documents';
import { getInterfaceCopy } from '../../data/interface-copy';
import type { Locale } from '../../data/translations';
interface Props {
  locale: Locale;
  kind: LegalKind;
  rootAlias?: boolean;
}
const { locale, kind, rootAlias = false } = Astro.props;
const copy = legalDocuments[locale][kind];
const ui = getInterfaceCopy(locale);
---

<SiteLayout
  locale={locale}
  path={legalPaths[kind]}
  title={`${copy.title} — ${locale === 'ru' ? 'СЕХА' : 'SEHA'}`}
  description={copy.intro}
  bodyClass="privacy-page"
  skipText={locale === 'ru' ? 'К содержанию' : 'Skip to content'}
  skipHref="#legal-content"
>
  <Breadcrumbs
    locale={locale}
    items={[
      { label: ui.home, href: rootAlias ? withBase('/') : localizedPath('/', locale) },
      { label: copy.title }
    ]}
  />
  <main id="legal-content">
    <PageHero titleId="legal-title">
      <Fragment slot="heading">{copy.title}</Fragment>
      <Fragment slot="description">{copy.intro}</Fragment>
      <div slot="details" class="privacy-tags">
        <Tag>{locale === 'ru' ? 'Редакция от 16.11.2026' : `Version ${legalVersion}`}</Tag>
      </div>
    </PageHero>
    <div class="privacy-content legal-document">
      {copy.sections.map((section) => (
        <section class="privacy-section">
          <h2 class="type-h3">{section.title}</h2>
          {section.paragraphs.map((paragraph) => (
            <p class="type-p">{paragraph}</p>
          ))}
          {section.links && (
            <ul class="legal-links">
              {section.links.map((link) => (
                <li class="type-p">
                  <Link href={link.href}>
                    {link.label.split(' / ')[locale === 'ru' ? 0 : 1] || link.label}
                  </Link>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))}
      <nav
        class="privacy-section legal-links"
        aria-label={locale === 'ru' ? 'Документы о персональных данных' : 'Personal data documents'}
      >
        {(['policy', 'inquiry', 'analytics'] as LegalKind[])
          .filter((item) => item !== kind)
          .map((item) => (
            <Link href={localizedPath(legalPaths[item], locale)}>
              {legalDocuments[locale][item].title}
            </Link>
          ))}
        <button type="button" class="type-button" data-analytics-settings>
          {ui.analyticsSettings}
        </button>
      </nav>
    </div>
  </main>
</SiteLayout>
