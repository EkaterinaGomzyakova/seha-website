---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Button from '../ui/Button.astro';
import HeaderContainer from '../ui/HeaderContainer.astro';
import CertificationLogos from '../CertificationLogos.astro';
import ResponsiveImage from '../ResponsiveImage.astro';
import { withBase, localizedPath } from '../../lib/paths';
import { qualityPageCopy } from '../../data/quality-page';
import type { Locale } from '../../data/translations';

interface Props {
  locale: Locale;
  rootAlias?: boolean;
}
const { locale, rootAlias = false } = Astro.props;
const copy = qualityPageCopy[locale];
const href = (path: string) =>
  path.startsWith('#') || rootAlias ? withBase(path) : localizedPath(path, locale);
const standards = [
  {
    label: 'ORGANIC',
    title: copy.qualityMapCardTitle,
    text: copy.qualityMapText2,
    summary: 'USDA · EU Organic · NPOP',
    kind: 'organic'
  },
  {
    label: 'FOOD SAFETY',
    title: copy.qualityMapCardTitle2,
    text: copy.qualityMapText3,
    summary: 'BRCGS · HACCP · FSSC 22000',
    kind: 'food'
  },
  {
    label: 'ETHICAL SUPPLY',
    title: 'Fairtrade',
    text: copy.qualityMapText4,
    summary: 'FAIRTRADE CERTIFIED',
    kind: 'ethical'
  }
] as const;
const checks = [
  [copy.qualityProofCardTitle, copy.qualityProofText],
  [copy.qualityProofCardTitle2, copy.qualityProofText2],
  [copy.qualityProofCardTitle3, copy.qualityProofText3],
  [copy.qualityProofCardTitle4, copy.qualityProofText4]
];
const documents = [
  [copy.documentsSectionCardTitle, copy.documentsSectionText2],
  [copy.documentsSectionCardTitle2, copy.documentsSectionText3],
  [copy.documentsSectionCardTitle3, copy.documentsSectionText4],
  [copy.documentsSectionCardTitle4, copy.documentsSectionText5]
];
const photoSizes =
  '(max-width: 440px) calc(100vw - 48px), (max-width: 800px) calc(100vw - 64px), (max-width: 1280px) calc((100vw - 216px) / 2), calc((100vw - 296px) / 2)';
---

<SiteLayout
  locale={locale}
  path="/quality"
  title={copy.title}
  description={copy.description}
  bodyClass="quality"
  skipText={copy.skipText}
  skipHref="#main-content"
  image="/assets/images/quality/quality-hero.png"
>
  <nav class="breadcrumbs" aria-label={copy.pageAriaLabel}>
    <a href={href('/')}>{copy.pageLink}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{copy.pageLabel}</span>
  </nav>
  <main id="main-content" class="quality-main">
    <section class="quality-hero" aria-labelledby="quality-title">
      <div class="quality-hero-copy">
        <h1 id="quality-title" class="type-h1">
          {copy.qualityHeroTitle}
          <br />
          <em>{copy.qualityHeroEmphasis}</em>
        </h1>
        <p class="type-p">{copy.qualityHeroText}</p>
      </div>
      <figure class="quality-hero-card">
        <ResponsiveImage
          src="/assets/images/quality/quality-hero.png"
          alt={copy.qualityHeroAlt}
          sizes={photoSizes}
          loading="eager"
          fetchpriority="high"
          class="quality-hero-photo"
        />
        <ResponsiveImage
          src="/assets/images/quality/quality-hero-gradient.png"
          alt=""
          sizes={photoSizes}
          loading="eager"
          class="quality-hero-gradient"
        />
      </figure>
    </section>
    <section
      class="quality-standards quality-inset"
      id="standards"
      aria-labelledby="standards-title"
    >
      <div class="quality-section-heading">
        <h2 id="standards-title" class="quality-display-title">
          {copy.qualityMapHeading}
          <br />
          <span>{copy.qualityMapLabel3}</span>
        </h2>
        <p class="type-p">{copy.qualityMapText}</p>
      </div>
      <div class="standards-grid">
        {standards.map((standard) => (
          <article
            class:list={['standard-card', standard.kind === 'food' && 'standard-card--dark']}
          >
            <span class="type-button">{standard.label}</span>
            <h3>{standard.title}</h3>
            <p class="type-p">{standard.text}</p>
            <div class="standard-card__credentials">
              <b>{standard.summary}</b>
              <CertificationLogos kind={standard.kind} />
            </div>
          </article>
        ))}
      </div>
    </section>
    <section class="quality-proof" aria-labelledby="proof-title">
      <div class="quality-proof-image">
        <ResponsiveImage
          src="/assets/images/quality/batch-control-base.png"
          alt=""
          sizes={photoSizes}
          loading="lazy"
          class="quality-proof-base"
        />
        <ResponsiveImage
          src="/assets/images/quality/batch-control.png"
          alt={copy.qualityProofAlt}
          sizes={photoSizes}
          loading="lazy"
          class="quality-proof-photo"
        />
      </div>
      <div class="quality-proof-copy">
        <HeaderContainer tone="green">{copy.qualityProofLabel}</HeaderContainer>
        <h2 id="proof-title" class="type-h2">
          {copy.qualityProofHeading}
          <br />
          <span>{copy.qualityProofLabel2}</span>
        </h2>
        <div class="quality-proof-list">
          {checks.map(([title, text], index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
    <section
      class="quality-documents quality-inset"
      id="documents"
      aria-labelledby="documents-title"
    >
      <div class="quality-section-heading">
        <h2 id="documents-title" class="type-h2">
          {copy.documentsSectionHeading}
          <br />
          <span>{copy.documentsSectionLabel3}</span>
        </h2>
        <p class="type-p">{copy.documentsSectionText}</p>
      </div>
      <div class="quality-document-grid">
        {documents.map(([title, text], index) => (
          <article>
            <span class="type-button">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="type-h3">{title}</h3>
            <p class="type-p">{text}</p>
          </article>
        ))}
      </div>
    </section>
    <section class="quality-role quality-inset" aria-labelledby="role-title">
      <div>
        <HeaderContainer tone="green">{copy.siteRoleLabel}</HeaderContainer>
        <h2 id="role-title" class="type-h2">
          {copy.siteRoleHeading}
          <br />
          <span>{copy.siteRoleEmphasis}</span>
        </h2>
      </div>
      <div class="quality-role-copy">
        <p>{copy.siteRoleText}</p>
        <Button variant="primary" class="quality-outline-button" href="#contacts">
          {copy.siteRoleLink}
        </Button>
      </div>
    </section>
    <section class="quality-cta" aria-labelledby="quality-cta-title">
      <div>
        <HeaderContainer tone="green">{copy.certPreviewLabel}</HeaderContainer>
        <h2 id="quality-cta-title" class="type-h2">
          {copy.certPreviewHeading}
          <br />
          <span>{copy.certPreviewLabel2}</span>
        </h2>
      </div>
      <div class="quality-cta-copy">
        <p class="type-p">{copy.certPreviewText}</p>
        <Button variant="primary" href="#contacts">
          {copy.certPreviewLink}
        </Button>
      </div>
    </section>
  </main>
</SiteLayout>
