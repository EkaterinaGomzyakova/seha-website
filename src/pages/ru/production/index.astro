---
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import SeoLinks from '@components/SeoLinks.astro';
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#004b32" />
    <meta
      name="description"
      content="Производство кокосовых продуктов Сеха: сертифицированные площадки в Индии, пищевые продукты Laurico Nutraceuticals, субстраты, волокно, скорлупа и поставки для российского B2B-рынка."
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2064%2064%22%3E%3Crect%20width%3D%2264%22%20height%3D%2264%22%20rx%3D%2214%22%20fill%3D%22%23004b32%22%2F%3E%3Ctext%20x%3D%2232%22%20y%3D%2246%22%20text-anchor%3D%22middle%22%20font-family%3D%22Arial%22%20font-weight%3D%22bold%22%20font-size%3D%2248%22%20fill%3D%22%23d7f500%22%3E%D1%81%3C%2Ftext%3E%3C%2Fsvg%3E"
    />
    <title>Производство — Сеха</title>
    <link rel="stylesheet" href="/assets/styles.css" />
    <link rel="stylesheet" href="/assets/components.css" />
    <link rel="stylesheet" href="/assets/buttons.css" />
    <link rel="stylesheet" href="/assets/checkbox.css" />
    <link rel="stylesheet" href="/assets/language-switcher.css" />
    <link rel="stylesheet" href="/assets/menu.css" />
    <link rel="stylesheet" href="/assets/home.css" />
    <link rel="stylesheet" href="/assets/production.css" />
    <link rel="stylesheet" href="/assets/typography.css" />
    <link rel="stylesheet" href="/assets/cookie.css" />
    <link rel="stylesheet" href="/assets/header-container.css" />
    <link rel="stylesheet" href="/assets/input.css" />
    <link rel="stylesheet" href="/assets/links.css" />
    <link rel="stylesheet" href="/assets/tags.css" />
    <link rel="stylesheet" href="/assets/grid.css" />
    <link rel="stylesheet" href="/assets/footer.css" />
      <SeoLinks locale="ru" path="/production" />
  </head>
  <body class="home production">
    <a class="skip" href="#process">К процессу</a>
    <Header locale="ru" />
    <nav class="breadcrumbs" aria-label="Хлебные крошки">
      <a href="/ru/">Главная</a><span aria-hidden="true">/</span
      ><span aria-current="page">Производство</span>
    </nav>
    <main>
      <section class="production-hero" aria-labelledby="production-title">
        <img
          src="/assets/images/common/production-hero.webp"
          alt="Современная производственная площадка среди кокосовых пальм в Индии"
          width="2048"
          height="1024"
          fetchpriority="high"
        />
        <div class="production-hero-wash"></div>
        <div class="production-hero-copy">
          <h1 id="production-title" class="type-h1">Процесс<br /><em>производства</em></h1>
          <p class="type-p">
            Сеха работает с производственными площадками NMCocos и Laurico Nutraceuticals, чтобы
            поставлять кокосовые продукты с понятным контролем сырья, переработки, упаковки и
            документов.
          </p>
        </div>
      </section>
      <section class="home-section production-branches" aria-labelledby="branches-title">
        <div class="section-top reveal">
          <span class="section-label">01 / ПРОИЗВОДСТВЕННЫЕ ВЕТКИ</span
          ><span class="section-note">Разные продукты требуют разных процессов</span>
        </div>
        <div class="section-heading reveal">
          <h2 id="branches-title" class="type-h2">
            Две площадки<br /><span>для разных категорий</span>
          </h2>
          <p class="type-p">
            Сеха объединяет производственные возможности индийских партнеров с понятной
            коммуникацией для российских закупщиков, дистрибьюторов и производителей.
          </p>
        </div>
        <div class="branch-grid">
          <article class="branch-card reveal">
            <span>NM COCOS</span>
            <h3 class="type-h3">Субстраты, волокно и скорлупа</h3>
            <p class="type-p">
              Площадка для непищевой линейки: подготовка кокосового сырья, сортировка, сушка,
              контроль фракции, упаковка и экспортная отгрузка.
            </p>
            <ul>
              <li>кокосовый торф и чипсы</li>
              <li>материалы из волокна</li>
              <li>продукты из скорлупы</li>
            </ul>
          </article>
          <article class="branch-card branch-card-food reveal">
            <span>LAURICO NUTRACEUTICALS</span>
            <h3 class="type-h3">Пищевая кокосовая линейка</h3>
            <p class="type-p">
              Сертифицированная площадка для кокосовых масел, MCT, кокосовой муки, сахара и других
              пищевых продуктов. Акцент — на пищевой безопасности, фильтрации, фракционировании и
              упаковке.
            </p>
            <ul>
              <li>кокосовые масла</li>
              <li>MCT и жидкое кокосовое масло</li>
              <li>кокосовая мука и сахар</li>
            </ul>
          </article>
        </div>
      </section>
      <section class="process-section" id="process">
        <div class="process-sticky">
          <span class="section-label reveal">02 / ПУТЬ ПРОДУКТА</span>
          <h2 class="reveal type-h2">От сырья<br />до партии,<br /><em>готовой к отправке</em></h2>
          <p class="reveal type-p">
            Здесь собраны ключевые этапы, которые важны B2B-клиенту: происхождение сырья,
            технологическая обработка, контроль параметров, упаковка и подготовка документов.
          </p>
        </div>
        <div class="process-list">
          <article class="process-item reveal">
            <span>01</span>
            <div>
              <h3 class="type-h3">Сырье и производственная база</h3>
              <p class="type-p">
                Масштаб площадки и расположение рядом с регионами выращивания кокоса помогают
                поддерживать стабильность сырья для регулярных партий.
              </p>
              <figure class="process-media">
                <img
                  src="/assets/images/common/production-hero.webp"
                  alt="Производственная площадка среди кокосовых пальм"
                  width="2048"
                  height="1024"
                  loading="lazy"
                />
                <figcaption>Производственная площадка рядом с сырьевой базой</figcaption>
              </figure>
            </div>
          </article>
          <article class="process-item reveal">
            <span>02</span>
            <div>
              <h3 class="type-h3">Подготовка и хранение сырья</h3>
              <p class="type-p">
                Сырье очищают, сортируют и подготавливают к дальнейшей переработке. Для закупщика
                это снижает риск нестабильной партии.
              </p>
              <figure class="process-media">
                <img
                  src="/assets/images/common/materials.webp"
                  alt="Кокосовое сырье: стружка, торф, волокно и скорлупа"
                  width="1536"
                  height="1024"
                  loading="lazy"
                />
                <figcaption>Склад, сортировка и подготовка сырья</figcaption>
              </figure>
            </div>
          </article>
          <article class="process-item reveal">
            <span>03</span>
            <div>
              <h3 class="type-h3">Пищевая переработка Laurico</h3>
              <p class="type-p">
                Для пищевой линейки используются отдельные процессы: холодное прессование,
                фильтрация, удаление влаги и фракционирование масел.
              </p>
              <figure class="process-media">
                <img
                  src="/assets/images/common/production-processing.webp"
                  alt="Пищевой производственный цех со стальными емкостями"
                  width="1536"
                  height="1024"
                  loading="lazy"
                />
                <figcaption>Технологический цех пищевой линейки</figcaption>
              </figure>
            </div>
          </article>
          <article class="process-item reveal">
            <span>04</span>
            <div>
              <h3 class="type-h3">MCT и жидкое кокосовое масло</h3>
              <p class="type-p">
                Фракционирование и молекулярная дистилляция помогают получать продукты с заданными
                характеристиками для пищевого и нутрицевтического применения.
              </p>
              <figure class="process-media">
                <img
                  src="/assets/images/common/production-processing.webp"
                  alt="Линии фильтрации и емкости для пищевого производства"
                  width="1536"
                  height="1024"
                  loading="lazy"
                />
                <figcaption>Фракционирование, фильтрация и контроль параметров</figcaption>
              </figure>
            </div>
          </article>
          <article class="process-item reveal">
            <span>05</span>
            <div>
              <h3 class="type-h3">Фасовка и маркировка</h3>
              <p class="type-p">
                Готовая продукция упаковывается в розничные или оптовые форматы. Формат партии
                согласуется под канал продаж, склад и логистику клиента.
              </p>
              <figure class="process-media">
                <img
                  src="/assets/images/common/production-packing.webp"
                  alt="Упаковка пищевых кокосовых продуктов"
                  width="1680"
                  height="943"
                  loading="lazy"
                />
                <figcaption>Фасовка, маркировка и подготовка партии</figcaption>
              </figure>
            </div>
          </article>
          <article class="process-item reveal">
            <span>06</span>
            <div>
              <h3 class="type-h3">Документы и отгрузка</h3>
              <p class="type-p">
                Перед поставкой согласуются спецификация, упаковка, объем, условия доставки и
                комплект документов. Сеха ведет коммуникацию с российским клиентом.
              </p>
              <figure class="process-media">
                <img
                  src="/assets/images/common/production-packing.webp"
                  alt="Подготовленная партия кокосовых продуктов к поставке"
                  width="1680"
                  height="943"
                  loading="lazy"
                />
                <figcaption>Комплект документов и условия отгрузки</figcaption>
              </figure>
            </div>
          </article>
        </div>
      </section>
      <section class="facility-showcase">
        <div class="facility-image reveal">
          <img
            src="/assets/images/common/production-processing.webp"
            alt="Пищевой производственный цех со стальными емкостями и линиями фильтрации"
            width="1536"
            height="1024"
            loading="lazy"
          />
        </div>
        <div class="facility-copy">
          <span class="section-label reveal">03 / ПИЩЕВАЯ ЛИНИЯ LAURICO</span>
          <h2 class="reveal type-h2">
            Отдельная площадка<br /><span>для пищевой переработки</span>
          </h2>
          <p class="reveal type-p">
            Пищевая линейка производится на площадке Laurico Nutraceuticals в районе Pollachi, Tamil
            Nadu. Производство включает холодное прессование, удаление влаги, фильтрацию,
            молекулярную дистилляцию, хранение, фасовку и маркировку готовой продукции.
          </p>
          <div class="facility-units">
            <div class="reveal">
              <b>Холодное прессование</b
              ><span>Кокосовое масло первого отжима, фильтрация и контроль влажности.</span>
            </div>
            <div class="reveal">
              <b>MCT и фракционирование</b
              ><span>Молекулярная дистилляция и разделение масляных фракций.</span>
            </div>
            <div class="reveal">
              <b>Мука и сахар</b><span>Измельчение, сушка, просеивание и обработка сырья.</span>
            </div>
            <div class="reveal">
              <b>Фасовка</b><span>Розничные и оптовые форматы, подготовка партии к поставке.</span>
            </div>
          </div>
        </div>
      </section>
      <section class="packing-band">
        <img
          src="/assets/images/common/production-packing.webp"
          alt="Упаковка кокосовых продуктов в пищевом производственном помещении"
          width="1680"
          height="943"
          loading="lazy"
        />
        <div>
          <span class="section-label reveal">04 / УПАКОВКА И ПОСТАВКА</span>
          <p class="reveal type-p">
            Формат партии согласуется под продукт, объем, канал продаж, складскую обработку и
            дальнейшую логистику клиента.
          </p>
        </div>
      </section>
      <section class="home-section assurance-section">
        <div class="section-top reveal">
          <span class="section-label">05 / КОНТРОЛЬ</span
          ><span class="section-note">Параметры, которые согласуются до заказа</span>
        </div>
        <div class="section-heading reveal">
          <h2 class="type-h2">Контроль,<br /><span>который влияет на закупку</span></h2>
          <p class="type-p">
            На производственном этапе контролируются характеристики, от которых зависят хранение,
            переработка, применение продукта и приемка партии клиентом.
          </p>
        </div>
        <div class="quality-grid assurance-grid">
          <article class="reveal">
            <span class="quality-index">01</span>
            <h3 class="type-h3">Влажность и стабильность</h3>
            <p class="type-p">
              Для хранения, субстратов и экспортной упаковки важны контролируемые показатели
              влажности.
            </p>
          </article>
          <article class="reveal">
            <span class="quality-index">02</span>
            <h3 class="type-h3">pH, EC и фракция</h3>
            <p class="type-p">
              Для кокосового торфа и субстратов критичны однородность, фракция, pH и электрическая
              проводимость.
            </p>
          </article>
          <article class="reveal">
            <span class="quality-index">03</span>
            <h3 class="type-h3">Пищевая безопасность</h3>
            <p class="type-p">
              Для пищевой линейки важны отдельные производственные процессы, фильтрация, маркировка
              и контроль партии.
            </p>
          </article>
        </div>
      </section>
      <section class="russia-section">
        <div class="russia-copy reveal">
          <span class="section-label">06 / СЕХА В РОССИИ</span>
          <h2 class="type-h2">
            Производственная экспертиза Индии.<br /><em>Коммерческое сопровождение в России</em>
          </h2>
        </div>
        <div class="russia-points">
          <p class="reveal type-p">
            Сеха — точка контакта для российского B2B-клиента. Мы помогаем выбрать продукт,
            согласовать объем, упаковку, характеристики партии и условия поставки.
          </p>
          <div class="russia-list reveal">
            <span>Подбор продукта под задачу</span><span>Согласование объема и упаковки</span
            ><span>Коммерческое предложение</span><span>Коммуникация с производством</span>
          </div>
        </div>
      </section>
      <section class="cert-preview">
        <div class="reveal">
          <span class="section-label">07 / КАЧЕСТВО И СЕРТИФИКАТЫ</span>
          <h2 class="type-h2">Документы —<br /><span>под конкретную партию</span></h2>
        </div>
        <div class="cert-copy reveal">
          <p class="type-p">
            Для пищевой линейки и отдельных категорий доступны сертификаты и документы, применимые к
            конкретному продукту и партии. Мы заранее уточняем, какие подтверждения нужны вашему
            производству, складу или отделу закупок.
          </p>
          <a class="button button--tertiary" href="/ru/quality/">К разделу качества</a>
        </div>
      </section>
    </main>
    <Footer locale="ru" />
    <script is:inline src="/assets/components.js"></script>
    <script is:inline src="/assets/app.js"></script>
  </body>
</html>


