---
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import SeoLinks from '@components/SeoLinks.astro';
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#004b32" />
    <meta
      name="description"
      content="Organic coconut products for food manufacturing, horticulture and industry. Direct B2B supply from Seha."
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2064%2064%22%3E%3Crect%20width%3D%2264%22%20height%3D%2264%22%20rx%3D%2214%22%20fill%3D%22%23004b32%22%2F%3E%3Ctext%20x%3D%2232%22%20y%3D%2246%22%20text-anchor%3D%22middle%22%20font-family%3D%22Arial%22%20font-weight%3D%22bold%22%20font-size%3D%2248%22%20fill%3D%22%23d7f500%22%3E%D1%81%3C%2Ftext%3E%3C%2Fsvg%3E"
    />
    <title>Пищевые продукты — Сеха</title>
    <link rel="stylesheet" href="/assets/styles.css" />
    <link rel="stylesheet" href="/assets/components.css" />
    <link rel="stylesheet" href="/assets/buttons.css" />
    <link rel="stylesheet" href="/assets/checkbox.css" />
    <link rel="stylesheet" href="/assets/language-switcher.css" />
    <link rel="stylesheet" href="/assets/menu.css" />
    <link rel="stylesheet" href="/assets/home.css" />
    <link rel="stylesheet" href="/assets/product-detail.css" />
    <link rel="stylesheet" href="/assets/typography.css" />
    <link rel="stylesheet" href="/assets/product-image.css" />
    <link rel="stylesheet" href="/assets/cookie.css" />
    <link rel="stylesheet" href="/assets/header-container.css" />
    <link rel="stylesheet" href="/assets/input.css" />
    <link rel="stylesheet" href="/assets/links.css" />
    <link rel="stylesheet" href="/assets/tags.css" />
    <link rel="stylesheet" href="/assets/grid.css" />
    <link rel="stylesheet" href="/assets/footer.css" />
    <link rel="stylesheet" href="/assets/product-detail-pixel.css" />
      <SeoLinks locale="ru" path="/products/food" />
  </head>
  <body class="product-detail product-detail--food">
    <a class="skip" href="#products-list">К продуктам</a>
    <Header locale="ru" />
    <nav class="breadcrumbs" aria-label="Хлебные крошки">
      <span aria-current="page">Главная / пищевые продукты</span>
    </nav>
    <main>
      <section class="product-hero" aria-labelledby="product-title">
        <div class="product-hero-icon">
          <img
            src="/assets/images/food/food-06-photorealistic.png"
            alt=""
            width="720"
            height="720"
            aria-hidden="true"
          />
        </div>
        <span class="section-label">02 / ПИЩЕВЫЕ ПРОДУКТЫ</span>
        <h1 id="product-title" class="type-h1">Пищевые продукты</h1>
        <p class="type-p">
          Кокос и продукты его переработки для производителей продуктов питания, брендов, HoReCa и
          дистрибьюторов. Уточним формат, характеристики, упаковку и объем партии.
        </p>
      </section>
      <section class="product-list-section" id="products-list" aria-labelledby="products-title">
        <div class="product-list-heading">
          <span>для пищевого производства</span>
          <h2 id="products-title" class="type-h2">Оптовая<br />линейка</h2>
        </div>
        <div class="product-grid-page">
          <article class="product-item reveal">
            <figure>
              <img
                src="/assets/images/food/food-01-photorealistic.png"
                alt="Свежие кокосы"
                width="720"
                height="720"
                loading="lazy"
              />
            </figure>
            <span>Fresh Coconut</span>
            <h3 class="type-h3">Свежие кокосы</h3>
            <p class="type-p">
              Отборные кокосы из индийского региона Поллачи. Контроль размера, зрелости и свежести
              для стабильных поставок.
            </p>
            <a
              class="button button--primary button--full"
              href="#contacts"
              data-quote-product="Пищевые продукты"
              >Заказать</a
            >
          </article>
          <article class="product-item reveal">
            <figure>
              <img
                src="/assets/images/food/food-02-photorealistic.png"
                alt="Кокосовая копра"
                width="720"
                height="720"
                loading="lazy"
              />
            </figure>
            <span>Coconut Copra</span>
            <h3 class="type-h3">Кокосовая копра</h3>
            <p class="type-p">
              Сушеная мякоть зрелого кокоса с выраженным кокосовым профилем. Используется в пищевом
              производстве и переработке.
            </p>
            <a
              class="button button--primary button--full"
              href="#contacts"
              data-quote-product="Пищевые продукты"
              >Заказать</a
            >
          </article>
          <article class="product-item reveal">
            <figure>
              <img
                src="/assets/images/food/food-03-photorealistic.png"
                alt="Кокосовый сахар"
                width="720"
                height="720"
                loading="lazy"
              />
            </figure>
            <span>Coconut Sugar</span>
            <h3 class="type-h3">Кокосовый сахар</h3>
            <p class="type-p">
              Натуральный подсластитель с мягким карамельным профилем для напитков, выпечки и
              пищевого производства.
            </p>
            <a
              class="button button--primary button--full"
              href="#contacts"
              data-quote-product="Пищевые продукты"
              >Заказать</a
            >
          </article>
          <article class="product-item reveal">
            <figure>
              <img
                src="/assets/images/food/food-05-photorealistic.png"
                alt="Кокосовая стружка"
                width="720"
                height="720"
                loading="lazy"
              />
            </figure>
            <span>Desiccated Coconut Powder</span>
            <h3 class="type-h3">Кокосовая стружка</h3>
            <p class="type-p">
              Высушенная измельченная кокосовая мякоть для выпечки, кондитерских изделий, начинок и
              пищевой промышленности.
            </p>
            <a
              class="button button--primary button--full"
              href="#contacts"
              data-quote-product="Пищевые продукты"
              >Заказать</a
            >
          </article>
          <article class="product-item reveal">
            <figure>
              <img
                src="/assets/images/food/food-04-photorealistic.png"
                alt="Кокосовая вода"
                width="720"
                height="720"
                loading="lazy"
              />
            </figure>
            <span>Coconut Water</span>
            <h3 class="type-h3">Кокосовая вода</h3>
            <p class="type-p">
              Натуральная кокосовая вода для напитков, функциональных продуктов и контрактного
              производства.
            </p>
            <a
              class="button button--primary button--full"
              href="#contacts"
              data-quote-product="Пищевые продукты"
              >Заказать</a
            >
          </article>
          <article class="product-item reveal">
            <figure>
              <img
                src="/assets/images/food/food-09-photorealistic.png"
                alt="Кокосовое молоко"
                width="720"
                height="720"
                loading="lazy"
              />
            </figure>
            <span>Coconut Milk</span>
            <h3 class="type-h3">Кокосовое молоко</h3>
            <p class="type-p">
              Нежное кокосовое молоко для напитков, соусов, десертов и пищевых рецептур.
            </p>
            <a
              class="button button--primary button--full"
              href="#contacts"
              data-quote-product="Пищевые продукты"
              >Заказать</a
            >
          </article>
          <article class="product-item reveal">
            <figure>
              <img
                src="/assets/images/food/food-07-photorealistic.png"
                alt="Нерафинированное масло"
                width="720"
                height="720"
                loading="lazy"
              />
            </figure>
            <span>Virgin Coconut Oil</span>
            <h3 class="type-h3">Нерафинированное масло</h3>
            <p class="type-p">
              Кокосовое масло без химической обработки. Подходит для продуктов питания, косметики и
              premium-линеек.
            </p>
            <a
              class="button button--primary button--full"
              href="#contacts"
              data-quote-product="Пищевые продукты"
              >Заказать</a
            >
          </article>
          <article class="product-item reveal">
            <figure>
              <img
                src="/assets/images/food/food-06-photorealistic.png"
                alt="Кокосовое масло RBD"
                width="720"
                height="720"
                loading="lazy"
              />
            </figure>
            <span>RBD Coconut Oil</span>
            <h3 class="type-h3">Кокосовое масло RBD</h3>
            <p class="type-p">
              Масло из высококачественной копры для пищевого производства, косметики и
              фармацевтических применений.
            </p>
            <a
              class="button button--primary button--full"
              href="#contacts"
              data-quote-product="Пищевые продукты"
              >Заказать</a
            >
          </article>
          <article class="product-item reveal">
            <figure>
              <img
                src="/assets/images/food/food-08-photorealistic.png"
                alt="MCT масло"
                width="720"
                height="720"
                loading="lazy"
              />
            </figure>
            <span>MCT Oil</span>
            <h3 class="type-h3">MCT масло</h3>
            <p class="type-p">
              Прозрачное масло со среднецепочечными триглицеридами для функционального питания и
              спортивных продуктов.
            </p>
            <a
              class="button button--primary button--full"
              href="#contacts"
              data-quote-product="Пищевые продукты"
              >Заказать</a
            >
          </article>
        </div>
      </section>
    </main>
    <Footer locale="ru" />
    <script is:inline src="/assets/components.js"></script>
    <script is:inline src="/assets/app.js"></script>
  </body>
</html>



