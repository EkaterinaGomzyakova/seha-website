---
import SiteLayout from '@layouts/SiteLayout.astro';

const locale = 'ru';
const path = '/404';
const title = '404 — Сеха';
const description = 'Страница не найдена. Вернитесь к каталогу кокосовых продуктов Сеха или отправьте запрос на расчет поставки.';
---
<SiteLayout locale={locale} path={path} title={title} description={description} bodyClass="not-found" skipText="К содержанию" skipHref="#error-content" showFooter={false}>
  <main class="error-page" id="error-content">
    <section class="error-copy" aria-labelledby="error-title">
      <div class="error-mark" aria-hidden="true"><span>4</span><i>0</i><span>4</span></div>
      <h1 id="error-title" class="type-h1">Страница не найдена</h1>
      <p class="type-p">Такой страницы сейчас нет. Перейдите на главную или откройте каталог продукции.</p>
      <nav class="error-nav" aria-label="Куда перейти дальше">
        <a href="/products">Продукты</a><a href="/production">Производство</a><a href="/quality">Качество</a><a href="/about">О компании</a>
      </nav>
      <a class="button button--tertiary" href="/">На главную</a>
    </section>
  </main>
</SiteLayout>
