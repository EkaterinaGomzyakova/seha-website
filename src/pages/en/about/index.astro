---
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import SeoLinks from '@components/SeoLinks.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#004b32" />
    <meta
      name="description"
      content="О компании Сеха: российский центр продаж органических кокосовых продуктов, производственная экспертиза Индии и B2B-поставки под требования клиента."
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2064%2064%22%3E%3Crect%20width%3D%2264%22%20height%3D%2264%22%20rx%3D%2214%22%20fill%3D%22%23004b32%22%2F%3E%3Ctext%20x%3D%2232%22%20y%3D%2246%22%20text-anchor%3D%22middle%22%20font-family%3D%22Arial%22%20font-weight%3D%22bold%22%20font-size%3D%2248%22%20fill%3D%22%23d7f500%22%3E%D1%81%3C%2Ftext%3E%3C%2Fsvg%3E"
    />
    <title>About Seha — Coconut Products and B2B Supply</title>
    <link rel="stylesheet" href="/assets/styles.css" />
    <link rel="stylesheet" href="/assets/components.css" />
    <link rel="stylesheet" href="/assets/buttons.css" />
    <link rel="stylesheet" href="/assets/checkbox.css" />
    <link rel="stylesheet" href="/assets/language-switcher.css" />
    <link rel="stylesheet" href="/assets/menu.css" />
    <link rel="stylesheet" href="/assets/home.css" />
    <link rel="stylesheet" href="/assets/about.css" />
    <link rel="stylesheet" href="/assets/typography.css" />
    <link rel="stylesheet" href="/assets/cookie.css" />
    <link rel="stylesheet" href="/assets/header-container.css" />
    <link rel="stylesheet" href="/assets/input.css" />
    <link rel="stylesheet" href="/assets/links.css" />
    <link rel="stylesheet" href="/assets/tags.css" />
    <link rel="stylesheet" href="/assets/grid.css" />
    <link rel="stylesheet" href="/assets/footer.css" />
      <SeoLinks locale="en" path="/about" />
  </head>
  <body class="home about">
    <a class="skip" href="#approach">К подходу</a>
    <Header locale="en" />
    <nav class="breadcrumbs" aria-label="Хлебные крошки">
      <a href="/en/">Главная</a><span aria-hidden="true">/</span
      ><span aria-current="page">О компании</span>
    </nav>
    <main>
      <section class="about-hero" aria-labelledby="about-title">
        <div class="hero-topline">
          <span>СЕХА / О КОМПАНИИ</span><span>ИНДИЙСКОЕ ПРОИСХОЖДЕНИЕ · РОССИЙСКИЙ B2B-ЦЕНТР</span>
        </div>
        <div class="about-hero-copy">
          <h1 id="about-title" class="type-h1">
            Не просто кокос.<br /><em>Управляемая цепочка поставки</em>
          </h1>
          <p class="type-p">
            Сеха помогает российским компаниям закупать органические кокосовые продукты премиального
            качества: от пищевых ингредиентов до субстратов, волокна и скорлупы.
          </p>
          <div class="production-actions">
            <a class="button button--secondary" href="/en/products/">Выбрать продукцию <span>↗</span></a
            ><a class="button button--tertiary" href="/en/production/">Как устроено производство</a>
          </div>
        </div>
        <div class="about-hero-note">
          <span
            >Для закупки важны не громкие обещания, а происхождение, спецификация, документы и
            понятная коммуникация на русском рынке.</span
          >
        </div>
      </section>
      <section class="about-intro">
        <figure class="about-photo reveal">
          <img
            src="/assets/images/common/home-coconut.webp"
            alt="Кокосовая мякоть, волокно и скорлупа"
            width="1536"
            height="1024"
            loading="lazy"
          />
          <figcaption>Пищевые, агро- и промышленные продукты из одного сырья.</figcaption>
        </figure>
        <div class="about-intro-copy">
          <span class="section-label reveal">01 / КТО МЫ</span>
          <h2 class="reveal type-h2">
            Российская точка входа<br /><span>в индийскую кокосовую цепочку</span>
          </h2>
          <p class="reveal type-p">
            Сеха — российский центр продаж и сопровождения B2B-поставок кокосовой продукции. Мы
            переводим производственную экспертизу Индии в понятные коммерческие условия: продукт,
            объем, упаковка, документы, логистика и сроки.
          </p>
          <p class="reveal type-p">
            Производственная база связана с регионом Pollachi в Tamil Nadu — одним из сильных
            кокосовых кластеров Индии. Для клиента это означает доступ к сырью, переработке и
            экспортной компетенции без необходимости самостоятельно разбираться в каждой детали
            внешней поставки.
          </p>
        </div>
      </section>
      <section class="about-numbers" aria-label="Ключевые факты">
        <div class="reveal">
          <b>40+</b><span>лет кокосовой экспертизы у индийской производственной базы</span>
        </div>
        <div class="reveal">
          <b>Pollachi</b><span>регион происхождения сырья и производства</span>
        </div>
        <div class="reveal">
          <b>4</b><span>направления: пищевые продукты, субстраты, волокно, скорлупа</span>
        </div>
        <div class="reveal">
          <b>B2B</b><span>подбор под спецификацию, объем и требования поставки</span>
        </div>
      </section>
      <section class="home-section about-approach" id="approach">
        <div class="section-top reveal">
          <span class="section-label">02 / ПОДХОД</span
          ><span class="section-note">Принципы коммерческой работы</span>
        </div>
        <div class="section-heading reveal">
          <h2 class="type-h2">Мы строим доверие<br /><span>не на эффекте, а на ясности</span></h2>
          <p class="type-p">
            В поставках импортного B2B-продукта важны точные параметры, понятные документы и
            предсказуемая коммуникация до размещения заказа.
          </p>
        </div>
        <div class="about-principles">
          <article class="reveal">
            <span>01</span>
            <h3 class="type-h3">Происхождение имеет значение</h3>
            <p class="type-p">
              Кокосовые продукты отличаются по сырью, обработке и назначению. Поэтому мы начинаем
              разговор не с прайс-листа, а с того, какой продукт нужен вашему бизнесу.
            </p>
          </article>
          <article class="reveal">
            <span>02</span>
            <h3 class="type-h3">Спецификация раньше цены</h3>
            <p class="type-p">
              Цена зависит от категории, фракции, упаковки, объема, курса, логистики и документов.
              Коммерческое предложение собирается под реальный запрос.
            </p>
          </article>
          <article class="reveal">
            <span>03</span>
            <h3 class="type-h3">Вся ценность кокоса</h3>
            <p class="type-p">
              Мякоть, волокно и скорлупа становятся разными продуктами: пищевыми ингредиентами,
              материалами для выращивания и сырьем для промышленного применения.
            </p>
          </article>
          <article class="reveal">
            <span>04</span>
            <h3 class="type-h3">Проверяемость важнее деклараций</h3>
            <p class="type-p">
              Для B2B-клиента важны характеристики партии, документы, область сертификации и
              понятные условия поставки. Именно это мы выводим в коммуникацию.
            </p>
          </article>
        </div>
      </section>
      <section class="about-shift">
        <div class="about-shift-copy">
          <span class="section-label reveal">03 / СМЫСЛ</span>
          <h2 class="reveal type-h2">От сырья<br /><em>к коммерческому решению</em></h2>
          <p class="reveal type-p">
            Мы смотрим на кокосовую продукцию как на часть цепочки клиента: рецептуры, выращивания,
            производства, складской обработки и дальнейшей продажи.
          </p>
        </div>
        <figure class="about-shift-image reveal">
          <img
            src="/assets/images/common/production-hero.webp"
            alt="Производственное здание и территория переработки кокосовой продукции"
            width="1536"
            height="1024"
            loading="lazy"
          />
          <figcaption>
            Производственная база и экспортная подготовка влияют на стабильность партии.
          </figcaption>
        </figure>
      </section>
      <section class="home-section about-timeline">
        <div class="section-top reveal">
          <span class="section-label">04 / ОПЫТ</span
          ><span class="section-note">Факты, которые важны для закупки</span>
        </div>
        <div class="timeline-grid">
          <article class="reveal">
            <span>1980-е</span>
            <h3 class="type-h3">Начало в кокосовой отрасли</h3>
            <p class="type-p">
              Формирование экспертизы в сырье, региональных особенностях и требованиях покупателей.
            </p>
          </article>
          <article class="reveal">
            <span>2000-е</span>
            <h3 class="type-h3">Развитие торговли и контроля</h3>
            <p class="type-p">
              Понимание того, что для экспортного клиента решают стабильность, прослеживаемость и
              повторяемость партии.
            </p>
          </article>
          <article class="reveal">
            <span>2019</span>
            <h3 class="type-h3">Современная производственная база</h3>
            <p class="type-p">
              Переход к производству и экспортной модели с инфраструктурой для обработки, упаковки и
              контроля.
            </p>
          </article>
          <article class="reveal">
            <span>Сейчас</span>
            <h3 class="type-h3">Сеха в России</h3>
            <p class="type-p">
              Российский центр продаж помогает клиентам выбирать продукт и получать предложение под
              конкретные условия поставки.
            </p>
          </article>
        </div>
      </section>
      <section class="about-clients">
        <div>
          <span class="section-label reveal">05 / ДЛЯ КОГО</span>
          <h2 class="reveal type-h2">
            Для компаний,<br /><span>которым важна предсказуемость</span>
          </h2>
        </div>
        <div class="client-list reveal">
          <span>Дистрибьюторы</span><span>Ритейлеры и торговые сети</span
          ><span>Производители продуктов питания</span><span>Гидропонные фермы</span
          ><span>Садоводческие компании</span><span>Бренды продуктов питания</span
          ><span>Косметические бренды</span><span>Фармацевтические компании</span>
        </div>
      </section>
      <section class="cert-preview about-cta">
        <div class="reveal">
          <span class="section-label">06 / СЛЕДУЮЩИЙ ШАГ</span>
          <h2 class="type-h2">Начнем с вашей задачи,<br /><span>а не с шаблонного прайса</span></h2>
        </div>
        <div class="cert-copy reveal">
          <p class="type-p">
            Расскажите, какой продукт нужен, какой объем рассматриваете и куда нужна доставка. Мы
            уточним параметры и подготовим коммерческое предложение.
          </p>
          <a class="button button--tertiary" href="#contacts">Получить предложение</a>
        </div>
      </section>
    </main>
    <Footer locale="en" />
    <script is:inline src="/assets/components.js"></script>
    <script is:inline src="/assets/app.js"></script>
  </body>
</html>


