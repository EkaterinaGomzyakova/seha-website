---
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import SeoLinks from '@components/SeoLinks.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#004b32" />
    <meta
      name="description"
      content="Organic coconut products for food manufacturing, horticulture and industry. Direct B2B supply from Seha."
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2064%2064%22%3E%3Crect%20width%3D%2264%22%20height%3D%2264%22%20rx%3D%2214%22%20fill%3D%22%23004b32%22%2F%3E%3Ctext%20x%3D%2232%22%20y%3D%2246%22%20text-anchor%3D%22middle%22%20font-family%3D%22Arial%22%20font-weight%3D%22bold%22%20font-size%3D%2248%22%20fill%3D%22%23d7f500%22%3E%D1%81%3C%2Ftext%3E%3C%2Fsvg%3E"
    />
    <title>Coco Shell Products — Seha</title>
    <link rel="stylesheet" href="/assets/styles.css" />
    <link rel="stylesheet" href="/assets/components.css" />
    <link rel="stylesheet" href="/assets/buttons.css" />
    <link rel="stylesheet" href="/assets/checkbox.css" />
    <link rel="stylesheet" href="/assets/language-switcher.css" />
    <link rel="stylesheet" href="/assets/menu.css" />
    <link rel="stylesheet" href="/assets/home.css" />
    <link rel="stylesheet" href="/assets/product-detail.css" />
    <link rel="stylesheet" href="/assets/typography.css" />
    <link rel="stylesheet" href="/assets/product-image.css" />
    <link rel="stylesheet" href="/assets/cookie.css" />
    <link rel="stylesheet" href="/assets/header-container.css" />
    <link rel="stylesheet" href="/assets/input.css" />
    <link rel="stylesheet" href="/assets/links.css" />
    <link rel="stylesheet" href="/assets/tags.css" />
    <link rel="stylesheet" href="/assets/grid.css" />
    <link rel="stylesheet" href="/assets/footer.css" />
    <link rel="stylesheet" href="/assets/product-detail-pixel.css" />
      <SeoLinks locale="en" path="/products/shell" />
  </head>
  <body class="product-detail product-detail--shell">
    <a class="skip" href="#products-list">К продуктам</a>
    <Header locale="en" />
    <nav class="breadcrumbs" aria-label="Хлебные крошки">
      <a href="/en/">Главная</a><span aria-hidden="true">/</span><a href="/en/products/">Продукты</a
      ><span aria-hidden="true">/</span><span aria-current="page">Кокосовая скорлупа</span>
    </nav>
    <main>
      <section class="product-hero" aria-labelledby="product-title">
        <div class="product-hero-icon">
          <img
            src="/assets/images/shell/shell-01-photorealistic.png"
            alt=""
            width="720"
            height="720"
            aria-hidden="true"
          />
        </div>
        <span class="section-label">04 / КОКОСОВАЯ СКОРЛУПА</span>
        <h1 id="product-title" class="type-h1">Продукты из кокосовой скорлупы</h1>
        <p class="type-p">
          Продукты из натуральной кокосовой скорлупы для промышленности, фильтрации и производства
          топлива. Различные форматы и объёмы поставок для бизнеса.
        </p>
      </section>
      <section class="product-list-section" id="products-list" aria-labelledby="products-title">
        <div class="product-list-heading">
          <span>для промышленности и топлива</span>
          <h2 id="products-title" class="type-h2">Оптовая<br />линейка</h2>
        </div>
        <div class="product-grid-page">
          <article class="product-item reveal">
            <figure>
              <img
                src="/assets/images/shell/shell-01-photorealistic.png"
                alt="Кокосовая скорлупа"
                width="720"
                height="720"
                loading="lazy"
              />
            </figure>
            <span>Coco Shell</span>
            <h3 class="type-h3">Кокосовая скорлупа</h3>
            <p class="type-p">
              Натуральная кокосовая скорлупа для производства активированного угля, топлива и
              промышленной продукции.
            </p>
            <a
              class="button button--primary button--full"
              href="#contacts"
              data-quote-product="Кокосовая скорлупа"
              >Заказать</a
            >
          </article>
          <article class="product-item reveal">
            <figure>
              <img
                src="/assets/images/shell/shell-02-photorealistic.png"
                alt="Брикеты из кокосового угля"
                width="720"
                height="720"
                loading="lazy"
              />
            </figure>
            <span>Coco Shell Charcoal Briquettes</span>
            <h3 class="type-h3">Брикеты из кокосового угля</h3>
            <p class="type-p">
              Брикеты с высокой теплоотдачей и минимальным количеством золы. Подходят для гриля,
              барбекю и промышленного применения.
            </p>
            <a
              class="button button--primary button--full"
              href="#contacts"
              data-quote-product="Кокосовая скорлупа"
              >Заказать</a
            >
          </article>
          <article class="product-item reveal">
            <figure>
              <img
                src="/assets/images/shell/shell-03-photorealistic.png"
                alt="Активированный уголь"
                width="720"
                height="720"
                loading="lazy"
              />
            </figure>
            <span>Coco Shell Activated Carbon</span>
            <h3 class="type-h3">Активированный уголь</h3>
            <p class="type-p">
              Активированный уголь из кокосовой скорлупы для очистки воды, воздуха и промышленных
              систем фильтрации.
            </p>
            <a
              class="button button--primary button--full"
              href="#contacts"
              data-quote-product="Кокосовая скорлупа"
              >Заказать</a
            >
          </article>
        </div>
      </section>
    </main>
    <Footer locale="en" />
    <script is:inline src="/assets/components.js"></script>
    <script is:inline src="/assets/app.js"></script>
  </body>
</html>



