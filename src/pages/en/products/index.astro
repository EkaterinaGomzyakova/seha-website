---
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import SeoLinks from '@components/SeoLinks.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#004b32" />
    <meta
      name="description"
      content="Organic coconut products for food manufacturing, horticulture and industry. Direct B2B supply from Seha."
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2064%2064%22%3E%3Crect%20width%3D%2264%22%20height%3D%2264%22%20rx%3D%2214%22%20fill%3D%22%23004b32%22%2F%3E%3Ctext%20x%3D%2232%22%20y%3D%2246%22%20text-anchor%3D%22middle%22%20font-family%3D%22Arial%22%20font-weight%3D%22bold%22%20font-size%3D%2248%22%20fill%3D%22%23d7f500%22%3E%D1%81%3C%2Ftext%3E%3C%2Fsvg%3E"
    />
    <title>Coconut Products — Seha</title>
    <link rel="stylesheet" href="/assets/styles.css" />
    <link rel="stylesheet" href="/assets/components.css" />
    <link rel="stylesheet" href="/assets/buttons.css" />
    <link rel="stylesheet" href="/assets/checkbox.css" />
    <link rel="stylesheet" href="/assets/language-switcher.css" />
    <link rel="stylesheet" href="/assets/menu.css" />
    <link rel="stylesheet" href="/assets/products.css" />
    <link rel="stylesheet" href="/assets/typography.css" />
    <link rel="stylesheet" href="/assets/cookie.css" />
    <link rel="stylesheet" href="/assets/header-container.css" />
    <link rel="stylesheet" href="/assets/input.css" />
    <link rel="stylesheet" href="/assets/links.css" />
    <link rel="stylesheet" href="/assets/tags.css" />
    <link rel="stylesheet" href="/assets/grid.css" />
    <link rel="stylesheet" href="/assets/footer.css" />
    <link rel="stylesheet" href="/assets/category-image.css" />
      <SeoLinks locale="en" path="/products" />
  </head>
  <body class="product-overview">
    <a class="skip" href="#catalog">К каталогу</a>
    <Header locale="en" />
    <nav class="breadcrumbs" aria-label="Хлебные крошки">
      <a href="/en/">Главная</a><span aria-hidden="true">/</span
      ><span aria-current="page">Продукты</span>
    </nav>
    <main>
      <section class="hero product-overview-hero" aria-labelledby="title">
        <img
          class="hero-image"
          src="/assets/images/products/coconut.webp"
          alt="Кокос с белой мякотью, кокосовая стружка и натуральное волокно"
          width="1536"
          height="1024"
          fetchpriority="high"
        />
        <div class="hero-shade"></div>
        <div class="hero-content">
          <h1 id="title" class="type-h1">Один кокос<br /><span>Больше возможностей</span></h1>
          <div class="hero-bottom">
            <p class="type-p">
              Органические кокосовые продукты<br />премиального качества.<br />Производим.
              Перерабатываем. Поставляем.
            </p>
          </div>
        </div>
      </section>
      <section class="products-catalog" id="catalog" aria-labelledby="catalog-title">
        <div class="products-catalog-heading">
          <div>
            <span class="products-eyebrow">4 НАПРАВЛЕНИЯ</span>
            <h2 id="catalog-title" class="type-h2">Наши<br />продукты</h2>
          </div>
          <p class="type-p">Четыре направления.<br />Единый стандарт качества.</p>
        </div>
        <div class="products-list" id="products-list">
          <a class="product-category" href="/en/products/substrates/">
            <div
              class="category-image-frame product-category-image"
              role="img"
              aria-label="Кокосовые субстраты"
            >
              <img src="/assets/images/common/category-substrates.png" alt="" />
            </div>
            <span class="product-category-number">01</span>
            <div class="product-category-title">
              <span>ДЛЯ ВЫРАЩИВАНИЯ</span>
              <h3 class="type-h3">Кокосовые субстраты</h3>
            </div>
            <p class="type-p">
              Торф, чипсы, брикеты и диски для теплиц,<br />гидропоники и рассады.
            </p>
            <span class="product-category-arrow" aria-hidden="true">↗</span>
          </a>
          <a class="product-category" href="/en/products/food/">
            <div
              class="category-image-frame product-category-image"
              role="img"
              aria-label="Пищевые продукты"
            >
              <img src="/assets/images/common/category-food.png" alt="" />
            </div>
            <span class="product-category-number">02</span>
            <div class="product-category-title">
              <span>ДЛЯ ПИТАНИЯ</span>
              <h3 class="type-h3">Пищевые продукты</h3>
            </div>
            <p class="type-p">
              Ингредиенты, масла, сахар, стружка и<br />розничная линейка Veymur.
            </p>
            <span class="product-category-arrow" aria-hidden="true">↗</span>
          </a>
          <a class="product-category" href="/en/products/fiber/">
            <div
              class="category-image-frame product-category-image"
              role="img"
              aria-label="Кокосовое волокно"
            >
              <img src="/assets/images/common/category-fibre.png" alt="" />
            </div>
            <span class="product-category-number">03</span>
            <div class="product-category-title">
              <span>ДЛЯ НАТУРАЛЬНЫХ МАТЕРИАЛОВ</span>
              <h3 class="type-h3">Кокосовое волокно</h3>
            </div>
            <p class="type-p">
              Натуральное волокно и изделия для<br />производства, ландшафта и защиты почвы.
            </p>
            <span class="product-category-arrow" aria-hidden="true">↗</span>
          </a>
          <a class="product-category" href="/en/products/shell/">
            <div
              class="category-image-frame product-category-image"
              role="img"
              aria-label="Кокосовая скорлупа"
            >
              <img src="/assets/images/common/category-shell.png" alt="" />
            </div>
            <span class="product-category-number">04</span>
            <div class="product-category-title">
              <span>ДЛЯ ПРОМЫШЛЕННОСТИ</span>
              <h3 class="type-h3">Кокосовая скорлупа</h3>
            </div>
            <p class="type-p">
              Сырье для активированного угля, топлива,<br />фильтрации и переработки.
            </p>
            <span class="product-category-arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
    </main>
    <Footer locale="en" />
    <script is:inline src="/assets/components.js"></script>
    <script is:inline src="/assets/app.js"></script>
  </body>
</html>


