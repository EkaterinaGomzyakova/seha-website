---
import SiteLayout from '@layouts/SiteLayout.astro';

const locale = "en";
const path = "/products";
const title = "Coconut Products — Seha";
const description = "Organic coconut products for food manufacturing, horticulture and industry. Direct B2B supply from Seha.";
---
<SiteLayout locale={locale} path={path} title={title} description={description} bodyClass="product-overview" skipText="К каталогу" skipHref="#catalog">
<nav class="breadcrumbs" aria-label="Хлебные крошки">
      <a href="/en/">Главная</a><span aria-hidden="true">/</span
      ><span aria-current="page">Продукты</span>
    </nav>
    <main>
      <section class="hero product-overview-hero" aria-labelledby="title">
        <img
          class="hero-image"
          src="/assets/images/products/coconut.webp"
          alt="Кокос с белой мякотью, кокосовая стружка и натуральное волокно"
          width="1536"
          height="1024"
          fetchpriority="high"
        />
        <div class="hero-shade"></div>
        <div class="hero-content">
          <h1 id="title" class="type-h1">Один кокос<br /><span>Больше возможностей</span></h1>
          <div class="hero-bottom">
            <p class="type-p">
              Органические кокосовые продукты<br />премиального качества.<br />Производим.
              Перерабатываем. Поставляем.
            </p>
          </div>
        </div>
      </section>
      <section class="products-catalog" id="catalog" aria-labelledby="catalog-title">
        <div class="products-catalog-heading">
          <div>
            <span class="products-eyebrow">4 НАПРАВЛЕНИЯ</span>
            <h2 id="catalog-title" class="type-h2">Наши<br />продукты</h2>
          </div>
          <p class="type-p">Четыре направления.<br />Единый стандарт качества.</p>
        </div>
        <div class="products-list" id="products-list">
          <a class="product-category" href="/en/products/substrates/">
            <div
              class="category-image-frame product-category-image"
              role="img"
              aria-label="Кокосовые субстраты"
            >
              <img src="/assets/images/common/category-substrates.png" alt="" />
            </div>
            <span class="product-category-number">01</span>
            <div class="product-category-title">
              <span>ДЛЯ ВЫРАЩИВАНИЯ</span>
              <h3 class="type-h3">Кокосовые субстраты</h3>
            </div>
            <p class="type-p">
              Торф, чипсы, брикеты и диски для теплиц,<br />гидропоники и рассады.
            </p>
            <span class="product-category-arrow" aria-hidden="true">↗</span>
          </a>
          <a class="product-category" href="/en/products/food/">
            <div
              class="category-image-frame product-category-image"
              role="img"
              aria-label="Пищевые продукты"
            >
              <img src="/assets/images/common/category-food.png" alt="" />
            </div>
            <span class="product-category-number">02</span>
            <div class="product-category-title">
              <span>ДЛЯ ПИТАНИЯ</span>
              <h3 class="type-h3">Пищевые продукты</h3>
            </div>
            <p class="type-p">
              Ингредиенты, масла, сахар, стружка и<br />розничная линейка Veymur.
            </p>
            <span class="product-category-arrow" aria-hidden="true">↗</span>
          </a>
          <a class="product-category" href="/en/products/fiber/">
            <div
              class="category-image-frame product-category-image"
              role="img"
              aria-label="Кокосовое волокно"
            >
              <img src="/assets/images/common/category-fiber.png" alt="" />
            </div>
            <span class="product-category-number">03</span>
            <div class="product-category-title">
              <span>ДЛЯ НАТУРАЛЬНЫХ МАТЕРИАЛОВ</span>
              <h3 class="type-h3">Кокосовое волокно</h3>
            </div>
            <p class="type-p">
              Натуральное волокно и изделия для<br />производства, ландшафта и защиты почвы.
            </p>
            <span class="product-category-arrow" aria-hidden="true">↗</span>
          </a>
          <a class="product-category" href="/en/products/shell/">
            <div
              class="category-image-frame product-category-image"
              role="img"
              aria-label="Кокосовая скорлупа"
            >
              <img src="/assets/images/common/category-shell.png" alt="" />
            </div>
            <span class="product-category-number">04</span>
            <div class="product-category-title">
              <span>ДЛЯ ПРОМЫШЛЕННОСТИ</span>
              <h3 class="type-h3">Кокосовая скорлупа</h3>
            </div>
            <p class="type-p">
              Сырье для активированного угля, топлива,<br />фильтрации и переработки.
            </p>
            <span class="product-category-arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
    </main>
</SiteLayout>

