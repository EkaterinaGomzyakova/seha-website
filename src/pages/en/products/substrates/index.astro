---
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import SeoLinks from '@components/SeoLinks.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#004b32" />
    <meta
      name="description"
      content="Organic coconut products for food manufacturing, horticulture and industry. Direct B2B supply from Seha."
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2064%2064%22%3E%3Crect%20width%3D%2264%22%20height%3D%2264%22%20rx%3D%2214%22%20fill%3D%22%23004b32%22%2F%3E%3Ctext%20x%3D%2232%22%20y%3D%2246%22%20text-anchor%3D%22middle%22%20font-family%3D%22Arial%22%20font-weight%3D%22bold%22%20font-size%3D%2248%22%20fill%3D%22%23d7f500%22%3E%D1%81%3C%2Ftext%3E%3C%2Fsvg%3E"
    />
    <title>Growing Substrates — Seha</title>
    <link rel="stylesheet" href="/assets/styles.css" />
    <link rel="stylesheet" href="/assets/components.css" />
    <link rel="stylesheet" href="/assets/buttons.css" />
    <link rel="stylesheet" href="/assets/checkbox.css" />
    <link rel="stylesheet" href="/assets/language-switcher.css" />
    <link rel="stylesheet" href="/assets/menu.css" />
    <link rel="stylesheet" href="/assets/home.css" />
    <link rel="stylesheet" href="/assets/product-detail.css" />
    <link rel="stylesheet" href="/assets/typography.css" />
    <link rel="stylesheet" href="/assets/product-image.css" />
    <link rel="stylesheet" href="/assets/cookie.css" />
    <link rel="stylesheet" href="/assets/header-container.css" />
    <link rel="stylesheet" href="/assets/input.css" />
    <link rel="stylesheet" href="/assets/links.css" />
    <link rel="stylesheet" href="/assets/tags.css" />
    <link rel="stylesheet" href="/assets/grid.css" />
    <link rel="stylesheet" href="/assets/footer.css" />
    <link rel="stylesheet" href="/assets/product-detail-pixel.css" />
      <SeoLinks locale="en" path="/products/substrates" />
  </head>
  <body class="product-detail product-detail--substrates">
    <a class="skip" href="#products-list">К продуктам</a>
    <Header locale="en" />
    <nav class="breadcrumbs" aria-label="Хлебные крошки">
      <a href="/en/">Главная</a><span aria-hidden="true">/</span><a href="/en/products/">Продукты</a
      ><span aria-hidden="true">/</span><span aria-current="page">Кокосовые субстраты</span>
    </nav>
    <main>
      <section class="product-hero" aria-labelledby="product-title">
        <div class="product-hero-icon">
          <img
            src="/assets/images/substrates/substrates-01-photorealistic.png"
            alt=""
            width="720"
            height="720"
            aria-hidden="true"
          />
        </div>
        <span class="section-label">01 / КОКОСОВЫЕ СУБСТРАТЫ</span>
        <h1 id="product-title" class="type-h1">Субстраты для выращивания</h1>
        <p class="type-p">
          Профессиональные субстраты на основе кокоса для теплиц, питомников, гидропоники и рассады.
          Подберем фракцию, формат, объем и упаковку под вашу технологию выращивания.
        </p>
      </section>
      <section class="product-list-section" id="products-list" aria-labelledby="products-title">
        <div class="product-list-heading">
          <span>для растениеводства</span>
          <h2 id="products-title" class="type-h2">Оптовая<br />линейка</h2>
        </div>
        <div class="product-grid-page">
          <article class="product-item reveal">
            <figure>
              <img
                src="/assets/images/substrates/substrates-01-photorealistic.png"
                alt="Кокосовый торф"
                width="720"
                height="720"
                loading="lazy"
              />
            </figure>
            <span>Coco Peat</span>
            <h3 class="type-h3">Кокосовый торф</h3>
            <p class="type-p">
              Натуральный субстрат из очищенного кокосового волокна. Подходит для улучшения
              влагоемкости, аэрации и структуры почвосмесей.
            </p>
            <a
              class="button button--primary button--full"
              href="#contacts"
              data-quote-product="Кокосовые субстраты"
              >Заказать</a
            >
          </article>
          <article class="product-item reveal">
            <figure>
              <img
                src="/assets/images/substrates/substrates-02-photorealistic.png"
                alt="Кокосовый торф в брикетах"
                width="720"
                height="720"
                loading="lazy"
              />
            </figure>
            <span>Coco Peat Bricks</span>
            <h3 class="type-h3">Кокосовый торф в брикетах</h3>
            <p class="type-p">
              Спрессованные брикеты кокосового субстрата для тепличных хозяйств и объемных поставок.
              Удобны для хранения и транспортировки.
            </p>
            <a
              class="button button--primary button--full"
              href="#contacts"
              data-quote-product="Кокосовые субстраты"
              >Заказать</a
            >
          </article>
          <article class="product-item reveal">
            <figure>
              <img
                src="/assets/images/substrates/substrates-03-photorealistic.png"
                alt="Кубический субстрат (M)"
                width="720"
                height="720"
                loading="lazy"
              />
            </figure>
            <span>Grow Cube Slice M</span>
            <h3 class="type-h3">Кубический субстрат (M)</h3>
            <p class="type-p">
              Кокосовые блоки среднего формата для рассады, горшечных культур и гидропоники.
              Удерживают влагу и поддерживают аэрацию корней.
            </p>
            <a
              class="button button--primary button--full"
              href="#contacts"
              data-quote-product="Кокосовые субстраты"
              >Заказать</a
            >
          </article>
          <article class="product-item reveal">
            <figure>
              <img
                src="/assets/images/substrates/substrates-04-photorealistic.png"
                alt="Кубический субстрат (L)"
                width="720"
                height="720"
                loading="lazy"
              />
            </figure>
            <span>Grow Cube Olive L</span>
            <h3 class="type-h3">Кубический субстрат (L)</h3>
            <p class="type-p">
              Крупноформатные блоки кокосового субстрата для выращивания растений в закрытых грунтах
              и системах интенсивного полива.
            </p>
            <a
              class="button button--primary button--full"
              href="#contacts"
              data-quote-product="Кокосовые субстраты"
              >Заказать</a
            >
          </article>
          <article class="product-item reveal">
            <figure>
              <img
                src="/assets/images/substrates/substrates-05-photorealistic.png"
                alt="Кокосовые диски"
                width="720"
                height="720"
                loading="lazy"
              />
            </figure>
            <span>Coco Disc</span>
            <h3 class="type-h3">Кокосовые диски</h3>
            <p class="type-p">
              Спрессованные диски из кокосового волокна. При увлажнении увеличиваются, образуют
              натуральный биоразлагаемый субстрат.
            </p>
            <a
              class="button button--primary button--full"
              href="#contacts"
              data-quote-product="Кокосовые субстраты"
              >Заказать</a
            >
          </article>
          <article class="product-item reveal">
            <figure>
              <img
                src="/assets/images/substrates/substrates-06-photorealistic.png"
                alt="Кокосовые чипсы"
                width="720"
                height="720"
                loading="lazy"
              />
            </figure>
            <span>Coco Husk Chips</span>
            <h3 class="type-h3">Кокосовые чипсы</h3>
            <p class="type-p">
              Крупные частицы кокосовой скорлупы для улучшения аэрации и дренажа. Подходят для
              орхидей, гидропоники и специализированных культур.
            </p>
            <a
              class="button button--primary button--full"
              href="#contacts"
              data-quote-product="Кокосовые субстраты"
              >Заказать</a
            >
          </article>
          <article class="product-item reveal">
            <figure>
              <img
                src="/assets/images/substrates/substrates-07-photorealistic.png"
                alt="Таблетки из кокосового торфа"
                width="720"
                height="720"
                loading="lazy"
              />
            </figure>
            <span>Coco Peat Tablets</span>
            <h3 class="type-h3">Таблетки из кокосового торфа</h3>
            <p class="type-p">
              Прессованные таблетки для проращивания семян и рассады. После увлажнения увеличиваются
              в объёме и формируют удобное посадочное место.
            </p>
            <a
              class="button button--primary button--full"
              href="#contacts"
              data-quote-product="Кокосовые субстраты"
              >Заказать</a
            >
          </article>
          <article class="product-item reveal">
            <figure>
              <img
                src="/assets/images/substrates/substrates-08-photorealistic.png"
                alt="Компост из кокосового торфа"
                width="720"
                height="720"
                loading="lazy"
              />
            </figure>
            <span>Coco Peat Compost</span>
            <h3 class="type-h3">Компост из кокосового торфа</h3>
            <p class="type-p">
              Органический натуральный субстрат для выращивания растений и улучшения почвы.
              Удерживает влагу и поддерживает здоровье корней.
            </p>
            <a
              class="button button--primary button--full"
              href="#contacts"
              data-quote-product="Кокосовые субстраты"
              >Заказать</a
            >
          </article>
          <article class="product-item reveal">
            <figure>
              <img
                src="/assets/images/substrates/substrates-09-photorealistic.png"
                alt="Субстрат для лотков рассады"
                width="720"
                height="720"
                loading="lazy"
              />
            </figure>
            <span>Seeding Tray Media</span>
            <h3 class="type-h3">Субстрат для лотков рассады</h3>
            <p class="type-p">
              Готовая смесь для лотков и кассет с рассадой. Обеспечивает равномерное прорастание,
              аэрацию и развитие здоровой корневой системы.
            </p>
            <a
              class="button button--primary button--full"
              href="#contacts"
              data-quote-product="Кокосовые субстраты"
              >Заказать</a
            >
          </article>
          <article class="product-item reveal">
            <figure>
              <img
                src="/assets/images/substrates/substrates-10-photorealistic.png"
                alt="Субстрат для проращивания"
                width="720"
                height="720"
                loading="lazy"
              />
            </figure>
            <span>Coco Peat Seed Starter</span>
            <h3 class="type-h3">Субстрат для проращивания</h3>
            <p class="type-p">
              Мелкофракционный субстрат для проращивания семян. Поддерживает влажность и доступ
              воздуха для роста молодых растений.
            </p>
            <a
              class="button button--primary button--full"
              href="#contacts"
              data-quote-product="Кокосовые субстраты"
              >Заказать</a
            >
          </article>
        </div>
      </section>
    </main>
    <Footer locale="en" />
    <script is:inline src="/assets/components.js"></script>
    <script is:inline src="/assets/app.js"></script>
  </body>
</html>



