---
import { products, type ProductItem } from '../../../../data/products';
import type { Locale } from '../../../../data/translations';
import { productCopyUpdates } from '../../../../data/product-copy-updates';
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import ResponsiveImage from '../../../../components/ResponsiveImage.astro';
import Button from '../../../../components/ui/Button.astro';
import { localizedPath } from '../../../../lib/paths';
import {
  specificationsFor,
  substrateCatalogueSpecifications,
  specificationSource
} from '../../../../data/product-specifications';
export function getStaticPaths() {
  return (['ru', 'en'] as const).flatMap((locale) =>
    products.map((item) => ({
      params: { locale, category: item.category, product: item.slug },
      props: { locale, item }
    }))
  );
}
interface Props {
  locale: Locale;
  item: ProductItem;
}
const { locale, item } = Astro.props;
const ru = locale === 'ru';
const path = `/products/${item.category}/${item.slug}/`;
---

<SiteLayout
  locale={locale}
  path={path}
  title={`${item.name[locale]} — SEHA`}
  description={item.description[locale]}
  image={item.image}
  bodyClass="page-product-detail"
  skipText={ru ? 'К продукту' : 'To product'}
>
  <main id="main-content" tabindex="-1" class="product-detail">
    <a href={localizedPath(`/products/${item.category}/`, locale)}>
      {ru ? 'Назад к категории' : 'Back to category'}
    </a>
    <section class="product-detail__overview" aria-labelledby="product-name">
      <ResponsiveImage
        src={item.image}
        alt={item.alt[locale]}
        sizes="(max-width: 800px) calc(100vw - 64px), 50vw"
        loading="eager"
        fetchpriority="high"
      />
      <div>
        <h1 id="product-name" class="type-h1">
          {item.name[locale]}
        </h1>
        <p class="type-p">{item.description[locale]}</p>
        <p class="type-p">
          {ru
            ? 'Вся продукция производится группой компаний SEHA в Индии.'
            : 'All products are manufactured by SEHA Group of Companies, India.'}
        </p>
        <Button
          href="#contacts"
          full
          data-quote-product={(item.quoteName ?? item.name)[locale]}
          data-product-id={item.id}
        >
          {ru ? 'Заказать' : 'Enquire now'}
        </Button>
      </div>
    </section>
    <section aria-labelledby="specifications-title">
      <h2 id="specifications-title" class="type-h2">
        {ru ? 'Характеристики' : 'Specifications'}
      </h2>
      <dl>
        {specificationsFor(item).map((row) => (
          <div>
            <dt>{row.label[locale]}</dt>
            <dd>{row.value[locale]}</dd>
          </div>
        ))}
      </dl>
    </section>
    {item.category === 'substrates' &&
      !productCopyUpdates[item.id]?.specifications &&
      !['coconut-chips', 'coco-husk-chips-bricks', 'grow-cube-sleeve'].includes(item.id) && (
        <section aria-labelledby="catalogue-title">
          <h2 id="catalogue-title" class="type-h3">
            {ru
              ? 'Общие параметры субстратов из каталога'
              : 'General substrate parameters from the catalogue'}
          </h2>
          <p>
            {ru
              ? 'Применимость к выбранному продукту и партии согласовывается отдельно.'
              : 'Applicability to the selected product and batch is agreed separately.'}
          </p>
          <dl>
            {substrateCatalogueSpecifications.map((row) => (
              <div>
                <dt>{row.label[locale]}</dt>
                <dd>{row.value[locale]}</dd>
              </div>
            ))}
          </dl>
          <a href={specificationSource}>{ru ? 'Каталог SEHA' : 'SEHA catalogue'}</a>
        </section>
      )}
  </main>
</SiteLayout>
<style>
  .product-detail {
    width: var(--grid-content-width);
    margin: 32px auto 80px;
    display: grid;
    gap: 48px;
    color: var(--color-green-brand);
  }
  .product-detail__overview {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: start;
  }
  .product-detail__overview > div {
    display: grid;
    gap: 24px;
    min-width: 0;
  }
  .product-detail__overview :global(img) {
    width: 100%;
    height: auto;
    border-radius: 32px;
  }
  h1,
  h2 {
    margin: 0;
    overflow-wrap: anywhere;
  }
  dl {
    margin: 24px 0;
  }
  dl div {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    padding: 16px 0;
    border-bottom: 1px solid var(--color-light-gray);
  }
  dt,
  dd {
    overflow-wrap: anywhere;
  }
  dd {
    margin: 0;
  }
  @media (max-width: 800px) {
    .product-detail__overview {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 440px) {
    dl div {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .product-detail {
      gap: 32px;
    }
  }
</style>
