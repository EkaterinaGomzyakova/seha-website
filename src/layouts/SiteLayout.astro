---
import Footer from '@components/Footer.astro';
import GlobalStyles from '@components/GlobalStyles.astro';
import Header from '@components/Header.astro';
import SeoLinks from '@components/SeoLinks.astro';
import type { Locale } from '../data/translations';
import type { ProductItem } from '../data/products';
import CookieBanner from '../components/CookieBanner.astro';
import ProductInquiry from '../components/ProductInquiry.astro';
import { withBase } from '../lib/paths';

interface Props {
  locale: Locale;
  path: string;
  title: string;
  description: string;
  bodyClass: string;
  skipText: string;
  skipHref?: string;
  showFooter?: boolean;
  image?: string;
  inquiryProducts?: ProductItem[];
}

const {
  locale,
  path,
  title,
  description,
  bodyClass,
  skipText,
  skipHref = '#main-content',
  showFooter = true,
  image,
  inquiryProducts = []
} = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#004d25" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <title>{title}</title>
    <SeoLinks locale={locale} path={path} title={title} description={description} image={image} />
    <GlobalStyles />
  </head>
  <body class={bodyClass}>
    <a class="skip" href={skipHref}>
      {skipText}
    </a>
    <Header locale={locale} />
    <slot />
    {showFooter && <Footer locale={locale} />}
    {inquiryProducts.length > 0 && <ProductInquiry locale={locale} products={inquiryProducts} />}
    <CookieBanner locale={locale} />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
