---
import Footer from '@components/Footer.astro';
import GlobalStyles from '@components/GlobalStyles.astro';
import Header from '@components/Header.astro';
import SeoLinks from '@components/SeoLinks.astro';
import type { Locale } from '../data/translations';

interface Props {
  locale: Locale;
  path: string;
  title: string;
  description: string;
  bodyClass: string;
  skipText: string;
  skipHref?: string;
  showFooter?: boolean;
}

const { locale, path, title, description, bodyClass, skipText, skipHref = '#main-content', showFooter = true } = Astro.props;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#004b32" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <SeoLinks locale={locale} path={path} />
    <GlobalStyles />
  </head>
  <body class={bodyClass}>
    <a class="skip" href={skipHref}>{skipText}</a>
    <Header locale={locale} />
    <slot />
    {showFooter && <Footer locale={locale} />}
    <script is:inline src="/assets/components.js"></script>
    <script is:inline src="/assets/app.js"></script>
  </body>
</html>
