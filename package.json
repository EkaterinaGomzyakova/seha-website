{
  "name": "seha-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || ^26.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "preview": "astro preview",
    "test": "playwright test",
    "test:functional": "playwright test --grep-invert @visual",
    "test:visual": "playwright test --grep @visual",
    "test:screenshots": "playwright test --grep @visual",
    "test:update": "playwright test --update-snapshots",
    "test:a11y": "playwright test -g \"accessibility\"",
    "images:optimize": "node scripts/prepare-home-images.mjs && node scripts/optimize-images.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.0",
    "astro": "^7.3.8",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "sharp": "^0.35.5",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0"
  }
}
