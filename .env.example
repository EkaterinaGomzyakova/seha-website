# Canonical origin for SEO and sitemap. Never include private credentials in PUBLIC_*.
SITE_URL=https://seha-group.ru
# Leave empty for a custom domain, or use /seha-website for a GitHub project URL.
BASE_PATH=
# Optional HTTPS endpoint that accepts multipart/form-data and returns 2xx after accepting the inquiry.
# Requires a separately configured mail handler; GitHub Pages cannot send email itself.
PUBLIC_FORM_ENDPOINT=
# Product-card inquiries use a separate Node.js + SMTP handler; footer stays independent.
PUBLIC_PRODUCT_INQUIRY_ENDPOINT=
