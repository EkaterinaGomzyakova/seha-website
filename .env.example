# Canonical origin for SEO and sitemap. Never include private credentials in PUBLIC_*.
SITE_URL=https://seha-group.ru
# JSON endpoint returning {"success":true} only after SMTP acceptance.
# REG.RU deployment sets both endpoints to /api/inquiry.php automatically.
# Leave empty locally to avoid sending real inquiries from a local preview.
PUBLIC_FORM_ENDPOINT=
PUBLIC_PRODUCT_INQUIRY_ENDPOINT=
