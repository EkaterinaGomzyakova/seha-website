# Copy to server/.env on the hosting server. Never commit real credentials.
INQUIRY_HOST=127.0.0.1
INQUIRY_PORT=3001
# Enable only behind a local reverse proxy that overwrites X-Real-IP.
INQUIRY_TRUST_PROXY=true
# Exact browser origins, separated by commas; no paths or trailing slash.
INQUIRY_ALLOWED_ORIGINS=https://seha-group.ru,https://ekaterinagomzyakova.github.io
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=seha.info@inbox.ru
